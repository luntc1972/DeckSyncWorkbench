@page "/harvest"
@implements IDisposable
@using DeckFlow.Core.Content
@using DeckFlow.Core.Integration
@using DeckFlow.Core.Orchestration
@using DeckFlow.Studio.Services
@using DeckFlow.Studio.ViewModels
@using System.Diagnostics

<PageTitle>Harvest + Distill</PageTitle>

<h1 class="h4 fw-semibold">Harvest + Distill</h1>
<p class="text-muted">Discover videos, harvest transcripts, and distill to knowledge base.</p>
<div id="harvestInitState" data-ready="@(_initializationComplete ? "true" : "false")" hidden></div>
<HelpPanel Title="Find videos, harvest transcripts, and distill notes">
    <p class="mb-2">This is the normal entry point for new content. Browse a saved creator, paste a channel or playlist, or paste direct video URLs into the queue, then harvest transcripts and distill them into KB notes.</p>
    <ul class="mb-0 ps-3">
        <li>Distill creates the notes and prompt artifacts used later in Review and publish.</li>
        <li>Auto-approve can move high-clip distills straight to approved when they meet the cutoff; below-cutoff entries stay in Review.</li>
    </ul>
</HelpPanel>

<PipelineStepper CurrentStage="harvest" />

<article class="content px-4">

    <nav class="harvest-section-nav" aria-label="Harvest sections">
        <a class="harvest-section-link" href="#harvest-browse">Browse</a>
        <a class="harvest-section-link" href="#harvest-queue">Paste Queue</a>
        <a class="harvest-section-link" href="#harvest-run">Harvest</a>
        <a class="harvest-section-link" href="#harvest-distill">Distill</a>
    </nav>

    @* ─── Section 1: Channel or Playlist Browse (HARV-01) ─── *@
    @* The negative tabindex on each section card below: a div is not natively focusable, so
       without it a fragment jump from the sub-nav above moves the viewport but leaves keyboard
       focus stranded at the top of the document. *@
    <div class="card mt-4" id="harvest-browse" tabindex="-1">
        <div class="card-header">
            <h2 class="h5 fw-semibold mb-0">Browse Channel or Playlist</h2>
        </div>
        <div class="card-body">
            @if (Runner.IsRunning)
            {
                <div class="alert alert-info py-2 mb-3">
                    Harvest or distill in progress — channel browse unavailable.
                </div>
            }
            @if (_creators.Count > 0)
            {
                <div class="row g-2 align-items-end mb-2">
                    <div class="col-md-5">
                        <label for="creatorSelect" class="form-label fw-semibold small">Creator</label>
                        <select id="creatorSelect" class="form-select"
                                value="@_selectedCreatorRef"
                                @onchange="OnCreatorSelected"
                                disabled="@IsBusy">
                            <option value="">— paste a URL instead —</option>
                            @foreach (var creator in _creators)
                            {
                                <option value="@creator.ChannelRef">@creator.DisplayName</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-7">
                        <div class="form-text">Pick a saved creator to fill the field below, or leave this on "paste a URL instead" and type a one-off channel. Manage the list on the <a href="creators">Creators</a> page.</div>
                    </div>
                </div>
            }
            <div class="row g-2 align-items-end mb-1">
                <div class="col-md-5">
                    <label for="channelInput" class="form-label fw-semibold small">YouTube channel URL, handle, ID, or playlist URL</label>
                    <input id="channelInput" type="text" class="form-control"
                           placeholder="e.g. @@SomeCreator or https://youtube.com/playlist?list=PL..."
                           @bind="_channelInput"
                           disabled="@IsBusy" />
                </div>
                <div class="col-md-2">
                    <label for="browseLimit" class="form-label fw-semibold small">Count</label>
                    <input id="browseLimit" type="number" class="form-control"
                           min="1" max="200"
                           @bind="_browseLimit"
                           disabled="@IsBusy" />
                </div>
                <div class="col-md-2">
                    <label for="browseSkip" class="form-label fw-semibold small">Skip</label>
                    <input id="browseSkip" type="number" class="form-control"
                           min="0"
                           @bind="_browseSkip"
                           disabled="@IsBusy"
                           aria-describedby="browseSkipHint" />
                </div>
                <div class="col-md-3">
                    <button class="btn btn-outline-primary w-100"
                            @onclick="BrowseChannelAsync"
                            disabled="@IsBusy">
                        @if (_isBrowsingChannel)
                        {
                            <span class="spinner-border spinner-border-sm text-primary"
                                  role="status"
                                  aria-label="Operation in progress">
                                <span class="visually-hidden">Loading…</span>
                            </span>
                            <span> Fetching channel videos…</span>
                        }
                        else
                        {
                            <span>Browse</span>
                        }
                    </button>
                </div>
            </div>
            <div id="browseSkipHint" class="form-text mb-3">Channel or playlist URL accepted. Skip the newest N items to reach older videos (with Count, acts as a page window).</div>

            @if (!string.IsNullOrEmpty(_channelBrowseError))
            {
                <div class="alert alert-danger py-2">@_channelBrowseError</div>
            }

            @if (!string.IsNullOrEmpty(_blockError))
            {
                <div class="alert alert-danger py-2">@_blockError</div>
            }

            @{
                // SUI-05: distinct creators parsed from browsed rows (ChannelTitle fallback).
                // Computed here (outside the inner @if) so Razor can reference browseCreators
                // inside the nested @if without triggering RZ1010 (no @{ } inside @if HTML blocks).
                var browseCreators = _channelVideos
                    .Select(vm => CreatorNameResolver.FromChannelTitle(vm.ChannelTitle))
                    .Distinct(StringComparer.Ordinal)
                    .OrderBy(c => c, StringComparer.Ordinal)
                    .ToList();
            }
            @if (_channelVideos.Count > 0)
            {
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="showAllVideos"
                           @bind="_showAllVideos"
                           disabled="@IsBusy" />
                    <label class="form-check-label small" for="showAllVideos">
                        Show all (including harvested / distilled / published). Default shows only not-yet-harvested videos.
                    </label>
                </div>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="showHiddenVideos"
                           @bind="_showHiddenVideos"
                           disabled="@IsBusy" />
                    <label class="form-check-label small" for="showHiddenVideos">
                        Show hidden (skipped / blocked) for this creator, with un-skip / un-block.
                    </label>
                </div>
                @if (browseCreators.Count > 1)
                {
                    <div class="row g-2 align-items-end mb-2">
                        <div class="col-md-4">
                            <label for="browseCreatorFilter" class="form-label fw-semibold small">Filter by creator</label>
                            <select id="browseCreatorFilter" class="form-select form-select-sm"
                                    value="@_browsCreatorFilter"
                                    @onchange="OnBrowseCreatorFilterChanged"
                                    disabled="@IsBusy">
                                <option value="">All creators</option>
                                @foreach (var creator in browseCreators)
                                {
                                    <option value="@creator">@creator</option>
                                }
                            </select>
                        </div>
                    </div>
                }
                @if (VisibleChannelVideos.Count == 0)
                {
                    <p class="text-muted">All browsed videos are already harvested or skipped. Tick "Show all" to see them.</p>
                }
                else
                {
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" style="width:40px">
                                    <input type="checkbox"
                                           @onclick="ToggleAllChannelSelections"
                                           checked="@_allChannelSelected"
                                           aria-label="Select all channel videos" />
                                </th>
                                <th scope="col" style="width:50px">Thumb</th>
                                <th scope="col">Title</th>
                                <th scope="col">Published</th>
                                <th scope="col">Status</th>
                                <th scope="col" class="col-1">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vm in VisibleChannelVideos)
                            {
                                <tr class="@(vm.Status == VideoStatus.Harvested || vm.Status == VideoStatus.Distilled ? "table-secondary" : "")">
                                    <td>
                                        <input type="checkbox"
                                               checked="@vm.Selected"
                                               @onchange="() => vm.Selected = !vm.Selected"
                                               aria-label="Select @vm.Title" />
                                    </td>
                                    @* F-03: the thumbnail is the only per-row content not otherwise reachable by a
                                       user scanning by image; the title also appears as adjacent link text, so it
                                       is heard twice by assistive tech, but an empty alt made the row invisible
                                       to that user entirely. *@
                                    <td>
                                        <img src="https://img.youtube.com/vi/@vm.VideoId/default.jpg"
                                             width="40" height="30"
                                             alt="@vm.Title thumbnail"
                                             onerror="this.style.display='none'" />
                                    </td>
                                    <td>
                                        <a href="@vm.Url" target="_blank" rel="noopener noreferrer">@vm.Title</a>
                                    </td>
                                    <td class="text-nowrap">@(vm.PublishedUtc?.ToString("yyyy-MM-dd") ?? "—")</td>
                                    <td><StatusBadge Status="vm.Status" /></td>
                                    <td>
                                        @if (!vm.PendingBlock)
                                        {
                                            <button class="btn btn-sm btn-outline-secondary me-1 btn-table-action"
                                                    @onclick="() => SkipVideoAsync(vm)"
                                                    disabled="@IsBusy"
                                                    aria-label="Skip @vm.Title">
                                                Skip
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger btn-table-action"
                                                    @onclick="() => BeginBlock(vm)"
                                                    disabled="@(IsBusy || vm.Status == VideoStatus.Blocked)"
                                                    aria-label="Block @vm.Title">
                                                Block Video
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-danger btn-table-action"
                                                    @ref="_confirmBlockButton"
                                                    @onclick="() => ConfirmBlockAsync(vm)"
                                                    disabled="@IsBusy"
                                                    aria-label="Confirm block @vm.Title">
                                                Confirm Block
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary ms-1 btn-table-action"
                                                    @onclick="() => vm.PendingBlock = false"
                                                    aria-label="Keep @vm.Title">
                                                Keep Video
                                            </button>
                                            <span class="text-danger small ms-2">This will delete KB artifacts.</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                }

                @if (_showHiddenVideos && HiddenChannelVideos.Count > 0)
                {
                    <div class="mt-3">
                        <h3 class="h6 fw-semibold">Hidden (skipped / blocked)</h3>
                        <div class="table-responsive">
                            <table class="table table-sm align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th scope="col">Title</th>
                                        <th scope="col" style="width:90px">Status</th>
                                        <th scope="col" style="width:180px">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var vm in HiddenChannelVideos)
                                    {
                                        var isSkipped = _skippedVideoIds.Contains(vm.VideoId);
                                        <tr>
                                            <td><a href="@vm.Url" target="_blank" rel="noopener noreferrer">@vm.Title</a></td>
                                            <td>@(isSkipped ? "Skipped" : "Blocked")</td>
                                            <td>
                                                @if (isSkipped)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary me-1 btn-table-action"
                                                            @onclick="() => UnskipVideoAsync(vm)"
                                                            disabled="@IsBusy"
                                                            aria-label="Un-skip @vm.Title">
                                                        Un-skip
                                                    </button>
                                                }
                                                @if (vm.Status == VideoStatus.Blocked)
                                                {
                                                    <button class="btn btn-sm btn-outline-primary btn-table-action"
                                                            @onclick="() => UnblockVideoRowAsync(vm)"
                                                            disabled="@IsBusy"
                                                            aria-label="Un-block @vm.Title">
                                                        Un-block
                                                    </button>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            }
            else if (_channelBrowseDone && string.IsNullOrEmpty(_channelBrowseError))
            {
                <p class="text-muted">No videos found for this channel. Check the handle or URL and try again.</p>
            }
        </div>
    </div>

    @* ─── Section 2: URL/ID Paste Queue (HARV-02) ─── *@
    <div class="card mt-4" id="harvest-queue" tabindex="-1">
        <div class="card-header">
            <h2 class="h5 fw-semibold mb-0">URL / ID Paste Queue</h2>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label for="pasteQueue" class="form-label fw-semibold small">Paste video URLs or IDs, or a playlist URL (one per line)</label>
                <textarea id="pasteQueue" class="form-control" rows="4"
                          @bind="_pasteQueueText"
                          disabled="@IsBusy"></textarea>
            </div>
            <button class="btn btn-outline-secondary"
                    @onclick="AddToQueueAsync"
                    disabled="@IsBusy">
                @if (_isAddingToQueue)
                {
                    <span class="spinner-border spinner-border-sm text-primary"
                          role="status"
                          aria-label="Operation in progress">
                        <span class="visually-hidden">Loading…</span>
                    </span>
                    <span> Resolving…</span>
                }
                else
                {
                    <span>Add to Queue</span>
                }
            </button>

            @if (!string.IsNullOrEmpty(_queueAddError))
            {
                <div class="alert alert-danger py-2 mt-2">@_queueAddError</div>
            }

            @if (_addToQueueDone && _lastAddCount == 0 && !string.IsNullOrWhiteSpace(_lastAddInput))
            {
                <div class="alert alert-warning py-2 mt-2">
                    No videos found for the pasted input. The video may be private, unlisted, or the URL may be invalid.
                </div>
            }

            @if (_queueVideos.Count > 0)
            {
                <div class="table-responsive mt-3">
                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" style="width:40px">
                                    <input type="checkbox"
                                           @onclick="ToggleAllQueueSelections"
                                           checked="@_allQueueSelected"
                                           aria-label="Select all queued videos" />
                                </th>
                                <th scope="col" style="width:50px">Thumb</th>
                                <th scope="col">Title</th>
                                <th scope="col">Published</th>
                                <th scope="col">Status</th>
                                <th scope="col" style="width:50px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vm in _queueVideos)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               checked="@vm.Selected"
                                               @onchange="() => vm.Selected = !vm.Selected"
                                               aria-label="Select @vm.Title" />
                                    </td>
                                    <td>
                                        <img src="https://img.youtube.com/vi/@vm.VideoId/default.jpg"
                                             width="40" height="30"
                                             alt="@vm.Title thumbnail"
                                             onerror="this.style.display='none'" />
                                    </td>
                                    <td>
                                        <a href="@vm.Url" target="_blank" rel="noopener noreferrer">@vm.Title</a>
                                    </td>
                                    <td class="text-nowrap">@(vm.PublishedUtc?.ToString("yyyy-MM-dd") ?? "—")</td>
                                    <td><StatusBadge Status="vm.Status" /></td>
                                    <td>
                                        <button class="btn btn-sm btn-outline-danger btn-table-action"
                                                @onclick="() => RemoveFromQueue(vm)"
                                                aria-label="Remove video from queue">
                                            <span class="oi oi-x" aria-hidden="true"></span>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted mt-2">No videos in queue. Paste URLs or IDs above, or browse a channel.</p>
            }
        </div>
    </div>

    <hr class="mt-4" />

    @* ─── Section 3: Harvest Trigger (HARV-04) ─── *@
    <div class="card mt-4" id="harvest-run" tabindex="-1">
        <div class="card-header">
            <h2 class="h5 fw-semibold mb-0">Harvest</h2>
        </div>
        <div class="card-body">
            @{
                var selectedVideos = GetAllSelectedVideos();
                var selectedCount = selectedVideos.Count;
                var alreadyHarvestedCount = selectedVideos.Count(v => v.Status == VideoStatus.Harvested || v.Status == VideoStatus.Distilled);
            }

            <p>
                <strong>@selectedCount</strong> video@(selectedCount == 1 ? "" : "s") selected
                @if (alreadyHarvestedCount > 0)
                {
                    <span>(@alreadyHarvestedCount already harvested)</span>
                }
            </p>

            @if (alreadyHarvestedCount > 0)
            {
                <p class="text-warning">
                    <span class="oi oi-warning" aria-hidden="true"></span>
                    @alreadyHarvestedCount selected video@(alreadyHarvestedCount == 1 ? "" : "s") already harvested — these will be skipped by the harvester.
                </p>
            }

            @if (selectedCount == 0 && !Runner.IsRunning)
            {
                <p class="text-muted">Select at least one video to harvest.</p>
            }

            @if (Runner.IsRunning)
            {
                <div class="alert alert-info py-2 mb-3">
                    @(Runner.CurrentKind == HarvestJobKind.LiveDistill ? "Distilling" : "Harvesting") — this job keeps running in the background if you switch pages.
                </div>
            }

            <div class="d-flex gap-2 align-items-center mb-3 flex-wrap">
                @* Default one-click path (AUTO-01): harvest → auto-distill (subscription only) →
                   auto-approve. The plain "Harvest Selected" stays as a fallback (D-12). *@
                <button class="btn btn-primary"
                        @onclick="HarvestAndAutoDistillAsync"
                        disabled="@(selectedCount == 0 || IsBusy)">
                    Harvest + Auto-distill
                </button>
                <button class="btn btn-outline-primary"
                        @onclick="HarvestSelectedAsync"
                        disabled="@(selectedCount == 0 || IsBusy)">
                    Harvest Selected
                </button>
                @if (Runner.IsRunning)
                {
                    <button class="btn btn-outline-danger btn-sm"
                            @onclick="CancelOperation">
                        Cancel
                    </button>
                }
            </div>

            @if (!string.IsNullOrEmpty(_oneClickMeteredMessage))
            {
                <div class="alert alert-warning py-2">
                    <span class="oi oi-warning me-1" aria-hidden="true"></span>
                    @_oneClickMeteredMessage
                </div>
            }

            @* ─── Per-video outcome summary (D-11): one card, every count canonical-sourced ─── *@
            @if (_showOutcomeCard && _oneClickDistillResult is not null)
            {
                var oc = _oneClickDistillResult;
                var leftInReview = Math.Max(0, oc.VideosDistilled - _outcomeAutoApprovedCount);
                <div class="card border-success mb-3">
                    <div class="card-body">
                        <h3 class="h6 fw-semibold text-success mb-2">Harvest + Auto-distill complete</h3>
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Harvested (ready to distill):</dt>
                            <dd class="col-sm-7">@_outcomeHarvestReadyCount</dd>
                            <dt class="col-sm-5">Distilled:</dt>
                            <dd class="col-sm-7">@oc.VideosDistilled</dd>
                            <dt class="col-sm-5">Auto-approved:</dt>
                            <dd class="col-sm-7">@_outcomeAutoApprovedCount</dd>
                            <dt class="col-sm-5">Left in review:</dt>
                            <dd class="col-sm-7">@leftInReview</dd>
                            <dt class="col-sm-5">Dropped (keep/drop = drop):</dt>
                            <dd class="col-sm-7">@oc.VideosFiltered</dd>
                            <dt class="col-sm-5">Failed:</dt>
                            <dd class="col-sm-7">@oc.DistillFailed</dd>
                        </dl>

                        @if (oc.DistillFailed > 0)
                        {
                            <div class="alert alert-warning py-2 mt-2 mb-0">
                                <span class="oi oi-warning me-1" aria-hidden="true"></span>
                                Failed video IDs: @string.Join(", ", oc.FailedVideoIds)
                            </div>
                        }
                    </div>
                </div>
            }

            @if (Runner.IsRunning || _logLines.Count > 0)
            {
                <div class="mb-2">
                    @if (Runner.IsRunning)
                    {
                        <span class="fw-semibold me-2">Harvest/distill running…</span>
                        <div class="spinner-border spinner-border-sm text-primary d-inline-block"
                             role="status"
                             aria-label="Operation in progress">
                            <span class="visually-hidden">Loading…</span>
                        </div>
                    }
                    else if (_harvestResult is not null)
                    {
                        @if (_harvestResult.Success)
                        {
                            <span class="oi oi-check text-success me-1" aria-hidden="true"></span>
                            <span>Harvest complete — @_harvestResult.Captions transcript@(_harvestResult.Captions == 1 ? "" : "s") from captions, @_harvestResult.Whisper via Whisper, @_harvestResult.SkippedNoCaptions skipped (no captions).</span>
                        }
                        else
                        {
                            <span class="oi oi-warning text-danger me-1" aria-hidden="true"></span>
                            <span>Harvest stopped — @(_harvestResult.Message ?? "Unknown error"). Check the log above for details.</span>
                        }
                    }
                    else if (_harvestCancelled)
                    {
                        <span class="text-muted">Harvest cancelled.</span>
                    }
                </div>

                <pre class="bg-light border rounded p-2"
                     style="height:200px; overflow-y:auto; font-size:0.8125rem; font-family:monospace"
                     role="log"
                     aria-live="polite">@string.Join("\n", _logLines)</pre>
            }
        </div>
    </div>

    @* ─── Section 4: Distill Spend Gate (HARV-05) ─── *@
    <div class="card mt-4" id="harvest-distill" tabindex="-1">
        <div class="card-header">
            <h2 class="h5 fw-semibold mb-0">Distill</h2>
        </div>
        <div class="card-body">

            @* ─── DB-backed pending-distill loader (quick task 260615-p4d) ─── *@
            <div class="mb-3">
                @* Primary emphasis (not outline-secondary): this loader is the main way to fill the
                   distill list when you did not just browse — the sole required action here, so it
                   should not read as a minor affordance. The list also auto-loads on page init. *@
                <button class="btn btn-primary"
                        @onclick="LoadPendingDistillAsync"
                        disabled="@IsBusy">
                    @if (_loadingPending)
                    {
                        <span class="spinner-border spinner-border-sm text-primary"
                              role="status"
                              aria-label="Operation in progress">
                            <span class="visually-hidden">Loading…</span>
                        </span>
                        <span> Loading…</span>
                    }
                    else
                    {
                        <span>Load harvested (pending distill)</span>
                    }
                </button>
                <span class="form-text d-block">Loads harvested-but-not-distilled videos from the local DB so you can distill without re-browsing.</span>

                @if (!string.IsNullOrEmpty(_pendingDistillMessage))
                {
                    <div class="alert alert-info py-2 mt-2 mb-0">@_pendingDistillMessage</div>
                }
            </div>

            @if (_pendingLoaded && _pendingDistillVideos.Count > 0)
            {
                <div class="table-responsive mb-3">
                    <table class="table table-sm table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th scope="col" style="width:40px">
                                    <input type="checkbox"
                                           @onclick="ToggleAllPendingSelections"
                                           checked="@_allPendingSelected"
                                           aria-label="Select all pending-distill videos" />
                                </th>
                                <th scope="col">Title</th>
                                <th scope="col">Published</th>
                                <th scope="col">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var vm in _pendingDistillVideos)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               checked="@vm.Selected"
                                               @onchange="() => vm.Selected = !vm.Selected"
                                               aria-label="Select @vm.Title" />
                                    </td>
                                    <td>
                                        <a href="@vm.Url" target="_blank" rel="noopener noreferrer">@vm.Title</a>
                                    </td>
                                    <td class="text-nowrap">@(vm.PublishedUtc?.ToString("yyyy-MM-dd") ?? "—")</td>
                                    <td><StatusBadge Status="vm.Status" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @{
                var allSelectedForDistill = GetAllSelectedForDistill();
                // Why: pending rows previously filtered by the classifier are safe to distill again with no re-distill confirm.
                var distillHarvested = allSelectedForDistill.Where(v => v.Status == VideoStatus.Harvested || v.Status == VideoStatus.Filtered).ToList();
                var distillAlreadyDistilled = allSelectedForDistill.Where(v => v.Status == VideoStatus.Distilled).ToList();
                var readyCount = distillHarvested.Count;
                var alreadyDistilledCount = distillAlreadyDistilled.Count;
                var redistillConfirmed = _redistillCheck1 && _redistillCheck2;
                var distillIds = redistillConfirmed
                    ? distillHarvested.Select(v => v.VideoId).Concat(distillAlreadyDistilled.Select(v => v.VideoId)).ToList().AsReadOnly()
                    : distillHarvested.Select(v => v.VideoId).ToList().AsReadOnly();
                var dryRunButtonEnabled = !IsBusy
                    && (alreadyDistilledCount == 0 || redistillConfirmed)
                    && (readyCount > 0 || (alreadyDistilledCount > 0 && redistillConfirmed));
            }

            @* Pre-conditions: ready count + cap display *@
            <div class="mb-3">
                <p>
                    <strong>Videos ready to distill: @readyCount</strong>
                    @if (DistillConfig.IsSubscriptionProvider)
                    {
                        <span class="ms-2 badge bg-info text-dark">Subscription ($0)</span>
                    }
                    else
                    {
                        <span class="ms-2 badge bg-warning text-dark">Metered</span>
                    }
                </p>

                @* Cap display (D-02) *@
                <div class="d-flex gap-3 align-items-center flex-wrap mb-2">
                    <span>Monthly cap: <strong>$@Usd2(_monthlyCap)</strong></span>
                    <span>Spent this month: <strong>$@Usd2(_monthlySpent)</strong></span>
                    <span>Remaining: <strong class="@(_monthlyCap - _monthlySpent < 0 ? "text-danger" : "text-success")">$@Usd2(_monthlyCap - _monthlySpent)</strong></span>
                </div>

                @* Session cap-raise control (D-03) *@
                <div class="d-flex gap-2 align-items-end flex-wrap">
                    <div>
                        <label for="capRaiseInput" class="form-label fw-semibold small">Raise cap (this session only)</label>
                        <input id="capRaiseInput" type="number" class="form-control form-control-sm"
                               style="width:120px"
                               min="0" step="1"
                               @bind="_capRaiseInput"
                               placeholder="@Usd2(_monthlyCap)" />
                    </div>
                    <button class="btn btn-outline-secondary btn-sm"
                            @onclick="RaiseCapAsync"
                            disabled="@IsBusy">
                        Raise cap
                    </button>
                </div>
                <p class="text-muted small mt-1">Session-only override — resets to env/default on Studio restart.</p>
            </div>

            @* ─── Auto-approve panel (D-04 / D-05 / D-06 / D-07) ─── *@
            <div class="border rounded p-3 mb-3" aria-label="Auto-approve">
                <h3 class="h6 fw-semibold mb-2">Auto-approve</h3>
                <div class="form-check mb-2">
                    <input class="form-check-input" type="checkbox" id="autoApproveEnabled"
                           checked="@_autoApproveSettings.Enabled"
                           @onchange="OnAutoApproveEnabledChanged" />
                    <label class="form-check-label" for="autoApproveEnabled">
                        Auto-approve distills at/above the clip cutoff
                    </label>
                </div>
                <div class="mb-1" style="max-width:160px">
                    <label for="autoApproveCutoff" class="form-label small mb-1">Clip cutoff</label>
                    <input id="autoApproveCutoff" type="number" class="form-control form-control-sm"
                           min="0" step="1"
                           value="@_autoApproveSettings.Cutoff"
                           @onchange="OnAutoApproveCutoffChanged"
                           disabled="@(!_autoApproveSettings.Enabled)" />
                </div>
                <p class="text-muted small mt-1 mb-0">Off → every distill enters the review queue.</p>
            </div>

            @* Re-distill warning + double-confirm (Pitfall 3 / T-45-10) *@
            @if (alreadyDistilledCount > 0)
            {
                <div class="alert alert-warning py-2 mb-3">
                    <span class="oi oi-warning me-1" aria-hidden="true"></span>
                    Warning: @alreadyDistilledCount selected video@(alreadyDistilledCount == 1 ? "" : "s") have already been distilled. Re-distilling will overwrite existing summaries.
                </div>

                <div class="mb-2">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="redistillCheck1"
                               @bind="_redistillCheck1" />
                        <label class="form-check-label" for="redistillCheck1">
                            Re-distill already-distilled videos (additional spend)
                        </label>
                    </div>
                </div>

                @if (_redistillCheck1)
                {
                    <div class="mb-3 ms-3">
                        <p class="mb-1 text-warning small">
                            You are about to re-distill @alreadyDistilledCount video@(alreadyDistilledCount == 1 ? "" : "s") that already have summaries.
                            This will overwrite existing distill output. Are you sure?
                        </p>
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="redistillCheck2"
                                   @bind="_redistillCheck2" />
                            <label class="form-check-label" for="redistillCheck2">
                                Yes, I understand — overwrite existing distill output for @alreadyDistilledCount video@(alreadyDistilledCount == 1 ? "" : "s").
                            </label>
                        </div>
                    </div>
                }
            }

            @if (DistillConfig.IsSubscriptionProvider)
            {
                @* Subscription ($0): the dry-run is a spend-safety gate (HARV-05). With no metered
                   spend there is nothing to estimate, so Run Distill is reachable directly. The
                   re-distill double-confirm (folded into dryRunButtonEnabled) still applies. *@
                <p class="text-muted small mb-2">Subscription provider ($0) — no spend estimate needed.</p>
                <div class="d-flex gap-2 align-items-center mb-3">
                    <button class="btn btn-primary"
                            @onclick="() => RunDistillStageBAsync(distillIds, redistillConfirmed)"
                            disabled="@(!dryRunButtonEnabled)">
                        @if (_distillLiveInFlight)
                        {
                            <span class="spinner-border spinner-border-sm"
                                  role="status"
                                  aria-label="Operation in progress">
                                <span class="visually-hidden">Loading…</span>
                            </span>
                            <span> Distilling…</span>
                        }
                        else
                        {
                            <span>Run Distill</span>
                        }
                    </button>
                    @if (_distillLiveInFlight)
                    {
                        <button class="btn btn-outline-danger btn-sm"
                                @onclick="CancelOperation">
                            Cancel Distill
                        </button>
                        <span class="text-muted small ms-2">Elapsed: @FormatElapsed(_distillStopwatch?.Elapsed ?? TimeSpan.Zero)</span>
                    }
                </div>
            }
            else
            {
            @* Stage A: Dry-run trigger *@
            <div class="d-flex gap-2 align-items-center mb-3">
                <button class="btn btn-outline-primary"
                        @onclick="() => RunDistillStageAAsync(distillIds, redistillConfirmed)"
                        disabled="@(!dryRunButtonEnabled)">
                    @if (_distillDryRunInFlight)
                    {
                        <span class="spinner-border spinner-border-sm text-primary"
                              role="status"
                              aria-label="Operation in progress">
                            <span class="visually-hidden">Loading…</span>
                        </span>
                        <span> Estimating spend…</span>
                    }
                    else
                    {
                        <span>Estimate Spend (dry run)</span>
                    }
                </button>
                @if (_distillDryRunInFlight)
                {
                    <button class="btn btn-outline-danger btn-sm"
                            @onclick="CancelDryRun">
                        Cancel Distill
                    </button>
                }
            </div>

            @* Dry-run progress log *@
            @if (_distillDryRunInFlight || (_distillLogLines.Count > 0 && _distillDryRunResult is null && !_distillLiveInFlight))
            {
                <pre class="bg-light border rounded p-2"
                     style="height:150px; overflow-y:auto; font-size:0.8125rem; font-family:monospace"
                     role="log"
                     aria-live="polite">@string.Join("\n", _distillLogLines)</pre>
            }

            @* Dry-run result card *@
            @if (_distillDryRunResult is not null && !_distillDryRunInFlight)
            {
                var remaining = _monthlyCap - _monthlySpent;
                var capExceeded = !DistillConfig.IsSubscriptionProvider
                    && _distillDryRunResult.ProjectedSpendUsd > remaining;

                <div class="card border-primary mb-3">
                    <div class="card-body">
                        <h3 class="h6 fw-semibold text-primary mb-2">Dry-run complete</h3>
                        <dl class="row mb-0">
                            <dt class="col-sm-5">Videos that would distill:</dt>
                            <dd class="col-sm-7">@_distillDryRunResult.WouldRun</dd>
                            <dt class="col-sm-5">Projected spend:</dt>
                            <dd class="col-sm-7">$@Usd4(_distillDryRunResult.ProjectedSpendUsd) USD</dd>
                            <dt class="col-sm-5">Monthly cap remaining:</dt>
                            <dd class="col-sm-7">$@Usd2(remaining) USD</dd>
                        </dl>

                        @if (capExceeded)
                        {
                            <div class="alert alert-danger py-2 mt-2 mb-0">
                                <span class="oi oi-warning me-1" aria-hidden="true"></span>
                                Projected spend ($@Usd4(_distillDryRunResult.ProjectedSpendUsd)) exceeds your monthly cap ($@Usd2(_monthlyCap)). Reduce selection or raise the cap.
                            </div>
                        }
                    </div>
                </div>

                @* Stage B: available only after a successful dry-run with no cap-exceeded block *@
                @if (!capExceeded)
                {
                    <div class="mb-2">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="distillConfirm"
                                   @bind="_distillSpendConfirmed" />
                            <label class="form-check-label" for="distillConfirm">
                                I have reviewed the estimated spend above and want to proceed with actual distillation.
                            </label>
                        </div>
                    </div>

                    <div class="d-flex gap-2 align-items-center mb-3">
                        <button class="btn btn-primary"
                                @onclick="() => RunDistillStageBAsync(distillIds, redistillConfirmed)"
                                disabled="@(!_distillSpendConfirmed || IsBusy)">
                            @if (_distillLiveInFlight)
                            {
                                <span class="spinner-border spinner-border-sm"
                                      role="status"
                                      aria-label="Operation in progress">
                                    <span class="visually-hidden">Loading…</span>
                                </span>
                                <span> Distilling…</span>
                            }
                            else
                            {
                                <span>Run Distill</span>
                            }
                        </button>
                        @if (_distillLiveInFlight)
                        {
                            <button class="btn btn-outline-danger btn-sm"
                                    @onclick="CancelOperation">
                                Cancel Distill
                            </button>
                            <span class="text-muted small ms-2">Elapsed: @FormatElapsed(_distillStopwatch?.Elapsed ?? TimeSpan.Zero)</span>
                        }
                    </div>
                }
            }
            }

            @* Stage B progress log and result *@
            @if (_distillLiveInFlight || (_distillLogLines.Count > 0 && (_distillLiveResult is not null || _distillCancelled)))
            {
                <pre class="bg-light border rounded p-2"
                     style="height:150px; overflow-y:auto; font-size:0.8125rem; font-family:monospace"
                     role="log"
                     aria-live="polite">@string.Join("\n", _distillLogLines)</pre>
            }

            @* Stage B result *@
            @if (_distillLiveResult is not null && !_distillLiveInFlight)
            {
                @if (!_distillLiveResult.Success && !string.IsNullOrEmpty(_distillLiveResult.AbortedReason))
                {
                    <div class="alert alert-danger py-2">
                        <span class="oi oi-warning me-1" aria-hidden="true"></span>
                        Distill aborted: @_distillLiveResult.AbortedReason
                    </div>
                }
                else if (_distillLiveResult.Success || _distillLiveResult.VideosDistilled > 0)
                {
                    <div class="card border-success">
                        <div class="card-body">
                            <h3 class="h6 fw-semibold text-success mb-2">Distill complete</h3>
                            <dl class="row mb-0">
                                <dt class="col-sm-5">Videos distilled:</dt>
                                <dd class="col-sm-7">@_distillLiveResult.VideosDistilled</dd>
                                <dt class="col-sm-5">LLM calls:</dt>
                                <dd class="col-sm-7">@_distillLiveResult.LlmCalls</dd>
                                <dt class="col-sm-5">Actual spend:</dt>
                                <dd class="col-sm-7">$@Usd4(_distillLiveResult.LlmSpendUsd) USD</dd>
                                <dt class="col-sm-5">Videos filtered:</dt>
                                <dd class="col-sm-7">@_distillLiveResult.VideosFiltered</dd>
                                <dt class="col-sm-5">Failed:</dt>
                                <dd class="col-sm-7">@_distillLiveResult.DistillFailed</dd>
                                <dt class="col-sm-5">Total time:</dt>
                                <dd class="col-sm-7">@FormatElapsed(_distillTotalElapsed ?? TimeSpan.Zero)</dd>
                            </dl>

                            @if (_distillLiveResult.DistillFailed > 0)
                            {
                                <div class="alert alert-warning py-2 mt-2 mb-0">
                                    <span class="oi oi-warning me-1" aria-hidden="true"></span>
                                    Failed video IDs: @string.Join(", ", _distillLiveResult.FailedVideoIds)
                                </div>
                            }
                        </div>
                    </div>
                }
            }

            @if (_distillCancelled && !_distillLiveInFlight && !_distillDryRunInFlight)
            {
                <p class="text-muted">Distill cancelled.</p>
            }
        </div>
    </div>

</article>
