@page "/review"
@inherits StudioCancellableComponentBase
@using DeckFlow.Core.Knowledge
@using DeckFlow.Core.Content
@using DeckFlow.Core.Orchestration
@using DeckFlow.Studio.Services

<PageTitle>Review Queue</PageTitle>

<h1 class="h4 fw-semibold">Review Queue</h1>
<p class="text-muted">Review distilled entries and approve or reject them before publishing.</p>
<HelpPanel Title="Approve or reject distilled entries">
    <p class="mb-2">This page is the approval gate between distill and publish. Open each entry to inspect the generated notes and prompt, then approve what is ready or reject what should not ship.</p>
    <ul class="mb-0 ps-3">
        <li>Only approved entries move into the publish flows.</li>
        <li>If an artifact file is missing, approve is blocked until the underlying notes file is restored.</li>
    </ul>
</HelpPanel>

<PipelineStepper CurrentStage="review" />

<article class="content px-4">

    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2 mt-3">
            <span class="spinner-border spinner-border-sm text-primary"
                  role="status"
                  aria-label="Operation in progress">
                <span class="visually-hidden">Loading…</span>
            </span>
            <span class="text-muted">Loading review queue…</span>
        </div>
    }
    else if (!string.IsNullOrEmpty(_loadError))
    {
        <div class="alert alert-danger py-2 mt-3">@_loadError</div>
    }
    else
    {
        @* ─── Filter Tabs ─── *@
        <ul class="nav nav-tabs mt-3" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link @(_activeTab == "pending" ? "active" : "")"
                        type="button"
                        role="tab"
                        @onclick='() => SwitchTab("pending")'>
                    Pending
                    <span class="badge bg-secondary ms-1">@_allRows.Count(r => r.ApprovalStatus == "pending")</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(_activeTab == "approved" ? "active" : "")"
                        type="button"
                        role="tab"
                        @onclick='() => SwitchTab("approved")'>
                    Approved
                    <span class="badge bg-success ms-1">@_allRows.Count(r => r.ApprovalStatus == "approved")</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(_activeTab == "rejected" ? "active" : "")"
                        type="button"
                        role="tab"
                        @onclick='() => SwitchTab("rejected")'>
                    Rejected
                    <span class="badge bg-danger ms-1">@_allRows.Count(r => r.ApprovalStatus == "rejected")</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link @(_activeTab == "all" ? "active" : "")"
                        type="button"
                        role="tab"
                        @onclick='() => SwitchTab("all")'>
                    All
                    <span class="badge bg-secondary ms-1">@_allRows.Count</span>
                </button>
            </li>
        </ul>

        @* ─── SUI-02: Go to Publish shortcut (visible when ≥1 approved) ─── *@
        @RenderGoToPublishLink()

        @* ─── Batch Action Bar (visible when ≥1 checked) ─── *@
        @RenderBatchBar()

        @* ─── SUI-05: Creator filter ─── *@
        @RenderCreatorFilter()

        @* ─── Queue Table ─── *@
        @if (CreatorFilteredRows.Count == 0)
        {
            <p class="text-muted mt-3">@EmptyStateMessage</p>
        }
        else
        {
            <div class="table-responsive mt-3">
                <table class="table table-sm table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th scope="col" style="width:40px">
                                <input type="checkbox"
                                       @onclick="ToggleSelectAll"
                                       checked="@_allSelected"
                                       aria-label="Select all" />
                            </th>
                            <th scope="col">Title</th>
                            <th scope="col">Tags</th>
                            <th scope="col">Status</th>
                            <th scope="col">Publish State</th>
                            <th scope="col">Actions</th>
                            <th scope="col" style="width:50px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var vm in CreatorFilteredRows)
                        {
                            var rowClass = vm.ApprovalStatus switch
                            {
                                "approved" => "table-success",
                                "rejected" => "table-danger",
                                _ => "",
                            };
                            var missing = IsArtifactMissing(vm);

                            <tr class="@rowClass">
                                <td>
                                    <input type="checkbox"
                                           checked="@vm.Selected"
                                           @onchange="() => vm.Selected = !vm.Selected"
                                           aria-label="Select @vm.Title" />
                                </td>
                                <td style="max-width:300px" class="text-truncate">
                                    <a href="@vm.VideoUrl" target="_blank" rel="noopener noreferrer">@vm.Title</a>
                                </td>
                                <td>@RenderTagsSummary(vm)</td>
                                <td>
                                    <StatusBadge Status="@VideoStatusResolver.FromContentRow(vm.ApprovalStatus, vm.PushedToProdUtc, vm.IsVisible)" />
                                    @if (missing)
                                    {
                                        <span class="badge bg-warning text-dark ms-1">Artifact missing</span>
                                    }
                                </td>
                                <td><PublishStateBadge State="Deriver.Derive(vm.PushedToProdUtc, vm.IsVisible, vm.IndexedUtc)" /></td>
                                <td>
                                    @{
                                        var approveDisabledForMissing = missing && vm.ApprovalStatus != "approved";
                                        var approveAriaLabel = approveDisabledForMissing
                                            ? "Approve Entry disabled — artifact file missing"
                                            : "Approve Entry";
                                    }
                                    <button class="btn btn-sm btn-outline-primary me-1 btn-table-action"
                                            @onclick='() => SetRowStatusAsync(vm, "approved")'
                                            disabled="@(vm.ApprovalStatus == "approved" || missing)"
                                            aria-label="@approveAriaLabel">
                                        Approve Entry
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger btn-table-action"
                                            @onclick='() => SetRowStatusAsync(vm, "rejected")'
                                            disabled="@(vm.ApprovalStatus == "rejected")"
                                            aria-label="Reject Entry">
                                        Reject Entry
                                    </button>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-link p-0 btn-table-action"
                                            type="button"
                                            @onclick="() => ToggleExpand(vm)"
                                            aria-expanded="@vm.Expanded.ToString().ToLowerInvariant()"
                                            aria-label="@(vm.Expanded ? $"Collapse entry for {vm.Title}" : $"Expand entry for {vm.Title}")">
                                        <span class="oi @(vm.Expanded ? "oi-chevron-top" : "oi-chevron-bottom")"
                                              aria-hidden="true"></span>
                                    </button>
                                </td>
                            </tr>

                            @* ─── Inline Expand Row ─── *@
                            @if (vm.Expanded)
                            {
                                <tr class="bg-light">
                                    <td colspan="7" class="p-3">
                                        @{
                                            var cacheKey = vm.NaturalKeyValue;
                                            var hasCached = _expandCache.TryGetValue(cacheKey, out var cachedText);
                                            var hasPrompt = _promptCache.TryGetValue(cacheKey, out var promptText);
                                        }
                                        @if (!hasCached)
                                        {
                                            <span class="text-muted small">Loading preview…</span>
                                        }
                                        else if (cachedText is null)
                                        {
                                            <div class="alert alert-warning py-2">
                                                <span class="oi oi-warning me-1" aria-hidden="true"></span>
                                                Artifact file not found — cannot display content preview. Reject is still allowed; approve is disabled until the artifact is restored.
                                            </div>
                                        }
                                        else
                                        {
                                            <h3 class="h6 fw-semibold mb-1">Content Preview</h3>
                                            <div class="bg-white border rounded p-2 kb-notes-preview"
                                                 style="max-height:400px; overflow-y:auto; overflow-x:hidden; overflow-wrap:anywhere; font-size:0.9rem">@RenderNotesHtml(cachedText)</div>

                                            @if (hasPrompt && !string.IsNullOrEmpty(promptText))
                                            {
                                                <h3 class="h6 fw-semibold mb-1 mt-3">Paste-ready AI Prompt</h3>
                                                <p class="text-muted small mb-1">
                                                    The framed prompt a KB visitor copies into ChatGPT — persona, task, and evidence
                                                    rules wrapped around these notes. Baked into a sibling <code>.prompt.md</code> at
                                                    distill time, or reconstructed from the notes for older entries.
                                                </p>
                                                <pre class="bg-white border rounded p-2"
                                                     style="max-height:400px; overflow-y:auto; overflow-x:hidden; white-space:pre-wrap; overflow-wrap:anywhere; font-size:0.875rem; font-family:monospace">@promptText</pre>
                                            }
                                        }

                                        <dl class="row mb-0 mt-2">
                                            <dt class="col-sm-3">Archetype tags</dt>
                                            <dd class="col-sm-9">
                                                @foreach (var tag in vm.ArchetypeTags)
                                                {
                                                    <span class="badge bg-light text-dark border me-1">@tag</span>
                                                }
                                                @if (!vm.ArchetypeTags.Any())
                                                {
                                                    <span class="text-muted small">None</span>
                                                }
                                            </dd>
                                            <dt class="col-sm-3">Bracket tags</dt>
                                            <dd class="col-sm-9">
                                                @foreach (var tag in vm.BracketTags)
                                                {
                                                    <span class="badge bg-light text-dark border me-1">@tag</span>
                                                }
                                                @if (!vm.BracketTags.Any())
                                                {
                                                    <span class="text-muted small">None</span>
                                                }
                                            </dd>
                                            <dt class="col-sm-3">Card-category tags</dt>
                                            <dd class="col-sm-9">
                                                @foreach (var tag in vm.CardCategoryTags)
                                                {
                                                    <span class="badge bg-light text-dark border me-1">@tag</span>
                                                }
                                                @if (!vm.CardCategoryTags.Any())
                                                {
                                                    <span class="text-muted small">None</span>
                                                }
                                            </dd>
                                        </dl>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
    }

</article>

@code {
    // Why: these helpers use inline Razor template syntax (@<text>/@<div>) which is only valid in a
    // .razor file, so they stay in the markup @code block while the page state + event handlers live
    // in Review.razor.cs (H1 split). They read state/handlers from the code-behind partial.

    // ── SUI-02: Go to Publish shortcut ─────────────────────────────────────
    /// <summary>
    /// Returns a "Go to Publish" link when at least one approved entry exists.
    /// Navigation only — does not change any data or approval behavior.
    /// </summary>
    private RenderFragment RenderGoToPublishLink()
    {
        var approvedCount = _allRows.Count(r => r.ApprovalStatus == "approved");
        if (approvedCount == 0)
        {
            return @<text></text>;
        }

        return @<div class="d-flex align-items-center gap-2 mt-2">
            <a href="/publish"
               class="btn btn-sm btn-outline-success"
               aria-label="Go to Publish page">
                <span class="oi oi-cloud-upload me-1" aria-hidden="true"></span>
                Go to Publish (@approvedCount approved)
            </a>
            <span class="text-muted small">@approvedCount approved entr@(approvedCount == 1 ? "y is" : "ies are") ready to publish.</span>
        </div>;
    }

    // ── Batch action bar rendering (keeps @{} scoping inside RenderFragment) ──
    private RenderFragment RenderBatchBar()
    {
        // SUI-05: batch bar acts on visible (creator-filtered) rows only.
        var checkedRows = CreatorFilteredRows.Where(r => r.Selected).ToList();
        var approveEligible = checkedRows.Where(r => r.ApprovalStatus != "approved" && !IsArtifactMissing(r)).ToList();
        var rejectEligible = checkedRows.Where(r => r.ApprovalStatus != "rejected").ToList();

        if (checkedRows.Count == 0)
        {
            return @<text></text>;
        }

        return @<div class="d-flex gap-2 align-items-center mb-3 mt-2">
            <button class="btn btn-primary btn-sm"
                    @onclick='() => BatchSetStatusAsync(approveEligible, "approved", "approve")'
                    disabled="@(approveEligible.Count == 0 || _operationInFlight)">
                @if (_operationInFlight && _batchAction == "approve")
                {
                    <span class="spinner-border spinner-border-sm"
                          role="status"
                          aria-label="Operation in progress">
                        <span class="visually-hidden">Loading…</span>
                    </span>
                    <span> Approving…</span>
                }
                else
                {
                    <span>Approve Selected (@approveEligible.Count)</span>
                }
            </button>
            <button class="btn btn-outline-danger btn-sm"
                    @onclick='() => BatchSetStatusAsync(rejectEligible, "rejected", "reject")'
                    disabled="@(rejectEligible.Count == 0 || _operationInFlight)">
                @if (_operationInFlight && _batchAction == "reject")
                {
                    <span class="spinner-border spinner-border-sm"
                          role="status"
                          aria-label="Operation in progress">
                        <span class="visually-hidden">Loading…</span>
                    </span>
                    <span> Rejecting…</span>
                }
                else
                {
                    <span>Reject Selected (@rejectEligible.Count)</span>
                }
            </button>
            <span class="text-muted small">@checkedRows.Count entries selected</span>
        </div>;
    }

    // ── Creator filter rendering (SUI-05) ──────────────────────────────────
    /// <summary>
    /// Renders a "Filter by creator" dropdown when the current tab has &gt;1 distinct creator.
    /// Distinct creators are derived from <c>ArtifactPath</c> via
    /// <see cref="CreatorNameResolver.FromArtifactPath"/>. Returns an empty fragment when only
    /// one (or zero) creators exist so the filter doesn't clutter a single-creator queue.
    /// </summary>
    private RenderFragment RenderCreatorFilter()
    {
        // Distinct creators parsed from the tab-filtered rows (not yet creator-filtered) so
        // the dropdown list is stable while the filter is active.
        var creators = _filteredRows
            .Select(r => CreatorNameResolver.FromArtifactPath(r.ArtifactPath))
            .Distinct(StringComparer.Ordinal)
            .OrderBy(c => c, StringComparer.Ordinal)
            .ToList();

        if (creators.Count <= 1)
        {
            return @<text></text>;
        }

        var currentFilter = _reviewCreatorFilter;
        return @<div class="row g-2 align-items-end mb-2 mt-2">
            <div class="col-md-4">
                <label for="reviewCreatorFilter" class="form-label fw-semibold small">Filter by creator</label>
                <select id="reviewCreatorFilter" class="form-select form-select-sm"
                        value="@currentFilter"
                        @onchange="OnReviewCreatorFilterChanged">
                    <option value="">All creators</option>
                    @foreach (var creator in creators)
                    {
                        <option value="@creator">@creator</option>
                    }
                </select>
            </div>
        </div>;
    }

    // ── Tag rendering ───────────────────────────────────────────────────────
    private static RenderFragment RenderTagsSummary(ReviewViewModel vm)
    {
        var allTags = vm.ArchetypeTags
            .Concat(vm.BracketTags)
            .Concat(vm.CardCategoryTags)
            .ToList();

        var shown = allTags.Take(3).ToList();
        var remaining = allTags.Count - shown.Count;

        return @<span>
            @foreach (var tag in shown)
            {
                <span class="badge bg-light text-dark border me-1">@tag</span>
            }
            @if (remaining > 0)
            {
                <span class="text-muted small">+@remaining more</span>
            }
        </span>;
    }
}
