@page "/direct-push"
@inherits StudioCancellableComponentBase
@using DeckFlow.Core.Content
@using DeckFlow.Core.Knowledge
@using DeckFlow.Core.Orchestration
@using DeckFlow.Core.Storage
@using DeckFlow.Studio.Services
@using Microsoft.Extensions.Configuration
@using Microsoft.Extensions.Logging
@using System.Text.Json

<PageTitle>Publish to Production (Direct)</PageTitle>

<h1 class="h4 fw-semibold">Publish to Production (Direct)</h1>
<p class="text-muted">Push approved entries straight to production — upload artifacts to
Render /data, then upsert the rows into the prod database. Artifacts first; the DB step
unlocks only after every file uploads.</p>
<HelpPanel Title="Write approved entries straight to live production">
    <p class="mb-2">This is the direct-to-production publish path. It runs a staged flow that uploads artifacts, writes the live prod database, commits git durability, and only makes new rows visible after Stage 5 confirms the deployed body.</p>
    <ul class="mb-0 ps-3">
        <li>This page targets <strong>PRODUCTION</strong>; use Publish to Git when you want the safer default path.</li>
        <li>Row visibility is governed by the production warning banner on this page — read it before you start Stage 1.</li>
    </ul>
</HelpPanel>

<PipelineStepper CurrentStage="direct-push" />

<article class="content px-4">

    @if (_initError is not null)
    {
        <div class="alert alert-danger py-2 mt-3">@_initError</div>
    }
    else if (_initInFlight)
    {
        <div class="d-flex align-items-center gap-2 mt-3">
            <span class="spinner-border spinner-border-sm text-primary"
                  role="status"
                  aria-label="Operation in progress">
                <span class="visually-hidden">Loading…</span>
            </span>
            <span class="text-muted">Resolving configuration…</span>
        </div>
    }
    else
    {
        @* ─── Config gate (SC5 / D-07 / D-09): presence-only; never the value ─── *@
        @if (!Config.IsProdConfigured || !Config.IsScpConfigured || !Config.IsConfirmerConfigured)
        {
            @if (!Config.IsProdConfigured)
            {
                <div class="alert alert-warning py-2 mt-3">
                    Prod connection: not configured. Set the prod connection string in user-secrets
                    to enable direct publish.
                </div>
            }
            @if (!Config.IsScpConfigured)
            {
                <div class="alert alert-warning py-2 mt-3">
                    SCP: not configured. Set the Render SSH target in user-secrets to enable
                    artifact upload.
                </div>
            }
            @if (!Config.IsConfirmerConfigured)
            {
                <div class="alert alert-warning py-2 mt-3">
                    Deploy-confirm: not configured. Set the public site base URL and admin
                    credentials in user-secrets so the git-body deploy-confirm poll (D-09) can run —
                    without it, a pushed row can never be confirmed and go visible.
                </div>
            }
        }

        @* ─── Status header (presence-only pills) ─── *@
        <p class="mt-3 mb-1">
            @if (_approvedCount == 0)
            {
                <span class="text-muted">No approved entries to publish. Approve entries on the Review page first.</span>
            }
            else
            {
                <strong>@_approvedCount</strong>
                <span> @(_approvedCount == 1 ? "entry" : "entries") approved and ready.</span>
            }
        </p>
        <div class="mb-1">
            <span class="me-2">Prod connection:
                @if (Config.IsProdConfigured)
                {
                    <span class="badge bg-success">configured</span>
                }
                else
                {
                    <span class="badge bg-secondary">not configured</span>
                }
            </span>
            <span class="me-2">SCP:
                @if (Config.IsScpConfigured)
                {
                    <span class="badge bg-success">configured</span>
                }
                else
                {
                    <span class="badge bg-secondary">not configured</span>
                }
            </span>
            <span>Deploy-confirm:
                @if (Config.IsConfirmerConfigured)
                {
                    <span class="badge bg-success">configured</span>
                }
                else
                {
                    <span class="badge bg-secondary">not configured</span>
                }
            </span>
        </div>

        @* ─── TARGET: PRODUCTION danger banner (always shown once configured) ─── *@
        <div id="direct-push-visibility-contract" class="alert alert-danger py-2 mt-3">
            <span class="oi oi-warning me-1" aria-hidden="true"></span>
            <strong>TARGET: PRODUCTION</strong> — Stages 1&ndash;3 write directly to the live site
            database and the Render /data disk. New rows stay <strong>hidden</strong> and
            awaiting-confirm until Stage 5 verifies the deploy; a row that is already visible stays
            <strong>visible</strong> and may briefly serve its prior body until the redeploy completes.
            There is no undo. (expand&rarr;verify&rarr;contract, SYNC-09/D-06)
            <strong>Stage 4 and Stage 5 are separate steps you click</strong> &mdash; Stage 4 commits
            the pushed bodies (and the re-exported index seed) to git and pushes <code>origin</code>;
            Stage 5 polls the deployed body and, only on a confirmed hash match, publishes the rows
            visible. Neither runs automatically.
        </div>

        @* ─── Awaiting Confirm — Resume (D-10/Plan 90-06) ─── *@
        @* Why: kept rendered whenever there are still-pending rows OR a resume just ran (even if
           that resume emptied the bucket) — otherwise a fully-successful resume would clear
           _awaitingConfirmRows and the whole card (including the success result it just produced)
           would vanish on the very next render, hiding the confirmation from the operator. *@
        @if (_awaitingConfirmRows.Count > 0 || _resumeConfirmedResults.Count > 0 || _resumeNotConfirmedResults.Count > 0)
        {
            <div class="card mt-3 border-warning">
                <div class="card-header bg-warning-subtle">
                    <h2 class="h5 fw-semibold mb-0">Awaiting Confirm &mdash; Resume Interrupted Push</h2>
                </div>
                <div class="card-body">
                    @if (_awaitingConfirmRows.Count > 0)
                    {
                        <p class="text-muted small mb-2">
                            @_awaitingConfirmRows.Count row(s) already have content written to production
                            but have not been deploy-confirmed yet (e.g. this Studio session was reloaded
                            mid-flow). Resume re-runs verify; when git-body serving is ON and rows still do not
                            confirm, it can trigger one empty durability commit so Render redeploys
                            the already-committed tree. Then wait for Render healthy and Resume again.
                            See <a href="#direct-push-visibility-contract">the production visibility contract</a> for what is and is not visible right now.
                        </p>

                        @if (!string.IsNullOrEmpty(_resumeVerifyError))
                        {
                            <div class="alert alert-danger py-2">@_resumeVerifyError</div>
                        }

                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mt-2" aria-live="polite">
                                <thead class="table-light">
                                    <tr>
                                        <th>Title</th>
                                        <th>Natural key</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in _awaitingConfirmRows)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:300px">@row.Title</td>
                                            <td><code>@ResumeKeyLabel(row)</code></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <button class="btn btn-outline-warning"
                                @onclick="ResumeVerifyAsync"
                                disabled="@(_operationInFlight || !Config.IsConfirmerConfigured)">
                            @if (_resumeVerifyInFlight)
                            {
                                <span class="spinner-border spinner-border-sm"
                                      role="status"
                                      aria-label="Operation in progress">
                                    <span class="visually-hidden">Loading…</span>
                                </span>
                                <span> Re-checking deploy…</span>
                            }
                            else
                            {
                                <span>Resume &mdash; Verify Deploy &amp; Publish</span>
                            }
                        </button>
                    }
                    else
                    {
                        <p class="text-muted small mb-0">
                            All previously awaiting-confirm rows have been resolved.
                        </p>
                    }

                    @if (_resumeConfirmedResults.Count > 0 || _resumeNotConfirmedResults.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mt-3" aria-live="polite">
                                <thead class="table-light">
                                    <tr>
                                        <th>Title</th>
                                        <th>Natural key</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rr in _resumeConfirmedResults)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:300px">@rr.Title</td>
                                            <td><code>@rr.KeyType:@rr.KeyValue</code></td>
                                            <td><span class="badge bg-success">Confirmed &amp; Published</span></td>
                                        </tr>
                                    }
                                    @foreach (var rr in _resumeNotConfirmedResults)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:300px">@rr.Title</td>
                                            <td><code>@rr.KeyType:@rr.KeyValue</code></td>
                                            <td>
                                                <span class="badge bg-warning text-dark">Not yet confirmed</span>
                                                @if (!string.IsNullOrWhiteSpace(rr.Reason))
                                                {
                                                    <div class="small text-muted mt-1">@rr.Reason</div>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }

        @* ─── Stage 1 — Compute Prod Diff ─── *@
        <div class="card mt-3">
            <div class="card-header">
                <h2 class="h5 fw-semibold mb-0">Stage 1 — Compute Prod Diff</h2>
            </div>
            <div class="card-body">

                @if (!string.IsNullOrEmpty(_diffError))
                {
                    <div class="alert alert-danger py-2">@_diffError</div>
                }

                <button class="btn btn-outline-primary"
                        @onclick="ComputeDiffAsync"
                        disabled="@(_operationInFlight || _approvedCount == 0
                                    || !Config.IsProdConfigured || !Config.IsScpConfigured
                                    || !Config.IsConfirmerConfigured)">
                    @if (_diffComputeInFlight)
                    {
                        <span class="spinner-border spinner-border-sm text-primary"
                              role="status"
                              aria-label="Operation in progress">
                            <span class="visually-hidden">Loading…</span>
                        </span>
                        <span> Comparing against production…</span>
                    }
                    else
                    {
                        <span>Compute Prod Diff</span>
                    }
                </button>

                @if (_approvedCount == 0)
                {
                    <p class="text-muted mt-2 mb-0 small">Approve entries on the Review page first.</p>
                }

                @if (_diffReady)
                {
                    <div class="card border-primary mt-3">
                        <div class="card-body">
                            <h3 class="h6 fw-semibold text-primary mb-2">Diff Preview</h3>

                            @if (_newCount == 0 && _updatedCount == 0)
                            {
                                <p class="text-muted mb-0 small">Production is already up to date — no new or updated rows to publish.</p>
                            }
                            else
                            {
                                <div class="d-flex gap-2 align-items-center flex-wrap mb-2">
                                    <span class="badge bg-success">New: @_newCount</span>
                                    <span class="badge bg-primary">Updated: @_updatedCount</span>
                                    <span class="badge bg-secondary">Unchanged: @_unchangedCount</span>
                                </div>
                                <dl class="row mb-2">
                                    <dt class="col-sm-4">Target:</dt>
                                    <dd class="col-sm-8"><span class="text-danger fw-semibold">PRODUCTION</span></dd>
                                    <dt class="col-sm-4">Remote artifact path:</dt>
                                    <dd class="col-sm-8">configured</dd>
                                </dl>

                                @* Per-row table (New + Updated) — mirror Review.razor table style *@
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle mt-2"
                                           aria-live="polite">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Title</th>
                                                <th>Natural key</th>
                                                <th>Change</th>
                                                <th>Artifact file</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in _diffRows)
                                            {
                                                <tr>
                                                    <td class="text-truncate" style="max-width:300px">@item.Title</td>
                                                    <td><code>@item.KeyType:@item.KeyValue</code></td>
                                                    <td>
                                                        @if (item.IsNew)
                                                        {
                                                            <span class="badge bg-success">New</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-primary">Updated</span>
                                                        }
                                                    </td>
                                                    <td><code>@item.ArtifactFile</code></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>

                                @* Confirmation gate (D-09) *@
                                <div class="mb-3">
                                    <div class="form-check">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               id="prodReviewed"
                                               @bind="_prodReviewed" />
                                        <label class="form-check-label" for="prodReviewed">
                                            I have reviewed what will be written to PRODUCTION above.
                                        </label>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* ─── Stage 2 — Upload Artifacts to Prod /data (SCP) ─── *@
        @if (_diffReady && (_newCount > 0 || _updatedCount > 0))
        {
            <div class="card mt-3">
                <div class="card-header">
                    <h2 class="h5 fw-semibold mb-0">Stage 2 — Upload Artifacts to Prod /data (SCP)</h2>
                </div>
                <div class="card-body">

                    @if (!string.IsNullOrEmpty(_scpError))
                    {
                        <div class="alert alert-danger py-2">@_scpError</div>
                    }

                    <button class="btn btn-danger"
                            @onclick="UploadArtifactsAsync"
                            disabled="@(!_prodReviewed || _operationInFlight || !_diffReady)"
                            aria-label="@(_prodReviewed ? null : "Check the confirmation box above to enable upload")">
                        @if (_scpInFlight)
                        {
                            <span class="spinner-border spinner-border-sm"
                                  role="status"
                                  aria-label="Operation in progress">
                                <span class="visually-hidden">Loading…</span>
                            </span>
                            <span> Uploading artifacts…</span>
                        }
                        else
                        {
                            <span>Upload Artifacts to Prod /data (SCP)</span>
                        }
                    </button>

                    @* Per-file reconcile list — aria-live so it streams (SC4) *@
                    @if (_fileResults.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mt-3"
                                   aria-live="polite">
                                <thead class="table-light">
                                    <tr>
                                        <th>File</th>
                                        <th>Status</th>
                                        <th>Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var file in _fileResults)
                                    {
                                        <tr>
                                            <td><code>@file.RemoteRelativePath</code></td>
                                            <td>
                                                @if (file.Success)
                                                {
                                                    <span class="badge bg-success">Uploaded</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Failed</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!file.Success)
                                                {
                                                    <span class="text-muted small">@file.FailureReason</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (_scpSuccess)
                    {
                        <div class="alert alert-success py-2 mt-3">
                            All @_fileResults.Count artifact(s) uploaded to production /data.
                        </div>
                    }
                </div>
            </div>

            @* ─── Stage 3 — Write Approved Rows to Prod DB ─── *@
            <div class="card mt-3">
                <div class="card-header">
                    <h2 class="h5 fw-semibold mb-0">Stage 3 — Write Approved Rows to Prod DB</h2>
                </div>
                <div class="card-body">

                    @if (!string.IsNullOrEmpty(_dbError))
                    {
                        <div class="alert alert-danger py-2">@_dbError</div>
                    }

                    @if (!_scpSuccess)
                    {
                        <p class="text-muted small mb-2">
                            Locked until every artifact has uploaded successfully.
                        </p>
                    }

                    <button class="btn btn-danger"
                            @onclick="WriteRowsAsync"
                            disabled="@(!_scpSuccess || _operationInFlight)"
                            aria-label="@(_scpSuccess ? null : "Locked until every artifact has uploaded successfully")">
                        @if (_dbInFlight)
                        {
                            <span class="spinner-border spinner-border-sm"
                                  role="status"
                                  aria-label="Operation in progress">
                                <span class="visually-hidden">Loading…</span>
                            </span>
                            <span> Writing rows to production…</span>
                        }
                        else
                        {
                            <span>Write Approved Rows to Prod DB</span>
                        }
                    </button>

                    @* Per-row reconcile list *@
                    @if (_rowResults.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mt-3"
                                   aria-live="polite">
                                <thead class="table-light">
                                    <tr>
                                        <th>Title</th>
                                        <th>Natural key</th>
                                        <th>Status</th>
                                        <th>Reason</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rr in _rowResults)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:300px">@rr.Title</td>
                                            <td><code>@rr.KeyType:@rr.KeyValue</code></td>
                                            <td>
                                                @if (rr.Success)
                                                {
                                                    <span class="badge bg-success">Written</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Failed</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!rr.Success)
                                                {
                                                    <span class="text-muted small">@rr.Reason</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (_dbSuccess)
                    {
                        <div class="alert alert-success py-2 mt-3">
                            All @_rowResults.Count new/updated row(s) written to production and marked
                            awaiting deploy confirmation. Unchanged rows were already up to date and
                            were skipped. is_evergreen on existing rows was preserved.
                            See <a href="#direct-push-visibility-contract">the production visibility contract</a> for what is and is not visible right now.
                        </div>
                    }
                </div>
            </div>

            @* ─── Stage 4 — Commit Bodies to Git + Push (durability, no redeploy) ─── *@
            <div class="card mt-3">
                <div class="card-header">
                    <h2 class="h5 fw-semibold mb-0">Stage 4 — Commit Bodies to Git &amp; Push (durability)</h2>
                </div>
                <div class="card-body">

                    <p class="text-muted small mb-2">
                        Commits the pushed bodies plus the re-exported content-KB index seed to the
                        git repo and pushes the current branch to <code>origin</code> (dropping
                        <code>[skip render]</code> once the <code>sync.directpush-gitbody</code> flag
                        is ON, so a real Render redeploy can happen). This step does not itself change
                        visibility. Stage 5 below verifies the deployed body and makes new rows visible
                        only after it confirms.
                        See <a href="#direct-push-visibility-contract">the production visibility contract</a> for what is and is not visible right now.
                    </p>

                    @if (!string.IsNullOrEmpty(_gitError))
                    {
                        <div class="alert alert-danger py-2">
                            @_gitError
                            @if (!string.IsNullOrEmpty(_gitManualPushCommand))
                            {
                                <div class="mt-1"><code>@_gitManualPushCommand</code></div>
                            }
                        </div>
                    }

                    @if (!_dbSuccess)
                    {
                        <p class="text-muted small mb-2">
                            Locked until the rows have been written to the production database.
                        </p>
                    }

                    <button class="btn btn-outline-primary"
                            @onclick="CommitAndPushAsync"
                            disabled="@(!_dbSuccess || _operationInFlight)"
                            aria-label="@(_dbSuccess ? null : "Locked until the rows have been written to the production database")">
                        @if (_gitInFlight)
                        {
                            <span class="spinner-border spinner-border-sm text-primary"
                                  role="status"
                                  aria-label="Operation in progress">
                                <span class="visually-hidden">Loading…</span>
                            </span>
                            <span> Committing and pushing bodies…</span>
                        }
                        else
                        {
                            <span>Commit Bodies to Git &amp; Push</span>
                        }
                    </button>

                    @if (_gitSuccess)
                    {
                        @if (!_gitNoOp)
                        {
                            <div class="alert alert-success py-2 mt-3">
                                Committed @_gitBodyCount @(_gitBodyCount == 1 ? "body" : "bodies")
                                as <code>@_gitSha</code> and pushed to <code>origin/@_gitBranch</code>.
                                If this triggered a Render redeploy, wait for it to go healthy, then run
                                Stage 5 (Verify Deploy &amp; Publish) below to confirm and make new
                                rows visible.
                                See <a href="#direct-push-visibility-contract">the production visibility contract</a> for what is and is not visible right now.
                            </div>
                        }
                        else if (_gitPushed)
                        {
                            <div class="alert alert-success py-2 mt-3">
                                No new commit needed — the bodies were already committed. Pushed your
                                previously-unpushed durability commit(s) to
                                <code>origin/@_gitBranch</code>. Run Stage 5 (Verify Deploy &amp; Publish)
                                below once the deploy is healthy.
                                See <a href="#direct-push-visibility-contract">the production visibility contract</a> for what is and is not visible right now.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-success py-2 mt-3">
                                Already committed and in sync with <code>origin/@_gitBranch</code> —
                                nothing to push. The bodies are git-durable — run Stage 5
                                (Verify Deploy &amp; Publish) below to confirm and make new rows
                                visible.
                                See <a href="#direct-push-visibility-contract">the production visibility contract</a> for what is and is not visible right now.
                            </div>
                        }
                    }
                </div>
            </div>

            @* ─── Stage 5 — Verify Deploy & Publish (gated on _gitSuccess) ─── *@
            <div class="card mt-3">
                <div class="card-header">
                    <h2 class="h5 fw-semibold mb-0">Stage 5 — Verify Deploy &amp; Publish</h2>
                </div>
                <div class="card-body">

                    <p class="text-muted small mb-2">
                        Press this AFTER the Render deploy triggered by Stage 4 shows healthy (check
                        the Render dashboard). Polls the deployed <code>/app</code> body for each
                        pushed row and, ONLY for rows whose hash matches, stamps
                        <code>pushed_to_prod_utc</code> and flips them visible (SYNC-09/D-06). Re-run
                        this stage (or use Resume above after reloading) once the deploy catches up.
                        See <a href="#direct-push-visibility-contract">the production visibility contract</a> for what is and is not visible right now.
                    </p>

                    @if (!string.IsNullOrEmpty(_verifyError))
                    {
                        <div class="alert alert-danger py-2">@_verifyError</div>
                    }

                    @if (!_gitSuccess)
                    {
                        <p class="text-muted small mb-2">
                            Locked until Stage 4 (commit &amp; push) has completed.
                        </p>
                    }

                    <button class="btn btn-success"
                            @onclick="RunVerifyAndPublishAsync"
                            disabled="@(!_gitSuccess || _operationInFlight)"
                            aria-label="@(_gitSuccess ? null : "Locked until Stage 4 has completed")">
                        @if (_verifyInFlight)
                        {
                            <span class="spinner-border spinner-border-sm"
                                  role="status"
                                  aria-label="Operation in progress">
                                <span class="visually-hidden">Loading…</span>
                            </span>
                            <span> Verifying deploy…</span>
                        }
                        else
                        {
                            <span>Verify Deploy &amp; Publish</span>
                        }
                    </button>

                    @if (_verifyRanOnce)
                    {
                        @if (_confirmedResults.Count > 0)
                        {
                            <div class="alert alert-success py-2 mt-3">
                                @_confirmedResults.Count row(s) confirmed at <code>/app</code> and are
                                now <strong>PUBLISHED &amp; VISIBLE</strong>.
                            </div>
                        }
                        @if (_notConfirmedResults.Count > 0)
                        {
                            <div class="alert alert-warning py-2 mt-3">
                                @_notConfirmedResults.Count row(s) did NOT confirm within the retry
                                window. The Render deploy may still be in progress; wait and re-run
                                this stage (or use the Resume section above after reloading).
                                See <a href="#direct-push-visibility-contract">the production visibility contract</a> for what is and is not visible right now.
                            </div>
                        }

                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mt-2" aria-live="polite">
                                <thead class="table-light">
                                    <tr>
                                        <th>Title</th>
                                        <th>Natural key</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rr in _confirmedResults)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:300px">@rr.Title</td>
                                            <td><code>@rr.KeyType:@rr.KeyValue</code></td>
                                            <td><span class="badge bg-success">Published</span></td>
                                        </tr>
                                    }
                                    @foreach (var rr in _notConfirmedResults)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:300px">@rr.Title</td>
                                            <td><code>@rr.KeyType:@rr.KeyValue</code></td>
                                            <td><span class="badge bg-warning text-dark">Awaiting confirm</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }
    }

</article>
