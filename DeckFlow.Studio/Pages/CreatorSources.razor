@page "/creators"
@inherits StudioCancellableComponentBase
@using DeckFlow.Core.Content
@using DeckFlow.Core.Knowledge

<PageTitle>Creators</PageTitle>

<h1 class="h4 fw-semibold">Creators</h1>
<p class="text-muted">Your curated creators/channels. Add the ones you harvest from so you can pick them from a dropdown on the Harvest page instead of pasting a URL each time.</p>
<HelpPanel Title="Curate creator quick-picks for Harvest">
    <p class="mb-2">Use this page to maintain the creator list that feeds the Harvest dropdown. It is optional, but it makes repeated harvesting faster when you return to the same channels or playlists.</p>
    <ul class="mb-0 ps-3">
        <li>Removing a creator only affects these quick-picks; it does not delete existing harvested artifacts.</li>
        <li>If a creator has not been harvested yet, expect it to stay in a pending first-harvest state.</li>
    </ul>
</HelpPanel>

<article class="content px-4">

    <div class="row g-2 align-items-end mb-3" style="max-width:760px">
        <div class="col-12 col-md-5">
            <label for="creatorName" class="form-label fw-semibold small">Display name</label>
            <input id="creatorName" type="text" class="form-control"
                   placeholder="e.g. The Command Zone"
                   @bind="_displayName"
                   disabled="@_operationInFlight" />
        </div>
        <div class="col-12 col-md-5">
            <label for="creatorRef" class="form-label fw-semibold small">Channel URL, handle, or ID</label>
            <input id="creatorRef" type="text" class="form-control"
                   placeholder="e.g. https://youtube.com/@@TheCommandZone"
                   @bind="_channelRef"
                   disabled="@_operationInFlight" />
        </div>
        <div class="col-12 col-md-2">
            <button class="btn btn-primary w-100"
                    @onclick="AddAsync"
                    disabled="@(_operationInFlight || string.IsNullOrWhiteSpace(_displayName) || string.IsNullOrWhiteSpace(_channelRef))">
                Add
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-danger py-2">@_error</div>
    }

    @if (!string.IsNullOrEmpty(_notice))
    {
        <div class="alert alert-info py-2">@_notice</div>
    }

    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2 mt-3">
            <span class="spinner-border spinner-border-sm text-primary" role="status" aria-label="Operation in progress">
                <span class="visually-hidden">Loading…</span>
            </span>
            <span class="text-muted">Loading creators…</span>
        </div>
    }
    else if (_creators.Count == 0)
    {
        @if (string.IsNullOrEmpty(_error))
        {
            <p class="text-muted mt-3">No creators yet. Add one above to pick it from the Harvest dropdown.</p>
        }
    }
    else
    {
        <div class="table-responsive mt-3" style="max-width:760px">
            <table class="table table-sm table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Creator</th>
                        <th scope="col">Channel</th>
                        <th scope="col">Slug</th>
                        <th scope="col">Status</th>
                        <th scope="col" style="width:90px">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var creator in _creators)
                    {
                        <tr>
                            <td>@creator.DisplayName</td>
                            <td class="text-break">@creator.ChannelRef</td>
                            <td class="text-break"><code>@(string.IsNullOrEmpty(creator.SourceSlug) ? "—" : creator.SourceSlug)</code></td>
                            <td>@LinkStatusLabel(creator)</td>
                            <td>
                                <button class="btn btn-sm btn-outline-secondary"
                                        @onclick="() => RemoveAsync(creator)"
                                        disabled="@_operationInFlight"
                                        aria-label="Remove @creator.DisplayName">
                                    Remove
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

</article>

@code {
    [Inject]
    private ICreatorSourceStore CreatorStore { get; set; } = default!;

    [Inject]
    private IContentSourceStore ContentSourceStore { get; set; } = default!;

    private bool _loading = true;
    private bool _operationInFlight;
    private string _error = string.Empty;
    private string _notice = string.Empty;
    private string _displayName = string.Empty;
    private string _channelRef = string.Empty;
    private List<CreatorSource> _creators = new();
    // Why: existence-aware link status (P87). Maps each linked creator's content_source_id to the
    // resolved ContentSource, or null when the id points at a row that no longer exists (there is no
    // hard FK), so the UI can render "Missing source" rather than a false "Linked".
    private Dictionary<long, ContentSource?> _linkedSources = new();

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            // Why: Task.Run moves the store call off the Blazor sync context.
            var creators = await Task.Run(() => CreatorStore.ListAsync(Cts.Token), Cts.Token);
            _creators = creators.ToList();
            _linkedSources = await Task.Run(() => LoadLinkedSourcesAsync(_creators), Cts.Token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            // Why: never echo exception.Message (may leak the DB path) — generic operator-safe copy only.
            _error = "Could not load creators. Try again.";
        }
        finally
        {
            _loading = false;
            await SafeStateHasChangedAsync();
        }
    }

    // Why: resolve each linked creator's content source once per reload so the status column and the
    // remove cascade both read a consistent snapshot. Small N (curated creators), so per-id lookups
    // are fine; there is no bulk "list all sources" API and enabled-only listing would hide disabled.
    private async Task<Dictionary<long, ContentSource?>> LoadLinkedSourcesAsync(IReadOnlyList<CreatorSource> creators)
    {
        var map = new Dictionary<long, ContentSource?>();
        foreach (var creator in creators)
        {
            if (creator.ContentSourceId is long id && !map.ContainsKey(id))
            {
                map[id] = await ContentSourceStore.GetSourceAsync(id, Cts.Token);
            }
        }

        return map;
    }

    // Why: existence-aware status (P87) — a dangling content_source_id (no hard FK) degrades to
    // "Missing source" rather than a false "Linked".
    private string LinkStatusLabel(CreatorSource creator)
    {
        if (creator.ContentSourceId is not long id)
        {
            return "Pending first harvest";
        }

        if (!_linkedSources.TryGetValue(id, out var source) || source is null)
        {
            return "Missing source";
        }

        return source.IsEnabled ? "Linked" : "Disabled";
    }

    private async Task AddAsync()
    {
        if (_operationInFlight || string.IsNullOrWhiteSpace(_displayName) || string.IsNullOrWhiteSpace(_channelRef))
        {
            return;
        }

        _operationInFlight = true;
        _error = string.Empty;
        try
        {
            var name = _displayName;
            var channelRef = _channelRef;
            await Task.Run(() => CreatorStore.AddAsync(name, channelRef, Cts.Token), Cts.Token);
            _displayName = string.Empty;
            _channelRef = string.Empty;
            await ReloadAsync();
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            _error = "Could not add the creator. Try again.";
        }
        finally
        {
            _operationInFlight = false;
            await SafeStateHasChangedAsync();
        }
    }

    private async Task RemoveAsync(CreatorSource creator)
    {
        if (_operationInFlight)
        {
            return;
        }

        _operationInFlight = true;
        _error = string.Empty;
        _notice = string.Empty;
        try
        {
            // P87 remove cascade: disable the linked content source so harvest stops pulling it, but
            // never delete KB data — the content_sources row and the on-disk artifacts are preserved
            // (a later harvest re-enables the source). Only touch a row that still exists, AND only when
            // no OTHER creator alias still points at the same content_source_id — two creator refs
            // (e.g. @handle and /channel/UC...) can canonicalize to one content source, and disabling a
            // shared source would silently break the surviving alias.
            var disabledSource = false;
            if (creator.ContentSourceId is long id
                && _linkedSources.TryGetValue(id, out var source) && source is { IsEnabled: true }
                && !_creators.Any(c => c.Id != creator.Id && c.ContentSourceId == id))
            {
                await Task.Run(() => ContentSourceStore.SetEnabledAsync(id, false, Cts.Token), Cts.Token);
                disabledSource = true;
            }

            await Task.Run(() => CreatorStore.RemoveAsync(creator.Id, Cts.Token), Cts.Token);
            _creators.RemoveAll(c => c.Id == creator.Id);

            if (disabledSource)
            {
                _notice = $"Removed {creator.DisplayName}. Its KB source was disabled; any harvested artifacts under content-kb/{creator.SourceSlug}/ were kept.";
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (Exception)
        {
            _error = "Could not remove the creator. Try again.";
        }
        finally
        {
            _operationInFlight = false;
            await SafeStateHasChangedAsync();
        }
    }

}
