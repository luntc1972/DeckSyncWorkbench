@page "/"
@using DeckFlow.Core.Content
@using DeckFlow.Core.Knowledge
@inherits StudioCancellableComponentBase
@inject IContentSiteIndexStore IndexStore
@inject PublishStateDeriver Deriver
@inject StudioConfig Config

<PageTitle>DeckFlow Studio</PageTitle>

<div class="home-dashboard">
    <header class="home-header">
        <div>
            <h1 class="studio-page-title">DeckFlow Studio</h1>
            <p class="home-section-label mb-0">Pipeline at a glance</p>
        </div>

        <div class="home-quick-links">
            <a class="btn dashboard-link-primary" href="/harvest">Open Harvest</a>
            <a class="btn dashboard-link-secondary" href="/review">Review Queue</a>
            <a class="btn btn-outline-secondary" href="/publish">Publish</a>
        </div>
    </header>

    <p class="text-muted">Read-only pipeline dashboard for status and publish-state totals across your local Studio data.</p>
    <HelpPanel Title="How to use the dashboard">
        <p class="mb-2">This page is a read-only overview of what is already in the pipeline. Use it to see how many videos are harvested, distilled, approved, published, or still newer locally.</p>
        <ul class="mb-0 ps-3">
            <li>Start on <a href="/harvest">Harvest</a> when you need new videos in the pipeline.</li>
            <li>The buckets summarize state only; take actions from Harvest, Review, Publish, or the sync pages.</li>
        </ul>
    </HelpPanel>
    <p class="home-prod-indicator mb-0">
        Prod connection: <strong>@(Config.IsProdConfigured ? "configured" : "not configured")</strong>
    </p>

    @if (_loading)
    {
        <div class="d-flex align-items-center gap-2" role="status">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>Loading pipeline status…</span>
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="alert alert-danger mb-0" role="alert">@_loadError</div>
    }
    else if (_allRows.Count == 0)
    {
        <section class="dashboard-panel" aria-labelledby="home-empty-state-title">
            <h2 id="home-empty-state-title" class="h5 mb-2">No videos in the pipeline yet</h2>
            <p class="mb-0">
                Start by harvesting a creator's videos.
                <a href="/harvest">Open Harvest</a>
            </p>
        </section>
    }
    else
    {
        <section aria-labelledby="pipeline-status-title">
            <h2 id="pipeline-status-title" class="home-subheading">Pipeline status</h2>
            <div class="dashboard-grid">
                @foreach (var bucket in VideoStatusBuckets)
                {
                    <article class="dashboard-card hub-card" data-video-status="@bucket.Status">
                        @if (bucket.Href is not null)
                        {
                            <a class="dashboard-card-link" href="@bucket.Href">
                                <div class="studio-count">@GetVideoStatusCount(bucket.Status)</div>
                                <div class="dashboard-card-label">@bucket.Label</div>
                            </a>
                        }
                        else
                        {
                            <div class="studio-count">@GetVideoStatusCount(bucket.Status)</div>
                            <div class="dashboard-card-label">@bucket.Label</div>
                        }
                    </article>
                }
            </div>
        </section>

        <section class="dashboard-panel" aria-labelledby="publish-summary-title">
            <h2 id="publish-summary-title" class="home-subheading">Publish state summary</h2>
            <div class="publish-state-list">
                @foreach (var bucket in PublishStateBuckets)
                {
                    <div class="publish-state-item" data-publish-state="@bucket.State">
                        @if (bucket.Href is not null)
                        {
                            <a class="publish-state-link" href="@bucket.Href">
                                <PublishStateBadge State="bucket.State" />
                                <span class="publish-state-count">@GetPublishStateCount(bucket.State)</span>
                            </a>
                        }
                        else
                        {
                            <PublishStateBadge State="bucket.State" />
                            <span class="publish-state-count">@GetPublishStateCount(bucket.State)</span>
                        }
                    </div>
                }
            </div>
        </section>
    }
</div>

@code {
    // Why: a bucket is linked only when a surface in this app filters to that slice AND the count
    // shown can actually reach that surface's data. The harvested bucket fails the second half:
    // these counts are built from content_site_index rows, and by the enum's own definition such a
    // row is already past the harvested state, so the shared status mapper
    // (VideoStatusResolver.FromContentRow) has no branch that can return it and the count is pinned
    // at zero — pinned by HarvestedStatus_IsUnreachableFromAnIndexRow. Linking it would send an
    // operator from a permanently-zero number to the pending-distill queue, a page fed by an
    // entirely different source. The published video-status and publish-state rows stay unlinked
    // for the original, still-correct reason: Publish shows the pending export diff, not a published
    // list. Direct Push's Awaiting Confirm resume card is exactly the pushed-hidden destination.
    private static readonly (VideoStatus Status, string Label, string? Href)[] VideoStatusBuckets =
    {
        (VideoStatus.Harvested, "Harvested", null),
        (VideoStatus.Distilled, "Distilled", "/review?tab=pending"),
        (VideoStatus.Approved, "Approved", "/review?tab=approved"),
        (VideoStatus.Published, "Published", null),
    };

    private static readonly (PublishState State, string? Href)[] PublishStateBuckets =
    {
        (PublishState.NeverPublished, "/publish"),
        (PublishState.PushedHidden, "/direct-push"),
        (PublishState.Published, null),
        (PublishState.LocalNewer, "/publish"),
    };

    private IReadOnlyList<ContentSiteIndexRow> _allRows = Array.Empty<ContentSiteIndexRow>();
    private Dictionary<VideoStatus, int> _videoStatusCounts = new();
    private Dictionary<PublishState, int> _publishStateCounts = new();
    private bool _loading = true;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var rows = await Task.Run(async () =>
            {
                await IndexStore.EnsureSchemaAsync(Cts.Token).ConfigureAwait(false);
                return await IndexStore.GetAllRowsAsync(Cts.Token).ConfigureAwait(false);
            }, Cts.Token);

            _allRows = rows;
            _videoStatusCounts = BuildVideoStatusCounts(rows);
            _publishStateCounts = BuildPublishStateCounts(rows);
        }
        catch (OperationCanceledException)
        {
            // Component disposed mid-load — swallow.
        }
        catch (Exception)
        {
            _loadError = "Could not load pipeline status — check the Studio data directory and retry.";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static Dictionary<VideoStatus, int> BuildVideoStatusCounts(IReadOnlyList<ContentSiteIndexRow> rows)
    {
        var counts = VideoStatusBuckets.ToDictionary(bucket => bucket.Status, _ => 0);
        foreach (var row in rows)
        {
            var status = VideoStatusResolver.FromContentRow(row.ApprovalStatus, row.PushedToProdUtc, row.IsVisible);
            if (counts.ContainsKey(status))
            {
                counts[status]++;
            }
        }

        return counts;
    }

    private Dictionary<PublishState, int> BuildPublishStateCounts(IReadOnlyList<ContentSiteIndexRow> rows)
    {
        var counts = PublishStateBuckets.ToDictionary(bucket => bucket.State, _ => 0);
        foreach (var row in rows)
        {
            var state = Deriver.Derive(row.PushedToProdUtc, row.IsVisible, row.IndexedUtc);
            counts[state]++;
        }

        return counts;
    }

    private int GetVideoStatusCount(VideoStatus status)
        => _videoStatusCounts.TryGetValue(status, out var count) ? count : 0;

    private int GetPublishStateCount(PublishState state)
        => _publishStateCounts.TryGetValue(state, out var count) ? count : 0;
}
