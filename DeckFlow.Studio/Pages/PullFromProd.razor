@page "/pull-from-prod"
@inherits StudioCancellableComponentBase
@using DeckFlow.Core.Content
@using DeckFlow.Core.Knowledge
@using DeckFlow.Core.Orchestration
@using DeckFlow.Studio.Services
@using DeckFlow.Studio.ViewModels

<PageTitle>Pull from Production</PageTitle>

<h1 class="h4 fw-semibold">Pull from Production</h1>
<p class="text-muted">Read the live production content index, resolve bodies from the local git
tree, see a per-entry diff against your local store, and resolve each one locally. This is the read
mirror of Publish — it NEVER writes to production.</p>
<HelpPanel Title="Sync production state down into your local Studio store">
    <p class="mb-2">Use this page to compare live production against your local Studio data and adopt selected prod changes locally. It is the read-only mirror of the publish flows and never writes back to production.</p>
    <ul class="mb-0 ps-3">
        <li>Body resolution comes from your local git tree, so stale local checkout state can affect what you adopt.</li>
        <li>Each resolution writes locally only; review the diff kinds before adopting prod over local work.</li>
    </ul>
</HelpPanel>

<article class="content px-4">

    @if (_initError is not null)
    {
        <div class="alert alert-danger py-2 mt-3">@_initError</div>
    }
    else if (_initInFlight)
    {
        <div class="d-flex align-items-center gap-2 mt-3">
            <span class="spinner-border spinner-border-sm text-primary"
                  role="status"
                  aria-label="Operation in progress">
                <span class="visually-hidden">Loading…</span>
            </span>
            <span class="text-muted">Resolving configuration…</span>
        </div>
    }
    else
    {
        @* ─── Config gate (presence-only; never the value) ─── *@
        @if (!Config.IsProdConfigured)
        {
            <div class="alert alert-warning py-2 mt-3">
                Prod connection: not configured. Set the prod connection string in user-secrets
                to enable the pull.
            </div>
        }
        @* ─── Read-only assurance banner ─── *@
        <div class="alert alert-info py-2 mt-3">
            <span class="oi oi-shield" aria-hidden="true"></span>
            <strong> READ-ONLY toward production.</strong> This page only reads prod rows and
            resolves bodies from your local git tree. Every resolution you apply writes to your
            LOCAL store only.
        </div>

        @* ─── Stage 1 — Pull & classify ─── *@
        <div class="card mt-3">
            <div class="card-header">
                <h2 class="h5 fw-semibold mb-0">Stage 1 — Pull &amp; Classify</h2>
            </div>
            <div class="card-body">

                @if (!string.IsNullOrEmpty(_pullError))
                {
                    <div class="alert alert-danger py-2">@_pullError</div>
                }

                <button class="btn btn-outline-primary"
                        @onclick="PullAndClassifyAsync"
                        disabled="@(_operationInFlight || !Config.IsProdConfigured)">
                    @if (_pullInFlight)
                    {
                        <span class="spinner-border spinner-border-sm text-primary"
                              role="status"
                              aria-label="Operation in progress">
                            <span class="visually-hidden">Loading…</span>
                        </span>
                        <span> Pulling from production…</span>
                    }
                    else
                    {
                        <span>Pull from Prod</span>
                    }
                </button>

                @* ─── Live progress console (SUI-03) ─── *@
                @if (_pullInFlight || _progressLog.Count > 0)
                {
                    <div class="card border-secondary mt-3" data-testid="progress-panel">
                        <div class="card-header py-1">
                            <span class="small fw-semibold">
                                @if (_pullInFlight)
                                {
                                    <span class="spinner-border spinner-border-sm text-secondary me-1"
                                          role="status"
                                          aria-label="Pull in progress">
                                        <span class="visually-hidden">In progress</span>
                                    </span>
                                }
                                Pull Log
                            </span>
                        </div>
                        <div class="card-body p-0">
                            <pre class="m-0 p-2"
                                 style="max-height:260px;overflow-y:auto;font-size:0.8125rem;font-family:monospace;white-space:pre-wrap;overflow-wrap:anywhere"
                                 role="log"
                                 aria-live="polite"
                                 aria-label="Pull progress log">@string.Join("\n", _progressLog)</pre>
                        </div>
                    </div>
                }

                @if (_freshness is not null && _freshness.Kind != PullFreshnessKind.Fresh)
                {
                    <div class="card border-warning mt-3" data-testid="freshness-banner">
                        <div class="card-body py-2">
                            @if (_freshness.Kind == PullFreshnessKind.Behind)
                            {
                                <span>Local checkout is @_freshness.BehindCount commit(s) behind origin/@_freshness.Branch — run <code>git pull</code> before adopting.</span>
                            }
                            else
                            {
                                <span>Could not verify checkout freshness (fetch failed or timed out) — proceeding against the local git tree as-is.</span>
                            }
                        </div>
                    </div>
                }

                @if (_diffReady)
                {
                    <div class="card border-primary mt-3">
                        <div class="card-body">
                            <h3 class="h6 fw-semibold text-primary mb-2">Diff Preview</h3>

                            @if (_diffEntries.Count == 0)
                            {
                                <p class="text-muted mb-0 small">Local is already in sync with production — no differing entries.</p>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle mt-2"
                                           aria-live="polite">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Title</th>
                                                <th>Natural key</th>
                                                <th>Difference</th>
                                                <th>Artifact</th>
                                                <th>Body</th>
                                                <th>Resolution</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var entry in _diffEntries)
                                            {
                                                var key = EntryKey(entry);
                                                <tr>
                                                    <td class="text-truncate" style="max-width:280px">@entry.Title</td>
                                                    <td><code>@entry.NaturalKeyType:@entry.NaturalKeyValue</code></td>
                                                    <td>
                                                        @switch (entry.Kind)
                                                        {
                                                            case SyncDiffKind.ProdNewer:
                                                                <span class="badge bg-primary">Prod newer</span>
                                                                break;
                                                            case SyncDiffKind.MissingLocally:
                                                                <span class="badge bg-success">Missing locally</span>
                                                                break;
                                                            case SyncDiffKind.LocalOnly:
                                                                <span class="badge bg-secondary">Local only</span>
                                                                break;
                                                            case SyncDiffKind.Diverged:
                                                                <span class="badge bg-warning text-dark">Diverged</span>
                                                                @if (entry.LocalIsNewer)
                                                                {
                                                                    <span class="text-muted small ms-1">local is newer</span>
                                                                }
                                                                break;
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (entry.Kind == SyncDiffKind.LocalOnly)
                                                        {
                                                            <span class="text-muted small">n/a</span>
                                                        }
                                                        else if (entry.ArtifactDownloaded)
                                                        {
                                                            <span class="badge bg-success">in repo</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-warning text-dark">missing</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        @switch (entry.BodyDivergence)
                                                        {
                                                            case BodyDivergenceStatus.Confirmed:
                                                                <span class="badge bg-danger">divergent</span>
                                                                break;
                                                            case BodyDivergenceStatus.Indeterminate:
                                                                <span class="badge bg-warning text-dark">unverified body</span>
                                                                break;
                                                            case BodyDivergenceStatus.Clean:
                                                                <span class="badge bg-success">matches</span>
                                                                break;
                                                        }
                                                    </td>
                                                    <td>
                                                        @if (entry.Kind == SyncDiffKind.LocalOnly)
                                                        {
                                                            <span class="text-muted small">display only</span>
                                                        }
                                                        else
                                                        {
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio"
                                                                       name="res-@key" id="adopt-@key"
                                                                       checked="@(GetResolution(entry) == Resolution.AdoptProd)"
                                                                       @onchange="() => SetResolution(entry, Resolution.AdoptProd)" />
                                                                <label class="form-check-label small" for="adopt-@key">adopt prod</label>
                                                            </div>
                                                            <div class="form-check form-check-inline">
                                                                <input class="form-check-input" type="radio"
                                                                       name="res-@key" id="keep-@key"
                                                                       checked="@(GetResolution(entry) == Resolution.KeepLocal)"
                                                                       @onchange="() => SetResolution(entry, Resolution.KeepLocal)" />
                                                                <label class="form-check-label small" for="keep-@key">keep local</label>
                                                            </div>
                                                            @if (!entry.ArtifactDownloaded)
                                                            {
                                                                <div class="text-warning small">body missing in local repo — adopting updates the row only</div>
                                                            }
                                                            @if (entry.BodyDivergence is BodyDivergenceStatus.Confirmed or BodyDivergenceStatus.Indeterminate)
                                                            {
                                                                <div class="form-check mt-2">
                                                                    <input class="form-check-input" type="checkbox"
                                                                           id="divergence-optin-@key"
                                                                           data-testid="divergence-optin-@key"
                                                                           checked="@IsDivergenceAck(entry)"
                                                                           @onchange="e => SetDivergenceAck(entry, e.Value as bool? == true)" />
                                                                    <label class="form-check-label small" for="divergence-optin-@key">I understand this body diverges from prod — adopt anyway</label>
                                                                </div>
                                                            }
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>

        @* ─── Stage 2 — Resolve ─── *@
        @if (_diffReady && _diffEntries.Count > 0)
        {
            <div class="card mt-3">
                <div class="card-header">
                    <h2 class="h5 fw-semibold mb-0">Stage 2 — Resolve (local only)</h2>
                </div>
                <div class="card-body">

                    @if (!string.IsNullOrEmpty(_applyError))
                    {
                        <div class="alert alert-danger py-2">@_applyError</div>
                    }

                    <button class="btn btn-primary"
                            @onclick="ApplyResolutionsAsync"
                            disabled="@(_operationInFlight || !_diffReady || !AnyResolutionChosen())">
                        @if (_applyInFlight)
                        {
                            <span class="spinner-border spinner-border-sm"
                                  role="status"
                                  aria-label="Operation in progress">
                                <span class="visually-hidden">Loading…</span>
                            </span>
                            <span> Applying locally…</span>
                        }
                        else
                        {
                            <span>Apply Resolutions (local)</span>
                        }
                    </button>

                    @if (_rowResults.Count > 0)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mt-3"
                                   aria-live="polite">
                                <thead class="table-light">
                                    <tr>
                                        <th>Title</th>
                                        <th>Natural key</th>
                                        <th>Status</th>
                                        <th>Note</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var rr in _rowResults)
                                    {
                                        <tr>
                                            <td class="text-truncate" style="max-width:280px">@rr.Title</td>
                                            <td><code>@rr.KeyType:@rr.KeyValue</code></td>
                                            <td>
                                                @if (rr.Success)
                                                {
                                                    <span class="badge bg-success">@rr.Action</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger">Failed</span>
                                                }
                                            </td>
                                            <td><span class="text-muted small">@rr.Note</span></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    @if (_applySuccess)
                    {
                        <div class="alert alert-success py-2 mt-3">
                            Resolutions applied to the local store. Production was not modified.
                        </div>
                    }
                </div>
            </div>
        }
    }

</article>
