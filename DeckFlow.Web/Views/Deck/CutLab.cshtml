@using System.Text.Json
@using DeckFlow.Core.Manabase
@using DeckFlow.Web.Models
@using DeckFlow.Web.Models.CutLab
@using DeckFlow.Web.Services.CutLab
@model DeckFlow.Web.Models.CutLabViewModel
@{
    ViewData["Title"] = "Cut Lab";
    ViewData["Description"] = "Trim an oversized Commander card pool with a structured cut workspace that identifies removable cards, protects locked roles, and exports your finished deck.";
    var isUrl = Model.Request.DeckInputSource == DeckInputSource.PublicUrl;
    var totalStructuralFindings = Model.Findings.Count;
    var cardsRemainingToTarget = Model.StickyBar.CardsRemainingToCut;
    var currentCount = Model.CurrentCount;
    var exportTabs = new WorkflowStepTabsModel(
        AriaLabel: "Cut Lab workflow steps",
        TabIdPrefix: "cut-lab-step-tab",
        PanelIdPrefix: "cut-lab-step-panel",
        DataShowStepAttribute: "cut-lab-step",
        CurrentStepOverride: Model.CurrentStepOverride,
        UseMobileLabeledTabs: true,
        Steps:
        [
            new WorkflowStepTab(1, "Process", IsComplete: Model.HasResult),
            new WorkflowStepTab(2, "Decide", IsComplete: cardsRemainingToTarget == 0),
            new WorkflowStepTab(3, "Plan", IsComplete: false, IsEnabled: true),
            new WorkflowStepTab(4, "Goals", IsComplete: true),
            new WorkflowStepTab(5, "Export", IsComplete: Model.Export.HasExport, IsEnabled: currentCount == 100, SubmitFormId: "cut-lab-export-form"),
        ]);
    string DeltaValueClass(CutLabMetricDirection direction) => direction switch
    {
        CutLabMetricDirection.Up => "cutlab-delta__value--up",
        CutLabMetricDirection.Down => "cutlab-delta__value--down",
        _ => "cutlab-delta__value--none",
    };
    string DeltaGlyph(CutLabMetricDirection direction) => direction switch
    {
        CutLabMetricDirection.Up => "▲",
        CutLabMetricDirection.Down => "▼",
        _ => string.Empty,
    };
    async Task RenderDecisionForm(string cardName, string roundKey, string decisionValue, string buttonText, string classSuffix, string ariaLabel)
    {
        <form method="post" action="@Url.Content("~/cut-lab/decide")" data-cut-lab-decide-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="CutLabStateJson" value="@Model.CutLabStateJson" />
            <input type="hidden" name="CardName" value="@cardName" />
            <input type="hidden" name="RoundKey" value="@roundKey" />
            <input type="hidden" name="Decision" value="@decisionValue" />
            @if (decisionValue == "restore")
            {
                <button type="submit"
                        class="cutlab-restore-btn"
                        aria-label="@ariaLabel"
                        data-cut-lab-restore
                        data-cut-lab-card="@cardName">@buttonText</button>
            }
            else
            {
                <button type="submit"
                        class="cutlab-decision-btn cutlab-decision-btn--@classSuffix"
                        aria-label="@ariaLabel"
                        data-cut-lab-decision="@decisionValue"
                        data-cut-lab-card="@cardName">@buttonText</button>
            }
        </form>
    }
    async Task RenderAdjustForm(string cardName, int delta, bool isAddedBasic, string buttonText, string className, string ariaLabel, bool isDisabled, string? title = null)
    {
        <form method="post" action="@Url.Content("~/cut-lab/adjust")" data-cut-lab-adjust-form>
            @Html.AntiForgeryToken()
            <input type="hidden" name="CutLabStateJson" value="@Model.CutLabStateJson" />
            <input type="hidden" name="CardName" value="@cardName" />
            <input type="hidden" name="Delta" value="@delta" />
            <input type="hidden" name="IsAddedBasic" value="@(isAddedBasic ? "true" : "false")" />
            <button type="submit"
                    class="@className"
                    aria-label="@ariaLabel"
                    title="@title"
                    data-cut-lab-adjust
                    data-cut-lab-card="@cardName"
                    data-cut-lab-delta="@delta"
                    data-cut-lab-added-basic="@(isAddedBasic ? "true" : "false")"
                    disabled="@(isDisabled ? "disabled" : null)"
                    aria-disabled="@(isDisabled ? "true" : "false")">@buttonText</button>
        </form>
    }
    async Task RenderDeltaValue(CutLabMetricDirection direction, string token)
    {
        <span class="cutlab-delta__value @DeltaValueClass(direction)">
            @if (direction != CutLabMetricDirection.None)
            {
                <span aria-hidden="true">@DeltaGlyph(direction)</span>
            }
            <span>@token</span>
        </span>
    }
    async Task RenderDeltaLines(IEnumerable<CutLabDeltaLineView> lines)
    {
        foreach (var line in lines)
        {
            <div class="cutlab-delta__line">
                <span class="cutlab-delta__sentence">@line.Sentence</span>
                @{ await RenderDeltaValue(line.Direction, line.FormattedValueToken); }
            </div>
        }
    }
}

<div class="cutlab-workspace">
<section class="hero cutlab-hero">
    <h1>Cut Lab</h1>
    <p class="lede">Bring an oversized Commander pool into a workspace, declare what the finished 100 should do, then protect the cards that must survive every future cut.</p>
    <details class="cutlab-collapsible" open>
        <summary class="cutlab-collapsible__summary">How Cut Lab works</summary>
        <ol>
            <li>Lock the cards that must survive — tick a card to protect it.</li>
            <li>Cut Lab proposes cuts one at a time — you don't pick cards, it does.</li>
            <li>Accept / Reject / Defer each proposal until you reach 100.</li>
            <li>Tune land / multiple-copy counts, then Export.</li>
        </ol>
    </details>
</section>

@await Html.PartialAsync("_BusyIndicator")
@await Html.PartialAsync("_DeckToolTabs", Model.ActiveTab)

<div class="error-banner @(string.IsNullOrWhiteSpace(Model.ErrorMessage) ? "hidden" : string.Empty)" role="alert">
    @Model.ErrorMessage
</div>

<details class="cutlab-intake" data-cut-lab-intake-summary open="@(!Model.HasResult ? "open" : null)">
    <summary class="cutlab-intake-summary">
        @if (Model.HasResult)
        {
            <span class="cutlab-intake-summary__commander">@Model.IntakeSummaryText</span>
            <span class="cutlab-intake-summary__change">Change intake</span>
        }
        else
        {
            <span class="cutlab-intake-summary__commander">Import a pool</span>
        }
    </summary>
<form method="post" action="@Url.Content("~/cut-lab")" class="result-panel"
      data-cache-key="cut-lab"
      data-cut-lab-decide-action="@Url.Content("~/cut-lab/decide")"
      data-cut-lab-decide-api="@Url.Content("~/api/cut-lab/decide")"
      data-busy-title="Importing pool"
      data-busy-message="Loading the deck, resolving cards, and rebuilding your protected pool."
      data-busy-progress="Loading the deck|Resolving cards via Scryfall|Checking commander + legality|Building the cut workspace">
    @Html.AntiForgeryToken()
    <input type="hidden" name="CutLabStateJson" value="@Model.CutLabStateJson" />

    <div class="field">
        <label for="cut-lab-input-source">Input method</label>
        <select id="cut-lab-input-source" name="DeckInputSource" data-df-select>
            <option value="@DeckInputSource.PublicUrl" selected="@(isUrl ? "selected" : null)">Use public deck URL</option>
            <option value="@DeckInputSource.PasteText" selected="@(!isUrl ? "selected" : null)">Paste text</option>
        </select>
    </div>

    <div class="field @(isUrl ? string.Empty : "hidden")" data-sync-panel="cut-lab-deck-url">
        <label for="cut-lab-deck-url">Archidekt or Moxfield deck URL</label>
        <input id="cut-lab-deck-url" type="url" name="DeckUrl" spellcheck="false" autocomplete="off"
               placeholder="https://moxfield.com/decks/… or https://archidekt.com/decks/…"
               value="@Model.Request.DeckUrl" />
        @await Html.PartialAsync("_DeckFlowBridgeHint")
    </div>

    <div class="field @(isUrl ? "hidden" : string.Empty)" data-sync-panel="cut-lab-deck-text">
        <label for="cut-lab-deck-text">Paste a decklist (one card per line)</label>
        <textarea id="cut-lab-deck-text" name="DeckText" rows="6" spellcheck="false" autocomplete="off"
                  placeholder="1 Sol Ring&#10;1 Command Tower&#10;…">@Model.Request.DeckText</textarea>
    </div>

    <fieldset class="manabase-segmented" role="radiogroup">
        <legend>Target bracket</legend>
        <div class="manabase-pills">
            @foreach (var bracket in new[]
            {
                new { Value = 1, Label = "B1 Exhibition" },
                new { Value = 2, Label = "B2 Core" },
                new { Value = 3, Label = "B3 Upgraded" },
                new { Value = 4, Label = "B4 Optimized" },
                new { Value = 5, Label = "B5 cEDH" },
            })
            {
                <label class="manabase-pill @(Model.Request.Bracket == bracket.Value ? "is-selected" : null)">
                    <input type="radio" name="Bracket" value="@bracket.Value"
                           checked="@(Model.Request.Bracket == bracket.Value ? "checked" : null)" />
                    <span>@bracket.Label</span>
                </label>
            }
        </div>
    </fieldset>

    <fieldset class="manabase-segmented" role="radiogroup">
        <legend>Desired play experience</legend>
        <div class="manabase-pills">
            @foreach (var playExperience in new[]
            {
                new { Value = "Casual", Help = "Casual" },
                new { Value = "Focused", Help = "Focused" },
                new { Value = "cEDH", Help = "cEDH" },
            })
            {
                <label class="manabase-pill @(string.Equals(Model.Request.PlayExperience, playExperience.Value, StringComparison.OrdinalIgnoreCase) ? "is-selected" : null)">
                    <input type="radio" name="PlayExperience" value="@playExperience.Value"
                           checked="@(string.Equals(Model.Request.PlayExperience, playExperience.Value, StringComparison.OrdinalIgnoreCase) ? "checked" : null)" />
                    <span>@playExperience.Help</span>
                </label>
            }
        </div>
        <p class="manabase-help">Your play experience sets how roles are read (counterspells count as interaction only in cEDH) and, with your bracket, sets the default role floors below.</p>
    </fieldset>

    <div class="result-panel nested-panel">
        <label class="prompt-question-option">
            <input type="checkbox" name="IncludeSideboard" value="true" @(Model.Request.IncludeSideboard ? "checked" : "") />
            <span>Include sideboard</span>
        </label>
        <label class="prompt-question-option">
            <input type="checkbox" name="IncludeMaybeboard" value="true" @(Model.Request.IncludeMaybeboard ? "checked" : "") />
            <span>Include considering / maybeboard</span>
        </label>
        <p class="manabase-help">Moxfield calls this "Considering"; Archidekt calls it "Maybeboard".</p>
    </div>

    <div class="toolbar">
        <button type="submit" class="run-button">Import pool</button>
        <a href="@Url.Content("~/cut-lab")" class="clear-cache-button" role="button" data-clear-cache data-no-busy>Start over</a>
    </div>
</form>
</details>

@if (Model.HasResult)
{
    var cardTextData = new Dictionary<string, Dictionary<string, string>>(StringComparer.Ordinal);
    foreach (var cardName in Model.Pool.Select(card => card.Name).Concat(Model.CardTextByCardName.Keys).Distinct(StringComparer.Ordinal))
    {
        var entry = new Dictionary<string, string>(StringComparer.Ordinal);
        if (Model.CardTextByCardName.TryGetValue(cardName, out var cardText))
        {
            if (!string.IsNullOrWhiteSpace(cardText.TypeLine))
            {
                entry["typeLine"] = cardText.TypeLine;
            }

            if (!string.IsNullOrWhiteSpace(cardText.ManaCost))
            {
                entry["manaCost"] = cardText.ManaCost;
            }

            if (!string.IsNullOrWhiteSpace(cardText.Power))
            {
                entry["power"] = cardText.Power;
            }

            if (!string.IsNullOrWhiteSpace(cardText.Toughness))
            {
                entry["toughness"] = cardText.Toughness;
            }

            if (!string.IsNullOrWhiteSpace(cardText.SetCode))
            {
                entry["setCode"] = cardText.SetCode;
            }

            if (!string.IsNullOrWhiteSpace(cardText.CollectorNumber))
            {
                entry["collectorNumber"] = cardText.CollectorNumber;
            }

            if (!string.IsNullOrWhiteSpace(cardText.OracleText))
            {
                entry["oracleText"] = cardText.OracleText;
            }
        }

        if (Model.ComboBadgeByCardName.TryGetValue(CutLabCardNames.Normalize(cardName), out var comboBadge)
            && !string.IsNullOrWhiteSpace(comboBadge.Context))
        {
            entry["comboContext"] = comboBadge.Context;
        }

        if (entry.Count > 0)
        {
            cardTextData[cardName] = entry;
        }
    }

    <section class="deck-history-results" data-scroll-on-load>
        <script type="application/json" id="cutlab-card-text-data">@Html.Raw(JsonSerializer.Serialize(cardTextData))</script>
        @await Html.PartialAsync("_WorkflowStepTabs", exportTabs)

        @if (Model.Warnings.Count > 0)
        {
            <div class="warning-banner" role="status">
                <ul>
                    @foreach (var warning in Model.Warnings)
                    {
                        <li>@warning</li>
                    }
                </ul>
            </div>
        }

        <nav class="cutlab-anchor-nav" aria-label="Jump to section">
            <p class="cutlab-anchor-nav-label">On this page</p>
            <ul class="cutlab-anchor-nav-list">
                <li><a href="#cut-lab-step-panel-1">Process</a></li>
                <li><a href="#cut-lab-section-lock-pool">Lock your pool</a></li>
                <li><a href="#cut-lab-section-competes">How your pool competes</a></li>
                <li><a href="#cut-lab-section-by-type">By type</a></li>
                <li><a href="#cut-lab-section-by-subtype">By subtype</a></li>
                <li><a href="#cut-lab-section-structural">Structural findings</a></li>
                <li><a href="#cut-lab-section-role-floors">Role floors</a></li>
                <li><a href="#cut-lab-step-panel-2">Decide</a></li>
                <li><a href="#cut-lab-section-cut-rounds">Cut rounds</a></li>
                <li><a href="#cut-lab-section-tune">Tune quantities</a></li>
                <li><a href="#cut-lab-section-cuts-made">Cuts made</a></li>
                <li><a href="#cut-lab-section-goals">Goals</a></li>
                <li><a href="#cut-lab-section-export">Export</a></li>
            </ul>
        </nav>

        <section class="result-panel" role="tabpanel" id="cut-lab-step-panel-1" aria-labelledby="cut-lab-step-tab-1">
            <details class="cutlab-collapsible" data-cutlab-mobile-collapse id="cut-lab-section-lock-pool">
                <summary class="cutlab-collapsible__summary">Lock your pool</summary>
                <div class="panel-heading">
                    <div>
                        <h2>Lock your pool</h2>
                        <p class="prompt-size-note">
                            <span data-cut-lab-lock-count>@Model.PoolStatusText</span>
                        </p>
                        <p class="prompt-size-note">@Model.BoardCounts.ToBreakdown()</p>
                        <p class="manabase-help">Assigning a package groups cards for bulk lock/unlock — it doesn't remove them from the pool.</p>
                        <p>@(Model.IsLegal ? "No banned cards found" : $"Banned cards present: {string.Join(", ", Model.BannedCardsPresent)}")</p>
                        <div class="cutlab-pool-filter" hidden>
                            <div class="cutlab-pool-filter__group" role="radiogroup" aria-label="Show">
                                <span class="cutlab-pool-filter__label">Show:</span>
                                <label class="cutlab-pool-filter__option">
                                    <input type="radio" name="CutLabPoolFilter" value="all" checked />
                                    <span>All</span>
                                </label>
                                <label class="cutlab-pool-filter__option">
                                    <input type="radio" name="CutLabPoolFilter" value="locked" />
                                    <span>Locked</span>
                                </label>
                                <label class="cutlab-pool-filter__option">
                                    <input type="radio" name="CutLabPoolFilter" value="unlocked" />
                                    <span>Unlocked</span>
                                </label>
                            </div>
                            <input type="text" class="cutlab-pool-search" placeholder="Search card name…" aria-label="Search card name" />
                            <p class="cutlab-pool-match-count">Showing @Model.Pool.Count of @Model.Pool.Count cards</p>
                        </div>
                    </div>
                </div>
                <div class="cutlab-sticky-bar cutlab-sticky-bar--pool">
                    <span class="cutlab-sticky-bar__count" data-cut-lab-pool-sticky-count>@Model.PoolStatusText</span>
                    <span class="cutlab-sticky-bar__accepted" data-cut-lab-pool-sticky-breakdown>@Model.BoardCounts.ToBreakdown()</span>
                </div>
            @if (Model.CommanderSelectionRequired)
            {
                <div class="result-panel nested-panel" data-scroll-on-load>
                    <div class="panel-heading">
                        <div>
                            <h2>Pick your commander</h2>
                            <p>We couldn't identify your commander automatically. Choose it below — it will be locked automatically once selected.</p>
                        </div>
                    </div>
                    <div class="field">
                        <label for="cut-lab-selected-commander">Commander from this deck</label>
                        <select id="cut-lab-selected-commander" name="SelectedCommander" data-df-select autofocus>
                            <option value="">Choose a commander</option>
                            @foreach (var commanderChoice in Model.CommanderChoices)
                            {
                                <option value="@commanderChoice" selected="@(string.Equals(Model.Request.SelectedCommander, commanderChoice, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                    @commanderChoice
                                </option>
                            }
                        </select>
                    </div>
                    <div class="field">
                        <label for="cut-lab-commander-search">Commander search backstop</label>
                        <input id="cut-lab-commander-search"
                               type="text"
                               value="@Model.Request.SelectedCommander"
                               placeholder="Start typing a commander name…"
                               autocomplete="off"
                               list="cut-lab-commander-suggestions"
                               data-commander-search="@Url.Content("~/manabase/commander-search")"
                               data-commander-target="#cut-lab-selected-commander"
                               data-commander-create-option="true" />
                        <datalist id="cut-lab-commander-suggestions"></datalist>
                        <p class="manabase-help">Pick a commander, then re-run the same import. Your decklist and declared intent stay intact.</p>
                    </div>
                </div>
            }

            <div class="history-timeline__wrap">
                <table class="conflicts-table" data-prompt-cedh-reference-table role="table">
                    <thead>
                        <tr>
                            <th scope="col">Lock (keep)<span class="prompt-size-note">Lock a card to protect it from future cuts.</span></th>
                            <th scope="col">Card</th>
                            <th scope="col">Type / role</th>
                            <th scope="col">Package assignment</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var card in Model.Pool)
                        {
                            var frontTypeLine = CardTypeLine.FrontFace(card.TypeLine);
                            var roleList = Model.RoleListByCardName.TryGetValue(card.Name, out var displayRoles) ? displayRoles : string.Empty;
                            var roleKeys = Model.RoleKeysByCardName.TryGetValue(card.Name, out var rawRoleKeys) ? rawRoleKeys : string.Empty;
                            <tr data-cut-lab-card="@card.Name"
                                data-cut-lab-type-line="@card.TypeLine"
                                data-cut-lab-role="@roleKeys"
                                data-cut-lab-quantity="@card.Quantity"
                                data-cut-lab-commander="@(card.IsCommander ? "true" : "false")">
                                <td data-label="Lock">
                                    <input type="checkbox"
                                           name="Lock_@card.Name"
                                           value="@card.Name"
                                           data-cut-lab-lock-card="@card.Name"
                                           checked="@(card.IsLocked ? "checked" : null)"
                                           disabled="@(card.IsCommander ? "disabled" : null)" />
                                </td>
                                <td data-label="Card">
                                    <strong>@card.Quantity × <button type="button" class="cutlab-card-link" data-cutlab-card-open="@card.Name">@card.Name</button></strong>
                                    @if (card.IsCommander)
                                    {
                                        <div class="cutlab-commander-card-cell__details">
                                            <div>
                                                <span class="kb-chip cutlab-lock-badge--commander">Commander · Always locked</span>
                                            </div>
                                        </div>
                                    }
                                </td>
                                <td data-label="Type / role">
                                    @frontTypeLine
                                    @if (!string.IsNullOrWhiteSpace(roleList))
                                    {
                                        <div class="cutlab-role-list">@roleList</div>
                                    }
                                </td>
                                <td data-label="Package">
                                    <select name="Package_@card.Name" data-df-select data-cut-lab-package-card="@card.Name">
                                        <option value="">Unlocked pool</option>
                                        @foreach (var package in Model.Packages)
                                        {
                                            <option value="@package.Id" selected="@(string.Equals(card.PackageId, package.Id, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                                @package.Name
                                            </option>
                                        }
                                        <option value="__new__">+ New package…</option>
                                    </select>
                                </td>
                            </tr>
                        }
                        <tr class="cutlab-pool-empty-row" hidden>
                            <td colspan="4">No cards match.</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <section class="result-panel nested-panel">
                <details class="cutlab-collapsible" data-cutlab-mobile-collapse id="cut-lab-section-packages">
                    <summary class="cutlab-collapsible__summary">Packages</summary>
                    <div class="cutlab-package-help">
                        <p class="cutlab-package-help__heading">How packages work</p>
                        <p>Grouping a card into a package doesn't remove it from the pool — it's still counted and still cuttable unless the package itself is locked. Packages let you lock or unlock several cards together instead of one at a time.</p>
                    </div>
                    @if (Model.Packages.Count > 0)
                    {
                        @foreach (var package in Model.Packages)
                        {
                            var members = Model.Pool.Where(card => string.Equals(card.PackageId, package.Id, StringComparison.OrdinalIgnoreCase)).ToList();
                            <div class="result-panel nested-panel @(package.Locked ? "cutlab-package--locked" : string.Empty)"
                                 data-cut-lab-package-id="@package.Id"
                                 data-cut-lab-package-name="@package.Name">
                                <div class="panel-heading">
                                    <div>
                                        <h2>@package.Name</h2>
                                        <p>@members.Count member@(members.Count == 1 ? string.Empty : "s")</p>
                                    </div>
                                    <div class="panel-heading__actions">
                                        <label class="kb-chip" for="cut-lab-package-lock-@package.Id">
                                            <input id="cut-lab-package-lock-@package.Id"
                                                   type="checkbox"
                                                   data-cut-lab-package-toggle="@package.Id"
                                                   checked="@(package.Locked ? "checked" : null)" />
                                            <span>Lock package</span>
                                        </label>
                                        <button type="button" class="clear-cache-button" data-cut-lab-package-delete="@package.Id">Delete package</button>
                                    </div>
                                </div>
                                @if (members.Count > 0)
                                {
                                    <div class="kb-chip-area__chips">
                                        @foreach (var member in members)
                                        {
                                            <span class="kb-chip">@member.Name</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <p class="kb-chip-area__empty-hint">No cards assigned yet.</p>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="kb-chip-area__empty-hint">No packages yet. Use a card's Package assignment menu, then choose + New package…</p>
                    }

                    <div class="card-picker__rows">
                        <div class="card-picker__row hidden" data-cut-lab-new-package-row>
                            <div class="card-picker__input-shell">
                                <input class="card-picker__input"
                                       type="text"
                                       id="cut-lab-new-package-name"
                                       placeholder="New package name"
                                       data-cut-lab-new-package-input />
                            </div>
                            <button type="button" class="card-picker__add" aria-label="Save package" data-cut-lab-new-package-save>+</button>
                            <button type="button" class="card-picker__remove" aria-label="Cancel package" data-cut-lab-new-package-cancel>&times;</button>
                        </div>
                    </div>
                </details>
            </section>
            </details>

        <section class="result-panel">
            <details class="cutlab-collapsible" data-cutlab-mobile-collapse id="cut-lab-section-competes">
                <summary class="cutlab-collapsible__summary">How your pool competes</summary>
                <div class="panel-heading">
                    <div>
                        <h2>How your pool competes</h2>
                        <p>Cards grouped by the role they're fighting for. A card can fill more than one role — it appears in every group it competes in.</p>
                    </div>
                </div>
                @foreach (var group in Model.RoleGroups)
                {
                    var memberCount = group.Members.Count;
                    var lowerDisplayLabel = group.DisplayLabel.ToLowerInvariant();
                    <details class="cutlab-role-group" data-cutlab-group-kind="role">
                        <summary class="cutlab-role-group__summary">@group.DisplayLabel · @memberCount cards · <span data-cut-lab-group-locked="@group.RoleKey">@group.LockedCount</span> locked</summary>
                        <div class="cutlab-role-group__body">
                            @if (group.IsLockable)
                            {
                                <button type="button"
                                        class="manabase-pill @(group.AllLockableMembersLocked ? "is-selected" : null)"
                                        data-cut-lab-lock-role="@group.RoleKey"
                                        aria-pressed="@(group.AllLockableMembersLocked ? "true" : "false")">
                                    <span>Lock all @lowerDisplayLabel</span>
                                </button>
                            }
                            @if (memberCount > 0)
                            {
                                <div class="kb-chip-area__chips">
                                    @foreach (var member in group.Members)
                                    {
                                        if (member.IsCommander)
                                        {
                                            <span class="kb-chip cutlab-lock-badge--commander"
                                                  data-cutlab-card-open="@member.Name"
                                                  data-cut-lab-chip-card="@member.Name">@member.Name</span>
                                        }
                                        else
                                        {
                                            var chipClasses = $"kb-chip cutlab-role-chip{(member.IsLocked ? " cutlab-role-chip--locked" : string.Empty)}";
                                            <button type="button"
                                                    class="@chipClasses"
                                                    data-cutlab-card-open="@member.Name"
                                                    data-cut-lab-chip-card="@member.Name"
                                                    aria-pressed="@(member.IsLocked ? "true" : "false")">@member.Name</button>
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="kb-chip-area__empty-hint">No @lowerDisplayLabel cards detected in this pool.</p>
                            }

                            @if (string.Equals(group.RoleKey, "interaction-targeted", StringComparison.Ordinal))
                            {
                                <p class="cutlab-role-group__help">One-shot removal aimed at a single permanent or spell. Counterspells count here only for a cEDH play experience.</p>
                            }

                            @if (string.Equals(group.RoleKey, "interaction-mass", StringComparison.Ordinal))
                            {
                                <p class="cutlab-role-group__help">Board wipes and other sweepers that hit multiple permanents at once.</p>
                            }
                        </div>
                    </details>
                }
            </details>
        </section>

        <section class="result-panel">
            <details class="cutlab-collapsible" data-cutlab-mobile-collapse id="cut-lab-section-by-type">
                <summary class="cutlab-collapsible__summary">By type</summary>
                <div class="panel-heading">
                    <div>
                        <h2>By type</h2>
                        <p>Your pool grouped by card type.</p>
                    </div>
                </div>
                @foreach (var group in Model.TypeGroups)
                {
                    <details class="cutlab-role-group" data-cutlab-group-kind="type">
                        <summary class="cutlab-role-group__summary">@group.DisplayLabel · @group.CardCount cards · <span>@group.LockedCount</span> locked</summary>
                        <div class="cutlab-role-group__body">
                            <div class="kb-chip-area__chips">
                                @foreach (var member in group.Members)
                                {
                                    if (member.IsCommander)
                                    {
                                        <span class="kb-chip cutlab-lock-badge--commander"
                                              data-cutlab-card-open="@member.Name"
                                              data-cut-lab-chip-card="@member.Name">@member.Name</span>
                                    }
                                    else
                                    {
                                        var chipClasses = $"kb-chip cutlab-role-chip{(member.IsLocked ? " cutlab-role-chip--locked" : string.Empty)}";
                                        <button type="button"
                                                class="@chipClasses"
                                                data-cutlab-card-open="@member.Name"
                                                data-cut-lab-chip-card="@member.Name"
                                                aria-pressed="@(member.IsLocked ? "true" : "false")">@member.Name</button>
                                    }
                                }
                            </div>
                        </div>
                    </details>
                }
            </details>
        </section>

        <section class="result-panel">
            <details class="cutlab-collapsible" data-cutlab-mobile-collapse id="cut-lab-section-by-subtype">
                <summary class="cutlab-collapsible__summary">By subtype</summary>
                <div class="panel-heading">
                    <div>
                        <h2>By subtype</h2>
                        <p>Search a subtype or supertype — e.g. Ally, Lesson, Legendary — to see how many you have.</p>
                    </div>
                </div>
                <div class="cutlab-subtype-search">
                    <label for="cut-lab-subtype-search">Subtype or supertype</label>
                    <input id="cut-lab-subtype-search"
                           type="text"
                           data-cut-lab-subtype-search
                           placeholder="Search type line…" />
                </div>
                <div class="cutlab-subtype-results" data-cut-lab-subtype-results></div>
            </details>
        </section>

        <section class="result-panel" data-cut-lab-structural-findings>
            <details class="cutlab-collapsible" data-cutlab-mobile-collapse id="cut-lab-section-structural">
                <summary class="cutlab-collapsible__summary">Structural findings</summary>
                <div class="panel-heading">
                    <div>
                        <h2>Structural findings</h2>
                        <p>Measured observations about your pool's shape. Nothing here says a card is bad — it says what the numbers show.</p>
                    </div>
                        <div class="panel-heading__actions" data-cut-lab-findings-count-slot>
                            <span class="prompt-size-note cutlab-findings-count@(totalStructuralFindings > 0 ? string.Empty : " hidden")">@(totalStructuralFindings > 0 ? $"{totalStructuralFindings} structural findings" : string.Empty)</span>
                        </div>
                </div>

            <div data-cut-lab-structural-findings-body>
                @if (totalStructuralFindings > 0)
                {
                    @foreach (var findingGroup in Model.FindingGroups)
                    {
                        <div class="cutlab-finding">
                            <p class="cutlab-finding__heading">@findingGroup.Heading</p>
                            @if (findingGroup.Kind == CutLabFindingKind.EnablerStarved)
                            {
                                <p class="manabase-help">A card here is only missing a partner for THIS combo line — it may still be fully live in another combo, and can also appear under Combo-protected.</p>
                            }
                            @if (findingGroup.Kind == CutLabFindingKind.FunctionalTwins)
                            {
                                <p class="manabase-help">Slot Congestion means these cards share the same role, card type, and exact mana value. Treat them as review candidates, not automatic cuts — a card here may also be combo-protected.</p>
                            }
                            @foreach (var finding in findingGroup.Items)
                            {
                                <div class="cutlab-finding__item">
                                    <p class="cutlab-finding__lead">@finding.Lead</p>
                                    @if (finding.Roles.Count > 0)
                                    {
                                        <p class="cutlab-finding__roles">Role: @string.Join(", ", finding.Roles)</p>
                                    }
                                    @if (finding.Evidence.Count > 0)
                                    {
                                        <div class="kb-chip-area__chips">
                                            @foreach (var evidence in finding.Evidence)
                                            {
                                                var evidenceCard = Model.FindLockableEvidenceCard(evidence);
                                                if (evidenceCard is null)
                                                {
                                                    <span class="kb-chip">@evidence</span>
                                                }
                                                else
                                                {
                                                    var chipClasses = $"kb-chip cutlab-role-chip{(evidenceCard.IsLocked ? " cutlab-role-chip--locked" : string.Empty)}";
                                                    var hasComboBadge = Model.ComboBadgeByCardName.TryGetValue(CutLabCardNames.Normalize(evidenceCard.Name), out var comboBadge);
                                                    var comboBadgeText = hasComboBadge
                                                        ? comboBadge!.BadgeState == ComboBadgeState.CompletePiece
                                                            ? "Combo piece"
                                                            : comboBadge.Context
                                                        : null;
                                                    var comboBadgeClass = hasComboBadge
                                                        ? comboBadge!.BadgeState == ComboBadgeState.CompletePiece
                                                            ? "cutlab-combo-badge cutlab-combo-badge--complete"
                                                            : "cutlab-combo-badge cutlab-combo-badge--near"
                                                        : null;
                                                    <button type="button"
                                                            class="@chipClasses"
                                                            data-cutlab-card-open="@evidenceCard.Name"
                                                            data-cut-lab-chip-card="@evidenceCard.Name"
                                                            aria-pressed="@(evidenceCard.IsLocked ? "true" : "false")">
                                                        <span>@evidence</span>
                                                        @if (comboBadgeText is not null && comboBadgeClass is not null)
                                                        {
                                                            <span class="@comboBadgeClass">@comboBadgeText</span>
                                                        }
                                                    </button>
                                                }
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
                else
                {
                    <p>No structural issues found. Your pool's curve, themes, finishers, and role coverage all look self-supporting at the current floors.</p>
                }
            </div>

            @if (Model.ComboDataUnavailable)
            {
                <p class="cutlab-degradation-note" data-cut-lab-degradation="combo">Combo data unavailable right now — win-condition and enabler-starved reads are incomplete. Re-run the import to try again.</p>
            }

            @if (Model.CategoryDataUnavailable)
            {
                <p class="cutlab-degradation-note" data-cut-lab-degradation="category">Community category data unavailable — subtheme detection fell back to card-text heuristics only.</p>
            }
            </details>
        </section>

        <section class="result-panel">
            <details class="cutlab-collapsible" data-cutlab-mobile-collapse id="cut-lab-section-role-floors">
                <summary class="cutlab-collapsible__summary">Role floors</summary>
                <div class="panel-heading">
                    <div>
                        @{
                            var roleFloorsBracketLabel = Model.Request.Bracket switch
                            {
                                1 => "B1 Exhibition",
                                2 => "B2 Core",
                                3 => "B3 Upgraded",
                                4 => "B4 Optimized",
                                5 => "B5 cEDH",
                                _ => null
                            };
                        }
                        <h2>Role floors</h2>
                        <p>Minimum counts the finished 100 should keep, derived from your bracket and play experience. Adjust any floor — later cut suggestions will warn you before breaking one, never silently.</p>
                        <p class="cutlab-role-floors-context">Defaults shown for <strong>@Model.Request.SelectedCommander</strong> — Bracket @Model.Request.Bracket (@roleFloorsBracketLabel) · @Model.Request.PlayExperience play.</p>
                        @if (Model.FloorFeasibility is not null)
                        {
                            <div class="warning-banner" role="status" data-cut-lab-floor-feasibility>
                                <p>@CutLabViewModel.BuildFloorFeasibilityMessage(Model.FloorFeasibility)</p>
                            </div>
                        }
                    </div>
                </div>
            <div class="history-timeline__wrap">
                <table class="conflicts-table"
                       data-prompt-cedh-reference-table
                       data-cut-lab-role-floors-table
                       @if (Model.CommanderFloorsEnabled)
                       {
                           @:data-cut-lab-commander-floors="true"
                       }
                       role="table">
                    <thead>
                        <tr>
                            <th scope="col">Role</th>
                            <th scope="col">In pool</th>
                            @if (Model.CommanderFloorsEnabled)
                            {
                                <th scope="col">Bracket</th>
                                <th scope="col">Commander</th>
                            }
                            <th scope="col">Floor</th>
                            <th scope="col">Source</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.FloorRows)
                        {
                            <tr data-cut-lab-floor-row="@row.RoleKey"
                                data-cut-lab-floor-count="@row.InPoolCount"
                                @* Reset restores the effective max because DefaultValue is the commander-aware default. *@
                                data-cut-lab-floor-default="@row.DefaultValue"
                                data-cut-lab-floor-user-set="@(row.IsUserSet ? "true" : "false")">
                                <td data-label="Role">
                                    <strong>@row.DisplayLabel</strong>
                                </td>
                                <td data-label="In pool">
                                    <span data-cut-lab-floor-count-label>@row.InPoolCount in pool</span>
                                    <span class="cutlab-floor-state--at @(row.AtFloor ? string.Empty : "hidden")" data-cut-lab-floor-at-marker>· at floor</span>
                                </td>
                                @if (Model.CommanderFloorsEnabled)
                                {
                                    <td data-label="Bracket">@row.BracketValue</td>
                                    <td data-label="Commander">@row.CommanderDisplay</td>
                                }
                                <td data-label="Floor">
                                    <input type="number"
                                           min="0"
                                           max="@Model.CardCount"
                                           step="1"
                                           data-cut-lab-floor="@row.RoleKey"
                                           value="@row.Floor" />
                                </td>
                                <td data-label="Source">
                                    <span class="cutlab-floor-source-default @(row.IsUserSet ? "hidden" : string.Empty)" data-cut-lab-floor-source-default title="@row.SourceDetail">@row.SourceLabel</span>
                                    <span class="kb-chip cutlab-floor-badge--adjusted @(row.IsUserSet ? string.Empty : "hidden")" data-cut-lab-floor-adjusted-badge>Adjusted</span>
                                    @if (row.PlanDelta > 0)
                                    {
                                        <span class="kb-chip cutlab-floor-badge--plan-delta" data-cut-lab-floor-plan-delta-badge>+@row.PlanDelta from plan</span>
                                    }
                                    <button type="button"
                                            class="cutlab-floor-reset @(row.IsUserSet ? string.Empty : "hidden")"
                                            data-cut-lab-floor-reset="@row.RoleKey"
                                            data-cut-lab-floor-default="@row.DefaultValue">Reset to default</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="toolbar">
                <button type="button" class="run-button" data-cut-lab-recalculate>Recalculate analysis</button>
            </div>
            </details>
        </section>
        </section>

        <section class="result-panel" role="tabpanel" id="cut-lab-step-panel-2" aria-labelledby="cut-lab-step-tab-2">
            <details class="cutlab-collapsible" data-cutlab-mobile-collapse open id="cut-lab-section-cut-rounds">
                <summary class="cutlab-collapsible__summary">Cut rounds</summary>
                <div class="panel-heading">
                    <div>
                        <h2>Cut rounds</h2>
                        <p>Work through proposed cuts in order. Every proposal shows what actually changes — nothing here says a card is bad.</p>
                        <p>Cut Lab picks each card for you. Accept cut removes it and proposes the next; Reject keeps it; Defer revisits it later.</p>
                    </div>
                    <div class="panel-heading__actions">
                        <form method="post" action="@Url.Content("~/cut-lab/restart-rounds")" data-cut-lab-restart-rounds-form data-cut-lab-restart-rounds-api="@Url.Content("~/api/cut-lab/restart-rounds")">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="CutLabStateJson" value="@Model.CutLabStateJson" />
                            <button type="submit" class="clear-cache-button" data-cut-lab-restart-rounds>Re-run rounds 1 &amp; 2 — your accepted cuts are kept</button>
                        </form>
                    </div>
                </div>

            @{
                const int stickyBarTargetDeckSize = 100;
            }
            
            <div class="cutlab-progress cutlab-sticky-bar" data-cut-lab-sticky-target="@stickyBarTargetDeckSize">
                <span class="cutlab-progress__headline">@Model.BaselineCount → @stickyBarTargetDeckSize cards</span>
                <span data-cut-lab-sticky-current>@Model.StickyBar.CurrentCount/@stickyBarTargetDeckSize cards</span>
                <span class="cutlab-progress__bar" role="progressbar" aria-label="Cards remaining in pool" aria-valuemin="0" aria-valuemax="@stickyBarTargetDeckSize" aria-valuenow="@Model.StickyBar.CurrentCount">
                    <span class="cutlab-progress__fill" data-cut-lab-progress-fill style="width: @Math.Clamp((Model.StickyBar.CurrentCount * 100) / stickyBarTargetDeckSize, 0, 100)%"></span>
                </span>
                @if (Model.StickyBar.HasStickyBar)
                {
                    <span class="cutlab-progress__round" data-cut-lab-sticky-round>@Model.StickyBar.RoundLabel</span>
                    <span data-cut-lab-sticky-remaining aria-live="polite" aria-atomic="true">@Model.StickyBar.CardsRemainingToCut to cut</span>
                    <span data-cut-lab-sticky-accepted>@CutLabViewModel.FormatCutsAcceptedSoFar(Model.StickyBar.CutsAcceptedCount)</span>
                }
                <span data-cut-lab-sticky-locked>@Model.StickyBar.LockedCount locked</span>
            </div>
            @if (Model.CurrentActualLands is int actualLands && Model.CurrentTargetLands is double targetLands)
            {
                var roundedTargetLands = Math.Round(targetLands);
                var landPercent = targetLands <= 0 ? 0 : (int)Math.Round((actualLands / targetLands) * 100, MidpointRounding.AwayFromZero);
                <details class="cutlab-collapsible" data-cut-lab-lands-disclosure id="cut-lab-section-lands-now">
                    <summary class="cutlab-collapsible__summary">Lands right now</summary>
                    <p data-cut-lab-lands-text>Lands: @actualLands/@roundedTargetLands (@landPercent%) as your pool stands now (@Model.CurrentCount cards).</p>
                </details>
            }

            @if (Model.Proposal.LockedOvershootAdvisory is { } advisory)
            {
                <div class="warning-banner cutlab-locked-overshoot-advisory" data-cut-lab-locked-overshoot-advisory>
                    <p>Locked cards alone already put you @advisory.CardsOverTarget cards over the 100-card target. If you need to unlock something, start with these:</p>
                    @foreach (var group in advisory.Groups)
                    {
                        <div class="cutlab-finding cutlab-proposal__floor-warning">
                            <p class="cutlab-finding__heading">@group.RoleLabel</p>
                            <p class="cutlab-finding__lead">@string.Join(", ", group.CardNames)</p>
                        </div>
                    }
                    @if (advisory.HiddenCount > 0)
                    {
                        <p class="prompt-size-note">+@advisory.HiddenCount more locked cards ranked below these.</p>
                    }
                </div>
            }

            @if (Model.Proposal.HasProposal)
            {
                <div class="cutlab-round-banner">
                    <p>@Model.Proposal.RoundBannerBody</p>
                </div>

                <div class="cutlab-proposal" data-cut-lab-card="@Model.Proposal.CardName" data-cut-lab-round="@Model.Proposal.RoundKey">
                    <div class="cutlab-proposal--pinned">
                        <div class="cutlab-proposal__pinned-row">
                            <p class="cutlab-proposal__heading">Proposed cut: <button type="button" class="cutlab-card-link" data-cutlab-card-open="@Model.Proposal.CardName">@Model.Proposal.CardName</button></p>
                            <p class="cutlab-proposal__glance">@Model.Proposal.GlanceLine</p>
                        </div>
                        <div class="cutlab-proposal__pinned-actions">
                            @{ await RenderDecisionForm(Model.Proposal.CardName, Model.Proposal.RoundKey, "accept", "Accept cut", "accept", $"Accept cut for {Model.Proposal.CardName}"); }
                            @{ await RenderDecisionForm(Model.Proposal.CardName, Model.Proposal.RoundKey, "reject", "Reject cut", "reject", $"Reject cut for {Model.Proposal.CardName}"); }
                            @{ await RenderDecisionForm(Model.Proposal.CardName, Model.Proposal.RoundKey, "defer", "Defer decision", "defer", $"Defer cut for {Model.Proposal.CardName}"); }
                        </div>
                    </div>
                    <div class="cutlab-proposal__body">
                        <div class="cutlab-proposal__evidence">
                            <p>@Model.Proposal.FindingSummary</p>
                            @if (Model.Proposal.FindingChips.Count > 0)
                            {
                                <div class="kb-chip-area__chips">
                                    @foreach (var chip in Model.Proposal.FindingChips)
                                    {
                                        <span class="kb-chip">@chip</span>
                                    }
                                </div>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.Proposal.DeltaUnavailableMessage))
                        {
                            <div class="cutlab-finding cutlab-proposal__floor-warning">
                                <p class="cutlab-finding__lead">@Model.Proposal.DeltaUnavailableMessage</p>
                            </div>
                        }
                        else
                        {
                            <div class="cutlab-delta">
                                <p>@Model.Proposal.ChangedFamilyCount of 7 deck numbers moved.</p>
                                @{ await RenderDeltaLines(Model.Proposal.ChangedDeltaLines); }
                            </div>

                            <details data-cut-lab-delta-expander>
                                <summary>Show full metric breakdown</summary>
                                <div class="cutlab-delta">
                                    @{ await RenderDeltaLines(Model.Proposal.FullDeltaLines); }
                                </div>
                            </details>
                        }

                        @if (Model.Proposal.FloorWarnings.Count > 0)
                        {
                            @foreach (var warning in Model.Proposal.FloorWarnings)
                            {
                                <div class="cutlab-finding cutlab-proposal__floor-warning">
                                    <p class="cutlab-finding__lead">@warning</p>
                                </div>
                            }
                        }

                    </div>
                </div>
            }
            else if (currentCount < 100)
            {
                <div class="cutlab-proposal">
                    <p class="cutlab-proposal__heading">You're under 100 cards</p>
                    <p>Add copies or a basic land in the Tune quantities section below to reach exactly 100.</p>
                </div>
            }
            else if (Model.Proposal.IsAtTarget)
            {
                <div class="cutlab-proposal">
                    <p class="cutlab-proposal__heading">You're at 100 cards</p>
                    <p>Review the cuts you made below, or reopen a card from the Cuts made list if you want to reconsider.</p>
                </div>
            }
            else if (Model.Proposal.IsNothingToCut)
            {
                <div class="cutlab-proposal">
                    <p class="cutlab-proposal__heading">Nothing to cut</p>
                    <p>Every remaining card is either locked or your working list is already at 100 cards. Review your locks and packages above, or adjust a role floor if you want to reconsider.</p>
                </div>
            }

            <section class="result-panel nested-panel cutlab-tuner">
                <details class="cutlab-collapsible" data-cutlab-mobile-collapse id="cut-lab-section-tune">
                    <summary class="cutlab-collapsible__summary">Tune quantities</summary>
                    <div class="panel-heading">
                        <div>
                            <h2>Tune quantities</h2>
                            <p>Cut or add copies of basics and other legal-multiple cards one at a time, or add a new basic land, to land on exactly 100.</p>
                        </div>
                    </div>
                <div class="history-timeline__wrap">
                    <table class="conflicts-table" data-prompt-cedh-reference-table role="table">
                        <thead>
                            <tr>
                                <th scope="col">Card</th>
                                <th scope="col">Role</th>
                                <th scope="col">Quantity</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in Model.WorkingListRows)
                            {
                                if (!row.IsLegalMultiple)
                                {
                                    continue;
                                }

                                var removeDisabled = row.CurrentQuantity == 0 || row.IsLocked;
                                var addDisabled = row.CurrentQuantity >= row.LegalMax || row.IsLocked;
                                var adjustAriaLabel = row.IsLocked
                                    ? $"{row.Name} is locked - unlock it to adjust quantity"
                                    : null;

                                <tr data-cut-lab-tuner-row="@row.Name"
                                    data-cut-lab-quantity="@row.CurrentQuantity"
                                    data-cut-lab-legal-max="@row.LegalMax">
                                    <td data-label="Card">
                                        <strong>@row.Name</strong>
                                        @if (row.IsAddedBasic)
                                        {
                                            <span class="kb-chip cutlab-tuner-badge--added">Added</span>
                                        }
                                    </td>
                                    <td data-label="Role">@row.RoleLabel</td>
                                    <td data-label="Quantity">
                                        <div class="cutlab-stepper">
                                            @{ await RenderAdjustForm(row.Name, -1, false, "−", "cutlab-stepper-btn", adjustAriaLabel ?? $"Remove one {row.Name}", removeDisabled, adjustAriaLabel); }
                                            <span class="cutlab-stepper__count tabular" data-cut-lab-quantity-value>@row.CurrentQuantity</span>
                                            @{ await RenderAdjustForm(row.Name, 1, false, "+", "cutlab-stepper-btn", adjustAriaLabel ?? $"Add one {row.Name}", addDisabled, adjustAriaLabel); }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (Model.AddableBasics.Count > 0)
                {
                    <form method="post" action="@Url.Content("~/cut-lab/adjust")" data-cut-lab-adjust-form class="toolbar cutlab-tuner__add-basic">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="CutLabStateJson" value="@Model.CutLabStateJson" />
                        <input type="hidden" name="Delta" value="1" />
                        <input type="hidden" name="IsAddedBasic" value="true" />
                        <label for="cut-lab-add-basic-select">Add a basic land</label>
                        <select id="cut-lab-add-basic-select" name="CardName" data-df-select data-cut-lab-add-basic-select required>
                            <option value="" selected disabled>Choose a basic…</option>
                            @foreach (var basic in Model.AddableBasics)
                            {
                                <option value="@basic">@basic</option>
                            }
                        </select>
                        <button type="submit" class="run-button" data-cut-lab-adjust data-cut-lab-add-basic data-cut-lab-delta="1" data-cut-lab-added-basic="true">Add basic land</button>
                    </form>
                }
                else
                {
                    <p class="cutlab-floor-source-default">All basic land types are already in your working list. Use the steppers above to add more copies.</p>
                }
                </details>
            </section>
            </details>

        @if (Model.CutsMade.Count > 0)
        {
            <section class="result-panel">
                <details class="cutlab-collapsible" data-cutlab-mobile-collapse id="cut-lab-section-cuts-made">
                    <summary class="cutlab-collapsible__summary">Cuts made</summary>
                    <div class="panel-heading">
                        <div>
                            <h2>Cuts made</h2>
                            <p>Every accepted cut, restorable any time — order doesn't matter.</p>
                        </div>
                    </div>
                    <details class="cutlab-cuts-made" open="@(Model.CutsMade.Count <= 5 ? "open" : null)">
                        <summary>Cuts made · @CutLabViewModel.FormatCutsMadeCount(Model.CutsMade.Count)</summary>
                        @foreach (var row in Model.CutsMade)
                        {
                            <div class="cutlab-cuts-made__row">
                                <button type="button" class="cutlab-card-link" data-cutlab-card-open="@row.CardName" data-cutlab-card-view-only="true">@row.CardName</button>
                                <span class="prompt-size-note">cut in @row.RoundLabel</span>
                                @{ await RenderDecisionForm(row.CardName, row.RoundKey, "restore", "Restore", string.Empty, $"Restore {row.CardName}"); }
                            </div>
                        }
                    </details>
                </details>
            </section>
        }
        </section>

        <section class="result-panel" role="tabpanel" id="cut-lab-step-panel-3" aria-labelledby="cut-lab-step-tab-3">
            <details class="cutlab-collapsible" data-cutlab-mobile-collapse open id="cut-lab-section-plan-panel">
                <summary class="cutlab-collapsible__summary">Plan profile</summary>
                <form method="post" action="@Url.Content("~/cut-lab/plan-apply")" id="cut-lab-plan-form" data-cut-lab-plan-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CutLabStateJson" value="@Model.CutLabStateJson" />
                <div class="panel-heading">
                    <div>
                        <!-- Why: this duplication recurs across the file; a coordinated fix for all sections is separate, out-of-scope work. -->
                        <h2 aria-hidden="true">Plan profile</h2>
                        <p>Check what this deck actually does. Every box changes how Cut Lab protects, reorders, and flags cards in your working list — nothing here is cosmetic.</p>
                    </div>
                </div>
                <div class="cut-lab-plan-panel" data-cut-lab-plan-panel>
                    <p class="cut-lab-plan-panel__zero-notice @(Model.PlanPanel.ZeroSelectionNotice ? "" : "hidden")" role="status" data-cut-lab-plan-zero-notice>With nothing checked, the cut engine behaves exactly as it does today.</p>
                    <fieldset class="cut-lab-plan-panel__strategies">
                        <legend>Generic strategies</legend>
                        @foreach (var row in Model.PlanPanel.StrategyRows)
                        {
                            <label class="cut-lab-plan-panel__row">
                                <input type="checkbox" name="PlanStrategies" value="@row.Slug" checked="@(row.IsChecked ? "checked" : null)" data-cut-lab-plan-checkbox />
                                <span class="cut-lab-plan-panel__row-body">
                                    <span class="cut-lab-plan-panel__row-name">@row.DisplayName</span>
                                    <span class="cut-lab-plan-panel__row-definition">@row.Definition</span>
                                    <span class="cut-lab-plan-panel__row-consequence">@row.Consequence</span>
                                </span>
                            </label>
                        }
                    </fieldset>
                    <fieldset class="cut-lab-plan-panel__themes">
                        <legend>Commander themes</legend>
                        @if (Model.PlanPanel.CommanderThemesUnavailable)
                        {
                            <p class="cut-lab-plan-panel__themes-unavailable">Commander themes couldn't be loaded from EDHREC right now. The generic strategies above still apply.</p>
                        }
                        else
                        {
                            @foreach (var theme in Model.PlanPanel.ThemeRows)
                            {
                                <label class="cut-lab-plan-panel__row">
                                    <input type="checkbox" name="PlanThemes" value="@theme.Slug" checked="@(theme.IsChecked ? "checked" : null)" data-cut-lab-plan-checkbox />
                                    <span class="cut-lab-plan-panel__row-body">
                                        <span class="cut-lab-plan-panel__row-name">@theme.DisplayName</span>
                                        <span class="cut-lab-plan-panel__row-definition">@theme.DeckCount decks (@theme.SharePercent.ToString("0.#")%) on EDHREC</span>
                                    </span>
                                </label>
                            }
                        }
                    </fieldset>
                </div>
                    <button type="submit" class="run-button" data-cut-lab-plan-apply-submit>Apply plan</button>
                </form>
            </details>
        </section>

        <section class="result-panel" role="tabpanel" id="cut-lab-step-panel-4" aria-labelledby="cut-lab-step-tab-4">
            <details class="cutlab-collapsible" data-cutlab-mobile-collapse id="cut-lab-section-goals">
                <summary class="cutlab-collapsible__summary">Goals</summary>
                <div class="panel-heading">
                    <div>
                        <h2>Goals</h2>
                        <p>Set the turn targets you care about, then compare your current working list to the original pool baseline. Goal results refresh when you press Recalculate goals; they do not update automatically after each cut. In casual play, the representative line stays visible as an informational goal.</p>
                    </div>
                </div>
                <form method="post" action="@Url.Content("~/cut-lab/goals")" data-cut-lab-goals-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CutLabStateJson" value="@Model.CutLabStateJson" />
                    <div class="history-timeline__wrap">
                        <table class="conflicts-table" data-prompt-cedh-reference-table role="table">
                            <thead>
                                <tr>
                                    <th scope="col">Goal</th>
                                    <th scope="col">Turn target</th>
                                    <th scope="col">Current (as of your last recalculation)</th>
                                    <th scope="col">Baseline trend</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.GoalRows)
                                {
                                    <tr class="cutlab-goal-row">
                                        <td data-label="Goal">
                                            <strong>@row.Label</strong>
                                            @if (row.IsUncappedInCasual)
                                            {
                                                <div class="cutlab-floor-source-default">Casual games are uncapped — this goal is informational only.</div>
                                            }
                                        </td>
                                        <td data-label="Turn target">
                                            <input type="number"
                                                   min="1"
                                                   max="15"
                                                   step="1"
                                                   name="@row.FieldName"
                                                   data-cut-lab-goal="@row.GoalKey"
                                                   value="@row.TurnValue" />
                                        </td>
                                        <td data-label="Current">
                                            <span class="tabular">@row.CurrentProbability</span>
                                        </td>
                                        <td data-label="Baseline trend" class="cutlab-goal-row__trend">
                                            <span class="prompt-size-note">vs @row.BaselineProbability baseline</span>
                                            @{ await RenderDeltaValue(row.Direction, row.DeltaValueToken); }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="toolbar">
                        <button type="submit" class="run-button">Recalculate goals</button>
                    </div>
                </form>
            </details>

        <section class="result-panel">
            <details class="cutlab-collapsible" data-cutlab-mobile-collapse id="cut-lab-section-scenarios">
                <summary class="cutlab-collapsible__summary">Scenarios</summary>
                <p>Save this entire Cut Lab session in this browser, then reload it later to compare different goal, lock, and cut setups.</p>
                <noscript>
                    <p class="cutlab-degradation-note">Named scenarios require JavaScript.</p>
                </noscript>
                <div class="cutlab-scenarios">
                    <div class="cutlab-scenarios__save-row">
                        <label class="sr-only" for="cut-lab-scenario-name">Scenario name</label>
                        <input id="cut-lab-scenario-name"
                               type="text"
                               placeholder="e.g. Greedy keep line"
                               data-cut-lab-scenario-name />
                        <button type="button" class="run-button" data-cut-lab-scenario-save>Save scenario</button>
                    </div>
                    <div class="cutlab-scenarios__portable-row">
                        <p class="prompt-size-note cutlab-scenarios__portable-help">Download this session as a file, or load a session file to resume it on another device.</p>
                        <div class="cutlab-scenarios__portable-actions">
                            <button type="button" class="run-button" data-cut-lab-session-download>Download session</button>
                            <label class="copy-button cutlab-scenarios__file-label" for="cut-lab-session-file">Load session file</label>
                            <input id="cut-lab-session-file"
                                   class="cutlab-scenarios__file-input"
                                   type="file"
                                   accept=".json,application/json"
                                   data-cut-lab-session-file />
                        </div>
                    </div>
                    <p class="prompt-size-note cutlab-scenarios__status" role="status" data-cut-lab-scenario-status></p>
                    <div class="cutlab-scenarios__list" data-cut-lab-scenario-list></div>
                </div>
            </details>
        </section>

        <section class="result-panel">
            <details class="cutlab-collapsible" data-cutlab-mobile-collapse id="cut-lab-section-whatif">
                <summary class="cutlab-collapsible__summary">What-if swap</summary>
                <p>Swap one unlocked working-list card for one card from your cut pile, preview the metric deltas, then keep or discard the change.</p>
                <form method="post" action="@Url.Content("~/cut-lab/whatif")" data-cut-lab-whatif-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="CutLabStateJson" value="@Model.CutLabStateJson" />
                    <div class="cutlab-whatif">
                        <div class="field">
                            <label for="cut-lab-whatif-card-out">Working-list card to cut</label>
                            <select id="cut-lab-whatif-card-out" name="cardOut" data-df-select data-cut-lab-whatif-card-out>
                                <option value="">Choose a card</option>
                                @foreach (var cardName in Model.WhatifCardOutOptions)
                                {
                                    <option value="@cardName" selected="@(string.Equals(Model.Whatif.CardOut, cardName, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                        @cardName
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="field">
                            <label for="cut-lab-whatif-card-in">Cut-pile card to restore</label>
                            <select id="cut-lab-whatif-card-in" name="cardIn" data-df-select data-cut-lab-whatif-card-in>
                                <option value="">Choose a card</option>
                                @foreach (var cardName in Model.WhatifCardInOptions)
                                {
                                    <option value="@cardName" selected="@(string.Equals(Model.Whatif.CardIn, cardName, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                                        @cardName
                                    </option>
                                }
                            </select>
                        </div>
                    </div>
                    @if (Model.Whatif.HasPreview)
                    {
                        <div class="cutlab-whatif__preview" data-cut-lab-whatif-preview>
                            <p class="cutlab-whatif__selection" data-cut-lab-whatif-selection>Previewing: cut <strong>@Model.Whatif.CardOut</strong>, restore <strong>@Model.Whatif.CardIn</strong>.</p>
                            <div class="history-timeline__wrap">
                                <table class="conflicts-table" data-prompt-cedh-reference-table role="table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Metric</th>
                                            <th scope="col">Before</th>
                                            <th scope="col">After</th>
                                            <th scope="col">Delta</th>
                                        </tr>
                                    </thead>
                                    <tbody data-cut-lab-whatif-delta-body>
                                        @foreach (var row in Model.Whatif.DeltaRows)
                                        {
                                            <tr>
                                                <td data-label="Metric">
                                                    <strong>@row.MetricLabel</strong>
                                                </td>
                                                <td data-label="Before">@row.BaselineValue</td>
                                                <td data-label="After">@row.CurrentValue</td>
                                                <td data-label="Delta">
                                                    @{ await RenderDeltaValue(row.Direction, row.DeltaValueToken); }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="cutlab-whatif__preview hidden" data-cut-lab-whatif-preview>
                            <p class="cutlab-whatif__selection hidden" data-cut-lab-whatif-selection></p>
                            <div class="history-timeline__wrap">
                                <table class="conflicts-table" data-prompt-cedh-reference-table role="table">
                                    <thead>
                                        <tr>
                                            <th scope="col">Metric</th>
                                            <th scope="col">Before</th>
                                            <th scope="col">After</th>
                                            <th scope="col">Delta</th>
                                        </tr>
                                    </thead>
                                    <tbody data-cut-lab-whatif-delta-body></tbody>
                                </table>
                            </div>
                        </div>
                    }
                    <div class="toolbar cutlab-whatif__actions">
                        <button type="submit" class="run-button" name="intent" value="preview" data-cut-lab-whatif-preview-submit>Preview swap</button>
                        <button type="submit" class="run-button" name="intent" value="keep" data-cut-lab-whatif-keep-submit>Keep swap</button>
                        <button type="button" class="clear-cache-button @(Model.Whatif.HasPreview ? string.Empty : "hidden")" data-cut-lab-whatif-discard>Discard preview</button>
                    </div>
                </form>
            </details>
        </section>

        @if (Model.CompareRows.Count > 0)
        {
            <section class="result-panel">
                <div class="panel-heading">
                    <div>
                        <h2>Compare to baseline</h2>
                        <p>Your original pool vs. your current working list, side by side. The Current column reflects your last recalculation, so after making cuts click Recalculate analysis to refresh it.</p>
                    </div>
                </div>
                <details class="cutlab-compare">
                    <summary>Compare to baseline</summary>
                    <p>@Model.BaselineCount cards → @Model.CurrentCount cards</p>
                    <div class="history-timeline__wrap">
                        <table class="conflicts-table" data-prompt-cedh-reference-table role="table">
                            <thead>
                                <tr>
                                    <th scope="col">Metric</th>
                                    <th scope="col">Baseline</th>
                                    <th scope="col">Current (as of your last recalculation)</th>
                                    <th scope="col">Delta</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in Model.CompareRows)
                                {
                                    <tr>
                                        <td data-label="Metric">
                                            <strong>@row.MetricLabel</strong>
                                        </td>
                                        <td data-label="Baseline">@row.BaselineValue</td>
                                        <td data-label="Current">@row.CurrentValue</td>
                                        <td data-label="Delta">
                                            @{ await RenderDeltaValue(row.Direction, row.DeltaValueToken); }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </details>
            </section>
        }
        </section>
        <section class="result-panel" role="tabpanel" id="cut-lab-step-panel-5" aria-labelledby="cut-lab-step-tab-5" data-scroll-on-load="@(Model.Export.HasExport ? "true" : null)">
            <details class="cutlab-collapsible" data-cutlab-mobile-collapse id="cut-lab-section-export">
                <summary class="cutlab-collapsible__summary">Export</summary>
                <div class="panel-heading">
                    <div>
                        <h2>Export</h2>
                        <p>Rebuild the finished list in builder-ready Moxfield and Archidekt text, plus CUT/ADD patches against the original imported list.</p>
                    </div>
                </div>
                <form method="post" action="@Url.Content("~/cut-lab/export")" id="cut-lab-export-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="CutLabStateJson" value="@Model.CutLabStateJson" />

                <div class="cutlab-export">
                    <div class="cutlab-export__summary">
                        <div class="cutlab-export__status" data-cut-lab-export-count>
                            @if (currentCount == 100)
                            {
                                <strong data-cut-lab-export-count-text>✅ Card count = 100</strong>
                            }
                            else
                            {
                                <strong data-cut-lab-export-count-text>❌ Card count = @currentCount</strong>
                                <span data-cut-lab-export-count-helper>Reach 100 cards to unlock the finished-list export.</span>
                            }
                        </div>
                        <div class="cutlab-export__status">
                            @if (!Model.Export.HasExport)
                            {
                                <strong>⚠ Color-identity verification pending</strong>
                                <span>Run export to verify the finished list against your commander identity.</span>
                            }
                            else if (Model.Export.IllegalColorIdentity.Count == 0)
                            {
                                <strong>✅ Color-identity legal</strong>
                            }
                            else
                            {
                                <strong>⚠ Color-identity illegal</strong>
                                <span>@string.Join(", ", Model.Export.IllegalColorIdentity)</span>
                            }
                        </div>
                        <div class="cutlab-export__status">
                            @if (Model.Export.HasExport && Model.Export.UnverifiedColorIdentity.Count > 0)
                            {
                                <strong>⚠ Could not verify</strong>
                                <span>@string.Join(", ", Model.Export.UnverifiedColorIdentity)</span>
                            }
                            else if (Model.Export.HasExport)
                            {
                                <strong>✅ Color-identity fully verified</strong>
                            }
                            else
                            {
                                <strong>⚠ Could not verify</strong>
                                <span>Run export to verify any unresolved cards separately from illegal ones.</span>
                            }
                        </div>
                        <div class="cutlab-export__status">
                            @if (!Model.Export.HasExport)
                            {
                                <strong>⚠ Banlist verification pending</strong>
                                <span>Run export to re-check the final 100-card list.</span>
                            }
                            else if (Model.Export.BanlistOffenders.Count == 0)
                            {
                                <strong>✅ Banlist clean</strong>
                            }
                            else
                            {
                                <strong>⚠ Banlist warning</strong>
                                <span>@string.Join(", ", Model.Export.BanlistOffenders)</span>
                            }
                        </div>

                        @if (Model.Export.ReconstructionWarnings.Count > 0)
                        {
                            <div class="cutlab-export__warning">
                                <strong>⚠ Reconstruction warnings</strong>
                                <ul>
                                    @foreach (var warning in Model.Export.ReconstructionWarnings)
                                    {
                                        <li>@warning</li>
                                    }
                                </ul>
                            </div>
                        }

                        @if (Model.Export.Warnings.Count > 0)
                        {
                            <div class="cutlab-export__warning">
                                <strong>⚠ Export warnings</strong>
                                <ul>
                                    @foreach (var warning in Model.Export.Warnings)
                                    {
                                        <li>@warning</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>

                    @if (Model.Export.HardBlock || currentCount != 100)
                    {
                        <p class="cutlab-export__hint">Reach exactly 100 cards before copying the finished-list export. Patch blocks stay available so you can inspect the current diff.</p>
                    }

                    <div class="cutlab-export__copy-grid">
                        @if (!Model.Export.HardBlock && Model.Export.HasExport)
                        {
                            <div class="cutlab-export__block">
                                <div class="panel-heading">
                                    <div>
                                        <h3>Moxfield finished list</h3>
                                        <p>Paste straight into the builder.</p>
                                    </div>
                                    <button type="button" class="copy-button" data-copy-target="cut-lab-export-moxfield-full">Copy</button>
                                </div>
                                <textarea id="cut-lab-export-moxfield-full" class="cutlab-export__textarea" rows="12" readonly>@Model.Export.MoxfieldFullListText</textarea>
                            </div>
                            <div class="cutlab-export__block">
                                <div class="panel-heading">
                                    <div>
                                        <h3>Archidekt finished list</h3>
                                        <p>Paste straight into the builder.</p>
                                    </div>
                                    <button type="button" class="copy-button" data-copy-target="cut-lab-export-archidekt-full">Copy</button>
                                </div>
                                <textarea id="cut-lab-export-archidekt-full" class="cutlab-export__textarea" rows="12" readonly>@Model.Export.ArchidektFullListText</textarea>
                            </div>
                        }
                        <div class="cutlab-export__block">
                            <div class="panel-heading">
                                <div>
                                    <h3>Moxfield CUT/ADD patch</h3>
                                    <p>Diff against the original imported list.</p>
                                </div>
                                <button type="button" class="copy-button" data-copy-target="cut-lab-export-moxfield-patch" @(Model.Export.HasExport ? null : "disabled")>Copy</button>
                            </div>
                            <textarea id="cut-lab-export-moxfield-patch" class="cutlab-export__textarea" rows="12" readonly>@Model.Export.MoxfieldPatchText</textarea>
                        </div>
                        <div class="cutlab-export__block">
                            <div class="panel-heading">
                                <div>
                                    <h3>Archidekt CUT/ADD patch</h3>
                                    <p>Diff against the original imported list.</p>
                                </div>
                                <button type="button" class="copy-button" data-copy-target="cut-lab-export-archidekt-patch" @(Model.Export.HasExport ? null : "disabled")>Copy</button>
                            </div>
                            <textarea id="cut-lab-export-archidekt-patch" class="cutlab-export__textarea" rows="12" readonly>@Model.Export.ArchidektPatchText</textarea>
                        </div>
                    </div>

                    <div class="toolbar cutlab-export__actions">
                        <button type="submit" class="run-button" @(currentCount == 100 ? null : "disabled")>Build export</button>
                    </div>
                </div>
                </form>
            </details>
        </section>

        <dialog id="cutlab-card-modal" class="cutlab-card-modal" aria-labelledby="cutlab-card-modal-title">
            <div class="cutlab-card-modal__panel">
                <h2 id="cutlab-card-modal-title" class="cutlab-card-modal__title"></h2>
                <div class="cutlab-card-modal__body">
                    <p class="cutlab-card-modal__meta" data-cutlab-modal-meta hidden></p>
                    <p class="cutlab-card-modal__meta" data-cutlab-modal-castability hidden title="Based on your current working pool, not a finished 100-card verdict."></p>
                    <p class="cutlab-card-modal__oracle" data-cutlab-modal-oracle></p>
                    <p class="cutlab-card-modal__combo" data-cutlab-modal-combo hidden></p>
                </div>
                <div class="cutlab-card-modal__actions">
                    <button type="button" class="cutlab-card-modal__button cutlab-card-modal__button--lock" data-cutlab-modal-lock>Lock</button>
                    <button type="button" class="cutlab-card-modal__button cutlab-card-modal__button--close" data-cutlab-modal-close>Close</button>
                </div>
            </div>
        </dialog>
    </section>
}
else if (string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <section class="result-panel">
        <h2>No pool imported yet</h2>
        <p>Paste a Moxfield or Archidekt URL, or paste your decklist text, then choose Import pool. Cut Lab is for an oversized pool — 101 to 150 cards plus your commander.</p>
    </section>
}
</div>

@section Scripts {
    <script src="~/js/deck-input-store.js" asp-append-version="true"></script>
    <script src="~/js/busy-indicator.js" asp-append-version="true"></script>
    <script src="~/js/moxfield-extension-bridge.js" asp-append-version="true"></script>
    <script src="~/js/deck-sync.js" asp-append-version="true"></script>
    <script src="~/js/cut-lab.js" asp-append-version="true"></script>
}
