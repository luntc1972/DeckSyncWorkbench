@using DeckFlow.Core.Manabase
@using DeckFlow.Web.Models
@model DeckFlow.Web.Models.ManabaseViewModel
@inject DeckFlow.Web.Services.FeatureFlags.IFeatureFlagCache FlagCache
@{
    ViewData["Title"] = "MTG Commander Mana Base Analyzer";
    ViewData["Description"] = "Analyze your Commander mana base for color consistency and castability using Karsten-based math. Get a plain-language verdict and fixes.";
    var isUrl = Model.Request.DeckInputSource == DeckFlow.Web.Models.DeckInputSource.PublicUrl;
    var report = Model.Report;
    var mode = Model.Request.Mode;
    var importance = Model.Request.CommanderImportance;
    var showPlainLanguage = Model.ShowPlainLanguage;
}

<section class="hero">
    <h1>Mana Base Analysis</h1>
    <p class="lede">Check whether a Commander deck has enough lands and the right colored sources for its curve — the verdict is computed directly, no AI needed.</p>
    <details class="hero-detail">
        <summary>How it works</summary>
        <p>Built on Frank Karsten's source-count math, then extended — it weights non-land sources (mana rocks, dorks), counts modal double-faced land-backs as real lands, accounts for tapped vs. untapped lands for turn-one casts, sizes each color to its hardest spell, and estimates each spell's chance to be cast on curve.</p>
    </details>
</section>

@await Html.PartialAsync("_BusyIndicator")
@await Html.PartialAsync("_DeckToolTabs", Model.ActiveTab)

<div class="error-banner @(string.IsNullOrWhiteSpace(Model.ErrorMessage) ? "hidden" : string.Empty)" role="alert">
    @Model.ErrorMessage
</div>

@if (!string.IsNullOrWhiteSpace(Model.NoticeMessage))
{
    <p class="form-hint">@Model.NoticeMessage</p>
}

<form method="post" action="@Url.Content("~/manabase")" class="result-panel"
      data-cache-key="manabase"
      data-busy-title="Analyzing mana base"
      data-busy-message="Resolving cards and simulating castability — this can take a few seconds."
      data-busy-progress="Loading the deck|Resolving cards via Scryfall|Simulating castability|Scoring colors"
      data-busy-hold-final-step="true"
      data-busy-min-ms="500">
    @Html.AntiForgeryToken()

    <div class="field">
        <label for="manabase-input-source">Input method</label>
        <select id="manabase-input-source" name="DeckInputSource" data-df-select>
            <option value="@DeckFlow.Web.Models.DeckInputSource.PublicUrl" selected="@(isUrl ? "selected" : null)">Use public deck URL</option>
            <option value="@DeckFlow.Web.Models.DeckInputSource.PasteText" selected="@(!isUrl ? "selected" : null)">Paste text</option>
        </select>
    </div>

    <div class="field @(isUrl ? string.Empty : "hidden")" data-sync-panel="manabase-deck-url">
        <label for="manabase-deck-url">Archidekt or Moxfield deck URL</label>
        <input id="manabase-deck-url" type="url" name="DeckUrl" spellcheck="false" autocomplete="off"
               placeholder="https://moxfield.com/decks/… or https://archidekt.com/decks/…" value="@Model.Request.DeckUrl" />
        @await Html.PartialAsync("_DeckFlowBridgeHint")
    </div>

    <div class="field @(isUrl ? "hidden" : string.Empty)" data-sync-panel="manabase-deck-text">
        <label for="manabase-deck-text">Paste a decklist (one card per line, with set/collector if you have it)</label>
        <textarea id="manabase-deck-text" name="DeckText" rows="6" spellcheck="false" autocomplete="off"
                  placeholder="1 Sol Ring&#10;1 Command Tower&#10;…">@Model.Request.DeckText</textarea>
    </div>

    <div class="field">
        <label for="manabase-deck-name">Deck name (optional)</label>
        <input id="manabase-deck-name" type="text" name="DeckName" spellcheck="false" autocomplete="off"
               placeholder="e.g. Kinnan Stax" value="@Model.Request.DeckName" />
    </div>

    @if (Model.Loaded && !Model.HasResult)
    {
        <p class="manabase-loaded-hint" role="status" data-scroll-on-load>
            @if (!string.IsNullOrWhiteSpace(Model.InputSummary))
            {
                <strong>Deck loaded</strong> @:(@Model.InputSummary).
            }
            else
            {
                <strong>Deck loaded.</strong>
            }
            @if (Model.HasSuggestions)
            {
                @:Review the detected reduced / alternative costs below — edit or clear any you disagree with — then <strong>Analyze Mana Base</strong>.
            }
            else
            {
                @:No reduced / alternative costs were detected. Add any manually below if needed, then <strong>Analyze Mana Base</strong>.
            }
        </p>
    }

    @if (Model.CommanderSelectionRequired)
    {
        <div class="result-panel nested-panel" data-scroll-on-load>
            <div class="panel-heading">
                <div>
                    <h2>Pick your commander</h2>
                    <p>We couldn't identify your commander automatically. Choose it from the deck, or search to override with the exact name you want analyzed.</p>
                </div>
            </div>
            <div class="field">
                <label for="manabase-selected-commander">Commander from this deck</label>
                <select id="manabase-selected-commander" name="SelectedCommander" data-df-select autofocus>
                    <option value="">Choose a commander</option>
                    @foreach (var commanderChoice in Model.CommanderChoices)
                    {
                        <option value="@commanderChoice" selected="@(string.Equals(Model.Request.SelectedCommander, commanderChoice, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">
                            @commanderChoice
                        </option>
                    }
                </select>
            </div>
            <div class="field">
                <label for="manabase-commander-search">Commander search backstop</label>
                <input id="manabase-commander-search"
                       type="text"
                       value="@Model.Request.SelectedCommander"
                       placeholder="Start typing a commander name…"
                       autocomplete="off"
                       list="manabase-commander-suggestions"
                       data-commander-search="@Url.Content("~/manabase/commander-search")"
                       data-commander-target="#manabase-selected-commander"
                       data-commander-create-option="true" />
                <datalist id="manabase-commander-suggestions"></datalist>
                <p class="manabase-help">Pick a commander, then re-run the same analysis. Your decklist and other options stay intact.</p>
            </div>
        </div>
    }

    <details class="manabase-overrides" @(Model.HasSuggestions || !string.IsNullOrWhiteSpace(Model.Request.CostOverridesText) ? "open" : null)>
        <summary>Companion &amp; reduced costs (optional)</summary>
        <div class="field">
            <label for="manabase-companion-name">Companion name</label>
            <p class="sync-column__hint" id="manabase-companion-hint">Auto-detected from Moxfield; name it here for Archidekt or pasted lists, or to override.</p>
            <input id="manabase-companion-name" type="text" name="CompanionName" spellcheck="false" autocomplete="off"
                   placeholder="e.g. Jegantha, the Wellspring…" value="@(Model.CompanionCallout?.Name ?? Model.Request.CompanionName)" aria-describedby="manabase-companion-hint" />
        </div>
        <div class="field">
            <label for="manabase-cost-overrides">
                One per line as <code>Card Name: cost</code> — e.g. <code>Force of Will: 0</code> or
                <code>Blasphemous Act: {R}</code>. Use this for pitch/free spells, board-scaling cards
                (Blasphemous Act), and evoke/suspend, where the real cost is below the printed one.
            </label>
            @if (Model.HasSuggestions)
            {
                <p class="manabase-help">Auto-detected and pre-filled below — edit or clear any you disagree with.</p>
            }
            <textarea id="manabase-cost-overrides" name="CostOverridesText" rows="4" spellcheck="false" autocomplete="off"
                      placeholder="Force of Will: 0&#10;Blasphemous Act: {R}">@Model.OverridesBoxText</textarea>
            @* MEDIUM-11: a client script flips this to "true" on the first edit so a deliberately
               cleared box is not silently refilled with the suggestions on the next render. *@
            <input type="hidden" id="manabase-overrides-touched" name="OverridesTouched"
                   value="@(Model.Request.OverridesTouched ? "true" : "false")" />
            @if (Model.HasNotAppliedOverrides)
            {
                <p class="manabase-help manabase-overrides-notapplied" role="status">
                    <strong>@Model.NotAppliedOverrides.Count override @(Model.NotAppliedOverrides.Count == 1 ? "line" : "lines") not applied</strong>
                    (unknown card or unreadable cost): @string.Join(", ", Model.NotAppliedOverrides). Check the
                    card name matches your deck and the cost looks like <code>0</code> or <code>{R}</code>.
                </p>
            }
        </div>
    </details>

    <div class="manabase-options">
        <fieldset class="manabase-segmented" role="radiogroup">
            <legend>Deck type</legend>
            <div class="manabase-pills">
                <label class="manabase-pill @(mode == ManabaseMode.Casual ? "is-selected" : null)">
                    <input type="radio" name="Mode" value="Casual" checked="@(mode == ManabaseMode.Casual ? "checked" : null)" />
                    <span>Casual</span>
                </label>
                @if (Model.ShowFocusedTier)
                {
                    <label class="manabase-pill @(mode == ManabaseMode.Focused ? "is-selected" : null)">
                        <input type="radio" name="Mode" value="Focused" checked="@(mode == ManabaseMode.Focused ? "checked" : null)" />
                        <span>Focused</span>
                    </label>
                }
                <label class="manabase-pill @(mode == ManabaseMode.Cedh ? "is-selected" : null)">
                    <input type="radio" name="Mode" value="Cedh" checked="@(mode == ManabaseMode.Cedh ? "checked" : null)" />
                    <span>cEDH</span>
                </label>
            </div>
            <p class="manabase-help">Focused keeps the Casual land target and display, but raises the color-support bar. cEDH = lower land count, fast-mana heavy. All modes show a per-card castability table.</p>
        </fieldset>

        @if (Model.ShowCommunityBaseline)
        {
            var selectedBracket = Model.CommunityBaseline?.Bracket ?? Model.Request.Bracket;
            <fieldset class="manabase-segmented" role="radiogroup">
                <legend>Community baseline bracket</legend>
                <div class="manabase-pills">
                    @foreach (var num in new[] { 2, 3, 4, 5 })
                    {
                        <label class="manabase-pill @(selectedBracket == num ? "is-selected" : null)">
                            <input type="radio" name="Bracket" value="@num"
                                   checked="@(selectedBracket == num ? "checked" : null)" />
                            <span>B@(num) @ManabaseCommunityBaseline.BracketName(num)</span>
                        </label>
                    }
                    <label class="manabase-pill @(selectedBracket is null ? "is-selected" : null)">
                        <input type="radio" name="Bracket" value="" checked="@(selectedBracket is null ? "checked" : null)" />
                        <span>Auto</span>
                    </label>
                </div>
            </fieldset>
        }

        <fieldset class="manabase-segmented" role="radiogroup">
            <legend>How important is casting your commander?</legend>
            <div class="manabase-pills">
                <label class="manabase-pill @(importance == CommanderImportance.Central ? "is-selected" : null)">
                    <input type="radio" name="CommanderImportance" value="Central" checked="@(importance == CommanderImportance.Central ? "checked" : null)" />
                    <span>Central</span>
                </label>
                <label class="manabase-pill @(importance == CommanderImportance.Standard ? "is-selected" : null)">
                    <input type="radio" name="CommanderImportance" value="Standard" checked="@(importance == CommanderImportance.Standard ? "checked" : null)" />
                    <span>Standard</span>
                </label>
                <label class="manabase-pill @(importance == CommanderImportance.Low ? "is-selected" : null)">
                    <input type="radio" name="CommanderImportance" value="Low" checked="@(importance == CommanderImportance.Low ? "checked" : null)" />
                    <span>Low</span>
                </label>
            </div>
            <p class="manabase-help">Central — must cast ASAP, every game (e.g. Brago). Standard — matters, cast when convenient. Low — optional / late value.</p>
        </fieldset>
    </div>

    <div class="toolbar manabase-actions">
        <button type="submit" class="run-button manabase-load-button"
                formaction="@Url.Content("~/manabase/load")"
                data-busy-title="Loading deck"
                data-busy-message="Resolving cards and detecting reduced / alternative costs."
                data-busy-progress="Loading the deck|Resolving cards via Scryfall|Detecting reduced costs">Load deck &amp; detect costs</button>
        <button type="submit" class="run-button" data-default-action>Analyze Mana Base</button>
        <a href="@Url.Content("~/manabase")" class="clear-cache-button" role="button" data-clear-cache data-no-busy>Start over</a>
    </div>
</form>

@if (Model.HasResult && report is not null)
{
    IReadOnlyList<CardCastability> castRows = Model.ShowCommanderCastability
        ? report.Castability.Where(c => !c.IsCommander).ToList()
        : report.Castability;
    IReadOnlyList<CardCastability> trackedCastRows = report.Castability.Where(c => !c.IsCommander).ToList() is { Count: > 0 } trackedRows ? trackedRows : report.Castability;
    var commanderRows = report.Castability.Where(c => c.IsCommander).ToList();
    string commanderNames = commanderRows.Count > 0
        ? string.Join(" / ", commanderRows.Select(c => c.Name))
        : string.Empty;
    var showRightLens = Model.ShowCastability && castRows.Count > 0;
    var showLeftLens = report.ColorFindings.Count > 0;
    var showInteractionLens = Model.ShowCedhInteractionLens && report.Mode == ManabaseMode.Cedh && report.InteractionLens is not null;
    var showReadingYourDeckSection = Model.PlainLanguageVerdict is not null;
    var rampDraw = report.LandTarget?.RampAndDrawUnderThree ?? 0;
    var showRampSection = Model.RampDrawBudget is not null || report.RampSourceCount > 0 || rampDraw > 0;
    var showCommanderCastabilitySection = Model.ShowCommanderCastability && Model.ShowCastability && commanderRows.Count > 0;
    var showCastabilitySection = Model.ShowCastability && castRows.Count > 0;
    int trackedNonCommander = trackedCastRows.Count;
    int visibleCastRowCount = showCastabilitySection ? ManabaseDisplay.DefaultVisibleCastabilityCount(castRows) : 0;
    var visibleCastRows = showCastabilitySection ? castRows.Take(visibleCastRowCount).ToList() : new List<CardCastability>();
    var hiddenCastRows = showCastabilitySection ? castRows.Skip(visibleCastRowCount).ToList() : new List<CardCastability>();
    string castabilitySummary = showCastabilitySection ? ManabaseDisplay.CastabilitySummaryText(castRows, visibleCastRowCount) : string.Empty;
    string castRateShapeText = showRightLens ? ManabaseDisplay.CastRateShapeText(trackedCastRows) : string.Empty;
    int visibleInteractionRowCount = showInteractionLens
        ? Math.Min(ManabaseDisplay.DefaultVisibleInteractionCount, report.InteractionLens!.Rows.Count)
        : 0;
    var visibleInteractionRows = showInteractionLens
        ? report.InteractionLens!.Rows.Take(visibleInteractionRowCount).ToList()
        : new List<ManabaseInteractionRow>();
    var hiddenInteractionRows = showInteractionLens
        ? report.InteractionLens!.Rows.Skip(visibleInteractionRowCount).ToList()
        : new List<ManabaseInteractionRow>();
    var interactionHoldableByName = showInteractionLens
        ? report.InteractionLens!.Rows
            .GroupBy(row => row.Name, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(group => group.Key, group => group.First(), StringComparer.OrdinalIgnoreCase)
        : new Dictionary<string, ManabaseInteractionRow>(StringComparer.OrdinalIgnoreCase);
    var showRampDetails = report.RampSourceNames.Count > 0 || report.RampAndDrawNames.Count > 0;
    int visibleLensCount = (showLeftLens ? 1 : 0) + (showRightLens ? 1 : 0) + (showInteractionLens ? 1 : 0);
    string lensWrapperModifier = visibleLensCount switch
    {
        1 => "manabase-twolens--single",
        3 => "manabase-twolens--triple",
        _ => string.Empty,
    };
    (string Id, string Label, bool Show)[] resultNavItems =
    [
        ("manabase-karsten-source-check", "Karsten source check", showLeftLens),
        ("manabase-simulated-cast-rate", "Simulated cast rate", showRightLens),
        ("manabase-early-interaction", "Early interaction", showInteractionLens),
        ("manabase-reading-your-deck", "Reading the deck", showReadingYourDeckSection),
        ("manabase-ramp-draw", "Ramp & draw", showRampSection),
        ("manabase-command-zone-castability", "Command-zone castability", showCommanderCastabilitySection),
        ("manabase-color-findings", "Color findings", true),
        ("manabase-castability", "Castability", showCastabilitySection),
        ("manabase-details", "Details", true),
    ];

    void RenderCastabilityTable(IReadOnlyList<CardCastability> rows)
    {
        <div class="manabase-table-wrap castability-scroll">
            <table class="manabase-table castability-table manabase-table--card">
                <thead>
                    <tr>
                        <th scope="col">Card</th>
                        <th scope="col">MV</th>
                        <th scope="col">Cast on curve</th>
                        @if (showInteractionLens)
                        {
                            <th scope="col">Held up (T1-3)</th>
                        }
                        <th scope="col">Avg delay</th>
                        <th scope="col">Limiting</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in rows)
                    {
                        var chip = ManabaseDisplay.CastChip(c.CastPercent);
                        interactionHoldableByName.TryGetValue(c.Name, out var interactionRow);
                        bool isInteractionRow = showInteractionLens && interactionRow is not null;
                        <tr class="@(c.IsCommander ? "manabase-row--commander" : null)">
                            <td class="castability-name" data-label="Card" title="@c.Name">
                                @if (c.IsCommander)
                                {
                                    <span class="manabase-cmd-glyph" title="commander" aria-label="commander">★</span>
                                }
                                <span class="castability-name-text">@c.Name</span>
                            </td>
                            <td data-label="MV">
                                @c.ManaValue@if (c.IsCostOverridden)
                                {<span class="manabase-override-mark" title="reduced / alternative cost applied" aria-label="reduced or alternative cost applied">*</span>}
                            </td>
                            <td data-label="Cast on curve">
                                <span class="manabase-chip @chip.Css">@c.CastPercent% · @chip.Label</span>
                            </td>
                            @if (showInteractionLens)
                            {
                                <td data-label="Held up (T1-3)">
                                    @if (isInteractionRow)
                                    {
                                        var holdableMarker = ManabaseDisplay.InteractionHoldableMarker(interactionRow!.HoldablePercent, report.InteractionLens!.Threshold);
                                        bool met = interactionRow.HoldablePercent >= report.InteractionLens.Threshold;
                                        <span class="manabase-chip @(met ? "manabase-chip--good" : "manabase-chip--ok")">
                                            @interactionRow.HoldablePercent% <span class="@holdableMarker.Css" aria-hidden="true">@holdableMarker.Marker</span>
                                        </span>
                                        <span class="sr-only">@(met ? "meets hold-up target" : "below hold-up target")</span>
                                    }
                                </td>
                            }
                            <td class="castability-delay" data-label="Avg delay">@ManabaseDisplay.DelayText(c.AverageDelay)</td>
                            <td data-label="Limiting">@ManabaseDisplay.LimitingText(c.LimitingFactor)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    void RenderInteractionRow(ManabaseInteractionRow row)
    {
        var marker = ManabaseDisplay.InteractionHoldableMarker(row.HoldablePercent, report.InteractionLens!.Threshold);
        bool met = row.HoldablePercent >= report.InteractionLens.Threshold;
        <div class="manabase-lens-row">
            <span class="manabase-lens-color">
                @row.Name@if (row.IsCostOverridden)
                {<span class="manabase-override-mark" title="reduced / alternative cost applied" aria-label="reduced or alternative cost applied">*</span>}
            </span>
            <span>
                <strong>@row.HoldablePercent%</strong>
                <span class="manabase-lens-muted">holdable</span>
                <span class="@marker.Css" aria-hidden="true">@marker.Marker</span>
                <span class="sr-only">@(met ? "meets hold-up target" : "below hold-up target")</span>
            </span>
        </div>
    }

    void RenderRampBreakdownDetails(string rampSummary)
    {
        <details class="manabase-ramp">
            <summary><strong>Ramp:</strong> @rampSummary.</summary>
            @if (report.RampSourceNames.Count > 0)
            {
                <p class="manabase-ramp-group-label">Mana rocks/dorks</p>
                <ul>
                    @foreach (var name in report.RampSourceNames)
                    {
                        <li>@name</li>
                    }
                </ul>
            }
            @if (report.RampAndDrawNames.Count > 0)
            {
                <p class="manabase-ramp-group-label">Ramp/draw ≤2 MV</p>
                <ul>
                    @foreach (var name in report.RampAndDrawNames)
                    {
                        <li>@name</li>
                    }
                </ul>
            }
        </details>
    }

    <section class="result-panel" data-print-region data-scroll-on-load>
        <div class="panel-heading">
            <div>
                <div class="manabase-result-heading">
                    <h2>Result</h2>
                    <span class="manabase-chip manabase-mode-chip">@ManabaseDisplay.ModeLabel(report.Mode) analysis</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.InputSummary))
                {
                    <p>@Model.InputSummary</p>
                }
            </div>
            <div class="toolbar manabase-print-toolbar">
                <button type="button" class="run-button prompt-print-button" data-no-busy data-prompt-print>
                    Print results
                </button>
            </div>
        </div>

        <nav class="manabase-anchor-nav" aria-label="On this page">
            <p class="manabase-anchor-nav-label">On this page</p>
            <ul class="manabase-anchor-nav-list">
                @foreach (var item in resultNavItems)
                {
                    @if (item.Show)
                    {
                        <li><a href="#@item.Id">@item.Label</a></li>
                    }
                }
            </ul>
        </nav>

        @* Verdict-first summary: the bottom line (health + land count + the single biggest fix)
           leads the panel so the answer is read before the supporting lenses and tables below.
           Health/Lands/PrimaryFix are always computed (not flag-gated), so this renders in every
           mode. *@
        @{ var primaryFix = report.PrimaryFix; }
        <section class="manabase-summary" aria-label="Verdict summary">
            <div class="manabase-summary-head">
                <span class="manabase-summary-label">Verdict</span>
                <span class="manabase-chip manabase-summary-chip @ManabaseDisplay.HealthCss(report.Health)">@ManabaseDisplay.HealthLabel(report.Health)</span>
            </div>
            @{
                var landShort = Math.Max(1, (int)Math.Round(-report.LandDelta, MidpointRounding.AwayFromZero));
            }
            @{
                string landNote = report.LandDelta >= -1
                    ? "land count OK"
                    : report.LandShortfallCoveredByRamp
                        ? $"~{landShort} under the Karsten count, but ramp covers it"
                        : $"add ~{landShort} {(landShort == 1 ? "land" : "lands")}";
            }
            <p class="manabase-summary-lands">
                <strong>Lands:</strong> @report.ActualLands vs ~@report.TargetLands.ToString("F1") recommended
                @if (report.HasCedhMetaRange
                    && report.TargetLandsRangeLow is { } rangeLow
                    && report.TargetLandsRangeHigh is { } rangeHigh
                    && report.BaselineDeckCount is { } baselineDeckCount
                    && report.BaselineLandsMean is { } baselineMean
                    && report.BaselineLandsSd is { } baselineSd)
                {
                    <text>— cEDH meta range ~@Math.Round(rangeLow).ToString("F0")–@Math.Round(rangeHigh).ToString("F0") lands (@baselineDeckCount cEDH tournament decks@(string.IsNullOrWhiteSpace(report.BaselineMonth) ? "" : $", {report.BaselineMonth} sample"); mean @baselineMean.ToString("F1") ±@baselineSd.ToString("F1")).</text>
                }
                <text> (@landNote).</text>
            </p>
            @if (Model.CommunityBaseline is { } baseline)
            {
                var bracketName = ManabaseCommunityBaseline.BracketName(baseline.Bracket);
                var detected = baseline.BracketSource == ManabaseBracketSource.Auto ? " (auto-detected)" : null;
                var fromEdhrec = baseline.ValueSource is ManabaseBaselineSource.Commander or ManabaseBaselineSource.Blended;
                <p class="manabase-summary-lands manabase-community-baseline">
                    @if (baseline.CommanderDisplayName is { } commanderName)
                    {
                        <strong>Community baseline</strong><text> · @bracketName@detected: EDHREC decks for @commanderName average <strong>~@baseline.AvgLands.ToString("F1") lands</strong> (@baseline.DeckCount.ToString("N0") decks).</text>
                    }
                    else
                    {
                        <strong>Community baseline</strong><text> · @bracketName@detected (@baseline.DeckCount.ToString("N0") decks): <strong>~@baseline.AvgLands.ToString("F1") lands.</strong></text>
                    }
                    @if (fromEdhrec)
                    {
                        <span class="manabase-baseline-source">Data from <a href="https://edhrec.com" target="_blank" rel="noopener noreferrer">EDHREC</a></span>
                    }
                </p>
            }
            @* Biggest fix — the single most actionable change, chosen so it never contradicts the
               land/health line above (e.g. it won't tell you to add sources to an oversupplied
               color). Rendered here (not below the color table) so the fix sits with the verdict. *@
            @switch (primaryFix.Kind)
            {
                case ManabaseFixKind.ColorSources:
                    <p class="manabase-summary-fix"><strong>Biggest fix:</strong> add ~@primaryFix.Amount more <strong>@primaryFix.CategoryName</strong> @(primaryFix.Amount == 1 ? "source" : "sources") — the deck has @primaryFix.ActualSources.ToString("F1") vs @primaryFix.RequiredSources needed for @primaryFix.Spell.</p>
                    break;
                case ManabaseFixKind.Lands:
                    <p class="manabase-summary-fix"><strong>Biggest fix:</strong> add ~@primaryFix.Amount more <strong>@(primaryFix.Amount == 1 ? "land" : "lands")</strong> — each color is individually well-supported, but the base is ~@primaryFix.Amount @(primaryFix.Amount == 1 ? "land" : "lands") short of the curve.</p>
                    break;
                case ManabaseFixKind.DemandingCards:
                    <p class="manabase-summary-fix"><strong>Biggest fix:</strong> lands and colored sources are adequate, but @primaryFix.DemandingCount demanding <strong>@primaryFix.CategoryName</strong> @(primaryFix.DemandingCount == 1 ? "card" : "cards") still cast late (worst: @primaryFix.Spell) — trim the top end or add early ramp.</p>
                    break;
                default:
                    <p class="manabase-summary-fix"><strong>Colors:</strong> every color is adequately supported.</p>
                    break;
            }
            @if (report.Health != ManabaseHealth.Healthy && report.DemandingCards.Count > 0)
            {
                var worst = report.DemandingCards.OrderBy(d => d.CastPercent).First();
                string followUpText = showCastabilitySection
                    ? "Full list in the castability table below."
                    : "See the color findings table below.";
                <p class="manabase-summary-demanding">
                    @report.DemandingCards.Count demanding @(report.DemandingCards.Count == 1 ? "card" : "cards") — hardest: <strong>@worst.Name</strong> (@worst.CastPercent%).
                    <span class="manabase-summary-demanding-hint">@followUpText</span>
                </p>
                @if (showPlainLanguage)
                {
                    <span class="manabase-lens-gloss">@ManabaseDisplay.DemandingCardsGloss</span>
                }
            }
        </section>

        @if (showReadingYourDeckSection && Model.PlainLanguageVerdict is { } verdict)
        {
            <section id="manabase-reading-your-deck" class="manabase-verdict @(verdict.HasIssues ? "manabase-verdict--issues" : "manabase-verdict--fine")">
                <h3 class="manabase-verdict-heading">Reading the deck</h3>
                <p class="manabase-verdict-summary">@verdict.Headline</p>
                @if (verdict.HasIssues)
                {
                    <ul class="manabase-verdict-list">
                        @foreach (var line in verdict.Lines)
                        {
                            <li>@line</li>
                        }
                    </ul>
                }
                else
                {
                    <p class="manabase-verdict-fine">@verdict.NoIssueReason</p>
                }
            </section>
        }

        @if (visibleLensCount > 0)
        {
            <div class="manabase-twolens @lensWrapperModifier">
                @if (showLeftLens)
                {
                    <section id="manabase-karsten-source-check" class="manabase-lens">
                        <h3 class="manabase-lens-label">Karsten source check</h3>
                        @* Headline figure to balance the cast-rate lens's big number: how many colors
                           clear their source target. *@
                        @{
                            var colorsMet = report.ColorFindings.Count(f => ManabaseDisplay.KarstenMet(f).Met);
                            var colorsTotal = report.ColorFindings.Count;
                        }
                        <div class="manabase-lens-big manabase-lens-big--soft">@colorsMet / @colorsTotal<span>colors on target</span></div>
                        @foreach (var f in report.ColorFindings)
                        {
                            var km = ManabaseDisplay.KarstenMet(f);
                            <div class="manabase-lens-row">
                                <span class="manabase-lens-color">@f.CategoryName</span>
                                <span>
                                    <strong>@f.ActualSources.ToString("F1")</strong>
                                    <span class="manabase-lens-muted">/ @f.RequiredSources need</span>
                                    @if (km.Met)
                                    {
                                        <span class="manabase-lens-met">✓</span>
                                    }
                                    else
                                    {
                                        <span class="manabase-lens-short">⚠ −@km.Deficit</span>
                                    }
                                </span>
                            </div>
                        }
                        <p class="manabase-lens-note">The validated colored-source target (Frank Karsten's math) — are there enough sources of each color?</p>
                        @if (showPlainLanguage)
                        {
                            <p class="manabase-lens-gloss">@ManabaseDisplay.KarstenSourceGloss</p>
                            <p class="manabase-lens-gloss">@ManabaseDisplay.WeakestColorGloss</p>
                        }
                    </section>
                }
                @if (showRightLens)
                {
                    <section id="manabase-simulated-cast-rate" class="manabase-lens">
                        <h3 class="manabase-lens-label">Simulated cast rate</h3>
                        <div class="manabase-lens-big">@report.AvgOnCurvePercent%<span>avg on-curve</span></div>
                        @if (!string.IsNullOrEmpty(castRateShapeText))
                        {
                            <p class="manabase-lens-note">@castRateShapeText</p>
                        }
                        <p class="manabase-lens-note">Joint mana + color, with London mulligan, tapped-land timing, and ramp — our Monte-Carlo models the real game, not just color odds.</p>
                        @if (showPlainLanguage)
                        {
                            <p class="manabase-lens-gloss">@ManabaseDisplay.CastRateGloss</p>
                        }
                        <span class="manabase-lens-pill">avg across @trackedNonCommander tracked spells</span>
                    </section>
                }
                @if (showInteractionLens)
                {
                    <section id="manabase-early-interaction" class="manabase-lens">
                        <h3 class="manabase-lens-label">Early interaction</h3>
                        <div class="manabase-lens-big manabase-lens-big--soft">@report.InteractionLens!.OnTargetCount / @report.InteractionLens.QualifyingCount<span>interaction held up by turn 3</span></div>
                        @if (report.InteractionLens.QualifyingCount == 0)
                        {
                            <p class="manabase-lens-note"><span class="manabase-lens-short">⚠ no cheap interaction found</span></p>
                        }
                        else
                        {
                            @foreach (var row in visibleInteractionRows)
                            {
                                RenderInteractionRow(row);
                            }
                            @if (hiddenInteractionRows.Count > 0)
                            {
                                <details class="manabase-castability-details">
                                    <summary>View all @report.InteractionLens.Rows.Count interaction rows (@hiddenInteractionRows.Count more)</summary>
                                    @foreach (var row in hiddenInteractionRows)
                                    {
                                        RenderInteractionRow(row);
                                    }
                                </details>
                            }
                            <p class="manabase-lens-note">Raw availability only — assumes mana is held open on turns 1-3. @ManabaseDisplay.InteractionSummaryText(report.InteractionLens.Rows, visibleInteractionRowCount)</p>
                            @if (showPlainLanguage)
                            {
                                <p class="manabase-lens-gloss">@ManabaseDisplay.CedhInteractionLensGloss</p>
                            }
                        }
                    </section>
                }
            </div>
            @if (showLeftLens && showRightLens)
            {
                <p class="manabase-twolens-note">Read the two together: the left counts raw colored sources against a fixed target; the right simulates real games with draws, mulligans and ramp. A small source gap can still cast fine — a large one shows up as a lower cast rate.</p>
            }
        }
        @if (Model.ShowTapAnalyzer && Model.HasResult && report.TapAnalysis is { } tap)
        {
            <div class="manabase-lens manabase-taplens" id="manabase-untapped-sources" role="group" aria-label="Untapped sources">
                <h3 class="manabase-lens-label">Untapped sources</h3>
                <div class="manabase-taplens-split">
                    <div>
                        <div class="manabase-lens-big">@tap.Turn1UntappedPercent%<span>turn-1 untapped</span></div>
                        <span class="manabase-lens-pill">share of games with an untapped source of a needed color on turn 1</span>
                    </div>
                    <div>
                        <div class="manabase-lens-row">
                            <span class="manabase-lens-color">Overall</span>
                            <span><strong>@tap.OverallUntappedPercent% untapped</strong></span>
                        </div>
                        @if (report.ColorFindings.Count > 1)
                        {
                            @foreach (var (color, tf) in tap.ColorTap)
                            {
                                var tm = ManabaseDisplay.TapMarker(tf.UntappedPercent);
                                <div class="manabase-lens-row">
                                    <span class="manabase-lens-color">@color</span>
                                    <span>
                                        <strong>@tf.UntappedPercent% untapped</strong>
                                        <span class="manabase-lens-muted">(@tf.UntappedSources.ToString("F1") / @tf.TotalSources.ToString("F1"))</span>
                                        <span class="@tm.Css" aria-hidden="true">@tm.Marker</span>
                                        <span class="sr-only">@(tf.UntappedPercent >= 80 ? "meets target" : "below target")</span>
                                    </span>
                                </div>
                            }
                        }
                    </div>
                </div>
                <p class="manabase-lens-note">How often a colored source can be spent the turn it's available — tapped lands (Temples, tri-lands, taplands) can't make mana the turn they enter, so they push back the earliest castable turn. Drawn from the same simulation as the cast rate above, so it never contradicts it.</p>
                @if (showPlainLanguage)
                {
                    <p class="manabase-lens-gloss">@ManabaseDisplay.TapAnalyzerGloss</p>
                }
                @if (Model.ShowSourceList && report.ManaSourceListings is { Count: > 0 } listings)
                {
                    var groupedListings = listings
                        .GroupBy(listing => listing.Name, StringComparer.OrdinalIgnoreCase)
                        .Select(group => new
                        {
                            Name = group.First().Name,
                            Count = group.Count(),
                            Sample = group.First(),
                        })
                        .OrderBy(group => group.Sample.IsLand ? 0 : 1)
                        .ThenBy(group => group.Name, StringComparer.OrdinalIgnoreCase)
                        .ToList();
                    var tappedListings = listings
                        .Where(listing => !listing.EntersUntapped)
                        .GroupBy(listing => listing.Name, StringComparer.OrdinalIgnoreCase)
                        .Select(group => new
                        {
                            Name = group.First().Name,
                            Count = group.Count(),
                            Sample = group.First(),
                        })
                        .OrderBy(group => group.Sample.IsLand ? 0 : 1)
                        .ThenBy(group => group.Name, StringComparer.OrdinalIgnoreCase)
                        .ToList();
                    <details class="manabase-source-details">
                        <summary>Mana sources (@listings.Count)</summary>
                        <div class="manabase-source-list" role="list">
                            @foreach (var entry in groupedListings)
                            {
                                var pips = ManabaseDisplay.ColorPips(entry.Sample.Colors, entry.Sample.ProducesColorless, report.CommanderColors);
                                <div class="manabase-source-row" role="listitem">
                                    <span class="manabase-source-name">@(entry.Count > 1 ? $"{entry.Count}× {entry.Name}" : entry.Name)</span>
                                    <span class="manabase-source-pips" aria-label="@pips.AriaLabel">@pips.Text</span>
                                </div>
                            }
                        </div>
                    </details>
                    <details class="manabase-source-details">
                        <summary>Tapped sources (@tappedListings.Sum(entry => entry.Count))</summary>
                        @if (tappedListings.Count == 0)
                        {
                            <p class="manabase-source-note">No sources enter tapped.</p>
                        }
                        else
                        {
                            <div class="manabase-source-list" role="list">
                                @foreach (var entry in tappedListings)
                                {
                                    var pips = ManabaseDisplay.ColorPips(entry.Sample.Colors, entry.Sample.ProducesColorless, report.CommanderColors);
                                    <div class="manabase-source-row" role="listitem">
                                        <span class="manabase-source-name">@(entry.Count > 1 ? $"{entry.Count}× {entry.Name}" : entry.Name)</span>
                                        <span class="manabase-source-pips" aria-label="@pips.AriaLabel">@pips.Text</span>
                                    </div>
                                }
                            </div>
                        }
                    </details>
                }
            </div>
        }
        @if (Model.ShowMulliganEval && Model.HasResult && report.MulliganEvaluation is { } mull)
        {
            var km = ManabaseDisplay.KeepableMarker(mull.KeepableBand);
            bool showKeepShapesCedh = Model.ShowKeepShapes
                && report.Mode == ManabaseMode.Cedh
                && !string.IsNullOrEmpty(mull.PlanKeepableBand);
            bool showCurveCoverageCasual = Model.ShowKeepShapes
                && report.Mode != ManabaseMode.Cedh
                && mull.CurveCoverageTurns > 0;
            <div class="manabase-lens manabase-mulliganlens" id="manabase-opening-hand" role="group" aria-label="Opening hand">
                <h3 class="manabase-lens-label">Opening hand</h3>
                <div class="manabase-mulliganlens-split">
                    <div>
                        @* Downweighted vs the cast-rate headline: opening-hand is a consistency signal,
                           not a keep/mulligan recommendation (see the note below), so it should not be
                           the largest number on the page. *@
                        <div class="manabase-lens-big manabase-lens-big--soft">
                            <span class="@km.Css" aria-hidden="true">@km.Marker</span> @mull.KeepableBand (~@mull.KeepableHandPercent%)<span>@(showKeepShapesCedh ? "mana-keepable hands" : "keepable hands")</span>
                        </div>
                        <span class="sr-only">@(string.Equals(mull.KeepableBand, "high", StringComparison.OrdinalIgnoreCase) ? "meets target" : "below target")</span>
                        <span class="manabase-lens-pill">keepable = a London-mulligan keep: 3 lands (2 with ramp), up to 5 for a high-curve deck</span>
                        @if (showKeepShapesCedh)
                        {
                            var planKeepMarker = ManabaseDisplay.KeepableMarker(mull.PlanKeepableBand);
                            <div class="manabase-lens-big manabase-lens-big--soft">
                                <span class="@planKeepMarker.Css" aria-hidden="true">@planKeepMarker.Marker</span> @mull.PlanKeepableBand (~@mull.PlanKeepablePercent%)<span>plan-keepable hands</span>
                            </div>
                            <span class="manabase-lens-pill">plan-keepable = passed a cEDH keep shape (explosive / early engine / interaction bridge)</span>
                        }
                    </div>
                    <div>
                        <div class="manabase-lens-row">
                            <span class="manabase-lens-color">Colors / curve</span>
                            <span><strong>@mull.ColorCount @(mull.ColorCount == 1 ? "color" : "colors")</strong> <span class="manabase-lens-muted">avg MV ~@ManabaseDisplay.AvgManaValueText(mull.AverageManaValue)</span></span>
                        </div>
                        <div class="manabase-lens-row">
                            <span class="manabase-lens-color">Keep-size process</span>
                            <span>kept 7 ~@mull.Kept7Percent% <span class="manabase-lens-muted">·</span> to 6 ~@mull.MulliganTo6Percent% <span class="manabase-lens-muted">·</span> to 5 ~@mull.MulliganTo5Percent%</span>
                        </div>
                        @if (showCurveCoverageCasual)
                        {
                            <div class="manabase-lens-row">
                                <span class="manabase-lens-color">Curve coverage</span>
                                <span>plays a spell on ~@ManabaseDisplay.CurveCoverageText(mull.CurveCoverageTurns) of first 5 turns</span>
                            </div>
                        }
                        @if (Model.ShowPlanPresence && mull.PlanPresence is { } plan)
                        {
                            @* Payoff leads on its own; the per-role split moves to a muted sub-line and
                               drops the Payoff role (already the headline number) so the line is not five
                               percentages with payoff shown twice. *@
                            var roleBits = plan.RolePercents
                                .Where(kv => kv.Value > 0 && kv.Key != PlanRole.Payoff)
                                .Select(kv => $"{ManabaseDisplay.PlanRoleLabel(kv.Key)} ~{kv.Value}%")
                                .ToList();
                            <div class="manabase-lens-row manabase-lens-planline">
                                <span><span class="manabase-lens-color">Payoff on curve:</span> <strong>~@plan.PayoffPercent%</strong> hold a payoff castable on curve <span class="manabase-lens-muted">(@plan.PayoffBand)</span> <span class="manabase-lens-muted">· any win-directed ~@plan.PlanPresencePercent%</span></span>
                            </div>
                            @if (roleBits.Count > 0)
                            {
                                <div class="manabase-lens-row manabase-lens-roleline">
                                    <span class="manabase-lens-muted">by role: @string.Join(" · ", roleBits)</span>
                                </div>
                            }
                        }
                    </div>
                </div>
                @if (mull.RepresentativeOpeners.Count > 0)
                {
                    <ul class="manabase-mulliganlens-openers">
                        @foreach (var opener in mull.RepresentativeOpeners)
                        {
                            <li>
                                <strong>@opener.Decision</strong>
                                <span class="manabase-lens-muted">(@opener.KeptCards cards: @opener.Lands land / @opener.Colors color / @opener.RampPieces ramp / @opener.OtherCards other)</span>
                                —
                                @if (string.IsNullOrEmpty(opener.TrackedSpellName))
                                {
                                    <span>no castable plan by its curve turn</span>
                                }
                                else if (opener.OnCurveCastable)
                                {
                                    <span>@opener.TrackedSpellName castable on curve (turn @opener.TrackedOnCurveTurn)</span>
                                }
                                else
                                {
                                    <span>@opener.TrackedSpellName not on curve (slow start)</span>
                                }
                                <span class="manabase-lens-muted">— @(Model.ShowKeepShapes && !string.IsNullOrEmpty(opener.ShapeLabel) ? opener.ShapeLabel : opener.HasPlan ? "workable line" : "no clear line")</span>
                            </li>
                        }
                    </ul>
                }
                <p class="manabase-lens-note">First-pass read from the same simulation as the cast rate above, so it never contradicts it — a consistency signal, not a keep/mulligan recommendation.</p>
            </div>
        }

        <p class="manabase-context">
            Mode: <strong>@ManabaseDisplay.ModeLabel(report.Mode)</strong>
            @if (commanderRows.Count > 0)
            {
                <text> · Commander: <strong>@commanderNames</strong></text>
            }
            <text> · Casting priority: <strong>@ManabaseDisplay.ImportanceLabel(importance)</strong></text>
        </p>

        @* Lands + Health + biggest fix now lead the panel in .manabase-summary above; this mid-panel
           spot keeps only the beta notice and the detailed plain-language / ramp-draw advisories. *@
        <section class="manabase-beta-notice" role="note">
            Heads up: manabase analysis is in beta. Treat the results as a guide, not gospel - numbers may be inaccurate.
        </section>

        @if (showRampSection && Model.RampDrawBudget is { } budget)
        {
            var thresholdProxy = budget.ThresholdSource == ManabaseRampDrawThresholdSource.CommanderManaValue
                ? "commander MV"
                : "curve 75th-percentile MV";
            var rockOrDorkLabel = report.RampSourceCount == 1 ? "mana rock/dork" : "mana rocks/dorks";
            var rampPieceLabel = rampDraw == 1 ? "ramp/draw piece" : "ramp/draw pieces";
            var rampSummary = $"{report.RampSourceCount} {rockOrDorkLabel}" + (rampDraw > 0 ? $" · {rampDraw} {rampPieceLabel} at ≤2 MV credited toward a lower land count" : string.Empty);
            <section id="manabase-ramp-draw" class="manabase-lens manabase-rampdraw" aria-label="Ramp and draw budget advisory">
                <h3 class="manabase-lens-label">Ramp &amp; draw</h3>
                <p class="manabase-rampdraw-line">
                    @if (budget.IsBalanced)
                    {
                        <span>Ramp/draw split looks balanced. </span>
                    }
                    <span>The deck runs <strong>@budget.RampCount.ToString("0.#")</strong> ramp / <strong>@budget.DrawCount.ToString("0.#")</strong> draw; for a ~MV@(budget.Threshold.ToString("0.#")) threshold a common split is @budget.TargetRamp / @budget.TargetDraw.</span>
                    @if (budget.OverlapCount > 0)
                    {
                        <span> (@budget.OverlapCount do both)</span>
                    }
                </p>
                <p class="manabase-lens-note">Community heuristic, not Karsten math. Threshold proxied from @thresholdProxy.</p>
                @if (showRampDetails)
                {
                    RenderRampBreakdownDetails(rampSummary);
                }
                else
                {
                    <p class="manabase-help">
                        <strong>Ramp:</strong> @rampSummary.
                    </p>
                }
            </section>
        }

        @if (showCommanderCastabilitySection)
        {
            <section id="manabase-command-zone-castability" class="manabase-lens manabase-cmd-castability">
                <h3 class="manabase-lens-label">Command-zone castability</h3>
                @if (commanderRows.Count == 1)
                {
                    var commander = commanderRows[0];
                    string? earlyCastSummary = ManabaseDisplay.EarlyCastSummary(commander.EarlyCastPercents);
                    <div class="manabase-lens-big manabase-lens-big--soft">@commander.CastPercent%<span>by on-curve turn @commander.OnCurveTurn</span></div>
                    @if (earlyCastSummary is not null)
                    {
                        <p class="manabase-lens-note">@earlyCastSummary</p>
                    }
                }
                @foreach (var c in commanderRows)
                {
                    <p class="manabase-cmd-castability-line">
                        <span class="manabase-cmd-glyph" title="commander" aria-label="commander">★</span>
                        <strong>@c.Name</strong> casts on curve <strong>@c.CastPercent%</strong> of the time on turn @c.OnCurveTurn.
                    </p>
                }
                @if (Model.CompanionCallout is { } comp)
                {
                    <p class="manabase-cmd-castability-line">
                        <span class="manabase-cmd-companion-glyph" title="companion" aria-label="companion">+</span>
                        <strong>@comp.Name</strong> casts on curve <strong>@comp.CastPercent%</strong> of the time on turn @comp.OnCurveTurn.
                        This heuristic includes the +3 generic "to hand" tax as an approximation.
                    </p>
                }
            </section>
        }

        @if (showRampSection && (report.RampSourceCount > 0 || rampDraw > 0))
        {
            var rockOrDorkLabel = report.RampSourceCount == 1 ? "mana rock/dork" : "mana rocks/dorks";
            var rampPieceLabel = rampDraw == 1 ? "ramp/draw piece" : "ramp/draw pieces";
            var rampSummary = $"{report.RampSourceCount} {rockOrDorkLabel}" + (rampDraw > 0 ? $" · {rampDraw} {rampPieceLabel} at ≤2 MV credited toward a lower land count" : string.Empty);
            @if (Model.RampDrawBudget is null)
            {
                <section id="manabase-ramp-draw" class="manabase-lens manabase-ramp-fallback">
                    <h3 class="manabase-lens-label">Ramp &amp; draw</h3>
                    @if (showRampDetails)
                    {
                        RenderRampBreakdownDetails(rampSummary);
                    }
                    else
                    {
                        <p class="manabase-help">
                            <strong>Ramp:</strong> @rampSummary.
                        </p>
                    }
                </section>
            }
        }

        <p class="mode-note">
            Built on
            <a href="https://www.channelfireball.com/articles/how-many-sources-do-you-need-to-consistently-cast-your-spells/" target="_blank" rel="noopener">Frank Karsten's source-count method</a>,
            extended to weight non-land sources (rocks, dorks), count modal double-faced land-backs as real lands, count tapped vs. untapped lands for turn-one casts, and size each color to its hardest spell.
        </p>

        <section id="manabase-color-findings">
            <h3 class="manabase-castability-heading">Color findings</h3>
            <div class="manabase-table-wrap">
                <table class="manabase-table manabase-table--card">
                    <thead>
                        <tr>
                            <th scope="col">Color</th>
                            <th scope="col">Sources</th>
                            <th scope="col">Needed</th>
                            <th scope="col">Population</th>
                            <th scope="col">Short by</th>
                            <th scope="col">Driving spell</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in report.ColorFindings)
                        {
                            var isWeakest = report.WeakestColor is { } w && w.CategoryName == f.CategoryName;
                            // Red "weakest" accent only when the lead color genuinely needs sources
                            // (domain rule lives on the model, see ColorSourceFinding.NeedsMoreSources).
                            var weakestNeedsSources = isWeakest && f.NeedsMoreSources;
                            var isCommanderColor = !f.IsSpecialCategory && report.CommanderColors.Contains(f.Color);
                            <tr class="@(f.IsAdequate ? null : "manabase-row--short") @(weakestNeedsSources ? "manabase-row--weakest" : null)">
                                <td data-label="Color">
                                    @f.CategoryName
                                    @if (isCommanderColor)
                                    {
                                        <span class="manabase-cmd-glyph" title="commander color" aria-label="commander color">★</span>
                                    }
                                </td>
                                <td data-label="Sources">
                                    @f.ActualSources.ToString("F1")
                                    @if (f.SharedSources > 0 || f.ConditionalSources > 0)
                                    {
                                        <span class="manabase-source-breakdown">@f.DirectSources.ToString("F1") direct + @f.SharedSources.ToString("F1") shared@(f.ConditionalSources > 0 ? $" + {f.ConditionalSources.ToString("F1")} conditional" : string.Empty)</span>
                                    }
                                </td>
                                <td data-label="Needed">@f.RequiredSources</td>
                                <td data-label="Population">@f.UnderSupportedCount of @f.DisplayEvaluatedCardCount under-supported</td>
                                <td data-label="Short by (heuristic guidance)">@(f.IsAdequate ? "OK" : $"{f.Deficit.ToString("0.0")} ⚠")</td>
                                <td data-label="Driving spell">@f.DrivingSpell</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @if (report.HasRestrictedSourceApproximation)
        {
            <div class="manabase-table-wrap">
                <table class="manabase-table manabase-table--card manabase-restricted-sources">
                    <thead>
                        <tr>
                            <th scope="col">Land / source</th>
                            <th scope="col">Approximation</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var landName in report.RestrictedSourceLandNames)
                        {
                            <tr>
                                <td data-label="Land / source">
                                    @landName<span class="manabase-override-mark" title="restricted-source approximation applied" aria-label="restricted-source approximation applied">†</span>
                                </td>
                                <td data-label="Approximation">composition-gated restricted color-source estimate</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="manabase-help"><span class="manabase-override-mark">†</span> restricted-source approximation applied to these land rows; colored-source weight is composition-gated, not tracked spell-by-spell.</p>
        }

        @* Biggest-fix callout moved to the .manabase-summary card at the top of the panel so the
           single most actionable change reads with the verdict. See the comment there for the
           no-contradiction invariant (won't tell you to add sources to an oversupplied color). *@

        @* MQ-04: disclose cards the analysis can't fully model (X costs, hybrid/Phyrexian pips)
           instead of silently folding them into a clean-looking verdict. *@
        @if (report.UnsupportedInteractions.Count > 0)
        {
            <details class="manabase-unsupported">
                <summary>⚠ @report.UnsupportedInteractions.Count @(report.UnsupportedInteractions.Count == 1 ? "card uses" : "cards use") interactions this analysis approximates or skips</summary>
                <ul>
                    @foreach (var u in report.UnsupportedInteractions)
                    {
                        <li><strong>@u.Name</strong> — @u.Reason</li>
                    }
                </ul>
            </details>
        }

        @if (showCastabilitySection)
        {
            <section id="manabase-castability">
                <h3 class="manabase-castability-heading">Castability — chance to cast on curve</h3>
                <p class="manabase-help">Estimate on each card's mana-value turn, drawing every turn. Counts ramp; the credited mana rocks/dorks are listed in the expandable Ramp line above. See <em>How the analysis works</em> below for the mulligan and draw details.</p>
                <p class="manabase-castability-summary">@castabilitySummary</p>
                @{ RenderCastabilityTable(visibleCastRows); }
                @if (hiddenCastRows.Count > 0)
                {
                    <details class="manabase-castability-details">
                        <summary>Show all @castRows.Count castability rows</summary>
                        @{ RenderCastabilityTable(hiddenCastRows); }
                    </details>
                }
            </section>
            @if (report.Castability.Any(c => c.IsCostOverridden))
            {
                <p class="manabase-help"><span class="manabase-override-mark">*</span> reduced / alternative cost applied from your overrides.</p>
            }
        }
        else if (report.Mode == ManabaseMode.Cedh)
        {
            <p class="mode-note manabase-castability-note">Castability view is available in Casual mode.</p>
        }

        @if (!string.IsNullOrWhiteSpace(Model.ImportWarning))
        {
            <p class="mode-note">@Model.ImportWarning</p>
        }
        @if (Model.Unresolved.Count > 0)
        {
            <p class="mode-note">Skipped @Model.Unresolved.Count @(Model.Unresolved.Count == 1 ? "card" : "cards") Scryfall could not resolve: @string.Join(", ", Model.Unresolved)</p>
        }
    </section>

    @* Download mini-form: re-posts the same deck inputs to /manabase/download so the server
       can re-run the analysis and return the report as a text file. This form is a separate
       <form> element because the result panel is rendered outside the main analyze <form>
       and cannot use a formaction= button inside it. All hidden inputs mirror the analyze
       form's field names exactly so model-binding produces an identical ManabaseRequest. *@
    <form method="post" action="@Url.Content("~/manabase/download")" class="toolbar manabase-download">
        @Html.AntiForgeryToken()
        <input type="hidden" name="DeckInputSource" value="@Model.Request.DeckInputSource" />
        <input type="hidden" name="DeckUrl" value="@Model.Request.DeckUrl" />
        <input type="hidden" name="DeckText" value="@Model.Request.DeckText" />
        <input type="hidden" name="DeckName" value="@Model.Request.DeckName" />
        <input type="hidden" name="Mode" value="@Model.Request.Mode" />
        <input type="hidden" name="Bracket" value="@Model.Request.Bracket" />
        <input type="hidden" name="CommanderImportance" value="@Model.Request.CommanderImportance" />
        <input type="hidden" name="CompanionName" value="@Model.Request.CompanionName" />
        <input type="hidden" name="CostOverridesText" value="@Model.Request.CostOverridesText" />
        @* Mirror OverridesTouched too: if a download error re-renders the analyze view, a deliberately
           cleared box must not silently refill with the suggestions (MEDIUM-11, Codex). *@
        <input type="hidden" name="OverridesTouched" value="@(Model.Request.OverridesTouched ? "true" : "false")" />
        <button type="submit" class="run-button manabase-download-button" data-no-busy data-prompt-download-submit>Download analysis (.txt)</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.PromptSwapPrompt))
    {
        <details class="result-panel nested-panel">
            <summary>Want specific land swaps? Copy this prompt for ChatGPT / Claude</summary>
            <div class="panel-heading">
                <div>
                    <h3>Swap-suggestion prompt</h3>
                    <p>The math above shows which colors are short. Paste this to have an AI name specific lands to add and weak cards to cut.</p>
                </div>
                <button type="button" class="copy-button" data-copy-target="manabase-prompt-output">Copy</button>
            </div>
            <textarea id="manabase-prompt-output" readonly spellcheck="false">@Model.PromptSwapPrompt</textarea>
        </details>
    }
}

@* FORMULA-01 — methodology always shown; the per-deck breakdown only with a result. *@
<details id="manabase-details" class="result-panel nested-panel manabase-formula" data-manabase-formula="how">
    <summary>How the analysis works</summary>
    <div class="manabase-formula-body">
        <p>The land count comes from <strong>Frank Karsten's source-count regression</strong> for singleton (Commander) decks: a target driven by average mana value, ramp and card draw at three mana or less, and fast mana, with a credit for each commander. Modal double-faced land-backs count directly toward the actual land total rather than adjusting this target. cEDH mode lowers that target for the faster competitive format (about a 3.5-land cut, crediting fast mana fully); when there is enough cEDH tournament data for the commander, the recommendation is nudged toward that real-deck land mean and shown as a range.</p>
        <p>Each spell's <strong>castability</strong> comes from a Monte-Carlo simulation. It draws an opening seven and applies the <strong>London mulligan</strong>, including <strong>Commander's free first mulligan</strong> — the first mulligan keeps seven at no cost; only later ones bottom a card (lowest-impact first, never lands). It then <strong>draws every turn, including turn 1</strong>. A card is judged on its mana-value turn, so by turn N it has seen its opening 7 plus one card per turn (7 + N cards). Each turn it deploys ramp as it comes online, credits fetchlands to the colors they can fetch, and applies any always-on cost reducers — then asks, on that turn, whether there is enough <strong>mana and the right colored pips together</strong> (a joint check, not two independent odds). The reported number is the share of simulated games where the card was castable on curve.</p>
        @if (Model.HasResult && report is { Mode: ManabaseMode.Cedh, InteractionLens: not null } && Model.ShowCedhInteractionLens)
        {
            <p>In cEDH mode, the <strong>Early interaction</strong> lens reuses that same simulation for cheap interaction spells (tagged <strong>Interaction</strong>, effective MV ≤ 2) and asks whether each one was holdable with untapped mana on at least one of turns 1-3. The headline counts how many clear the @report.InteractionLens!.Threshold% target and assumes mana was held open.</p>
        }
        <p class="manabase-help">The sim plays going first for board development (one land drop per turn, no earlier plays), which is the <strong>conservative</strong> case for land sequencing — but it draws every turn, so the card count matches real games.</p>
        <p>Colored-source findings combine a <strong>worst-driver</strong> spell (the hardest single card for a color) with a <strong>population</strong> view (how many of that color's cards are under-supported and their mean castability). The weakest color surfaces tail risk first. The <strong>commander-importance</strong> setting weights the commander's colors more or less heavily — Central holds them to a stricter, cEDH-style threshold.</p>
        <p>The overall <strong>health</strong> reads on a four-tier scale — <strong>Excellent</strong>, <strong>Solid</strong>, <strong>Workable</strong>, <strong>Needs work</strong> — that combines Karsten source counts with the simulated avg-on-curve headline. A card that casts late only because it is <em>expensive</em> (a curve problem the base can't fix) never fails the verdict. <em>Needs work</em> means a severe or broad shortage: a color short by more than about two sources, or two-plus colors short — or a land shortfall the simulation corroborates (a color issue or broad simulated under-support riding alongside). Broad under-support on its own does not red the verdict. If the simulation says the deck functions, with no catastrophic color, no severe color deficit, and no broad color-access shortfall, a land-count shortfall plus one soft color issue is <em>Workable</em>, not red. <em>Solid</em> is a working base with minor notes; <em>Excellent</em> is clean.</p>
        <p class="manabase-help">Credit: Frank Karsten's published source-count work. The castability estimate is our own Monte-Carlo simulation, cross-checked against community mana calculators including <a href="https://www.salubrioussnail.com/manabase-tool" target="_blank" rel="noopener">Salubrious Snail</a>. These figures are an estimate; treat them as a ranking aid, not a guarantee.</p>
    </div>
</details>

@if (Model.HasResult && report is not null)
{
    <details class="result-panel nested-panel manabase-formula" data-manabase-formula="numbers">
        <summary>This deck's numbers</summary>
        <div class="manabase-formula-body">
            <p><strong>Land target.</strong> Recommended ~@report.TargetLands.ToString("F1") lands vs @report.ActualLands in the deck (@ManabaseDisplay.ModeLabel(report.Mode) profile).</p>
            @if (report.LandTarget is { } lt)
            {
                var scale = lt.LibrarySize / 60.0;
                <p class="manabase-help">The Karsten land-count regression, with this deck's numbers plugged into every term:</p>
                <ul class="manabase-formula-list manabase-formula-terms">
                    <li>scale = library @lt.LibrarySize ÷ 60 = <strong>@scale.ToString("F2")</strong></li>
                    <li>base interior = 19.59 + 1.90·(avg MV <strong>@lt.AverageManaValue.ToString("F2")</strong>) + 0.27·(commanders <strong>@lt.CommanderCount</strong>) = <strong>@((19.59 + (1.90 * lt.AverageManaValue) + (0.27 * lt.CommanderCount)).ToString("F2"))</strong></li>
                    <li>− 0.28·(ramp/draw ≤2 MV <strong>@lt.RampAndDrawUnderThree</strong>) = <strong>−@((0.28 * lt.RampAndDrawUnderThree).ToString("F2"))</strong></li>
                    <li>− fast mana <strong>@lt.FastMana</strong> (1 land each) = <strong>−@lt.FastMana.ToString("F2")</strong></li>
                    <li>− 1.35 fixed offset</li>
                    @if (report.Mode == ManabaseMode.Cedh)
                    {
                        if (lt.CedhBaselineBlended && report.BaselineDeckCount is { } n && report.BaselineLandsMean is { } bmean)
                        {
                            <li>cEDH adjustment: −3.5 off the curve base @lt.BaseTarget.ToString("F1"), then nudged 50% toward this commander's tournament land mean (@bmean.ToString("F1") from @n cEDH decks@(string.IsNullOrWhiteSpace(report.BaselineMonth) ? "" : $", {report.BaselineMonth}")); safety floor @lt.CedhSafetyFloor.ToString("F0") = net <strong>@lt.CedhAdjustment.ToString("0.0;-0.0;0.0")</strong>, target ~@lt.FinalTarget.ToString("F1").</li>
                        }
                        else
                        {
                            <li>cEDH adjustment (−3.5, floor @lt.CedhSafetyFloor.ToString("F0") lands): <strong>@lt.CedhAdjustment.ToString("0.0;-0.0;0.0")</strong> from a base of @lt.BaseTarget.ToString("F1").</li>
                        }
                        @if (lt.RitualLandCredit > 0)
                        {
                            <li>Ritual land credit: <strong>−@lt.RitualLandCredit.ToString("0.0")</strong> (@lt.NetPositiveRitualCount net-positive @ManabaseWording.Pluralize("ritual", lt.NetPositiveRitualCount) × 0.5, cap 3) — applied before the safety floor and included in the net adjustment above.</li>
                        }
                    }
                    @if (report is { Mode: ManabaseMode.Cedh, InteractionLens: not null } && Model.ShowCedhInteractionLens)
                    {
                        <li>interaction lens: <strong>@report.InteractionLens!.QualifyingCount</strong> interaction @ManabaseWording.Pluralize("spell", report.InteractionLens.QualifyingCount) qualified (PlanRole.Interaction, effective MV ≤ 2); <strong>@report.InteractionLens.OnTargetCount</strong> held up by turn 3 at the <strong>@report.InteractionLens.Threshold%</strong> threshold.</li>
                    }
                    <li><strong>= target ~@lt.FinalTarget.ToString("F1") lands</strong> vs <strong>@report.ActualLands</strong> actually in the deck.</li>
                </ul>
            }
            <p class="manabase-help">Commander importance applied: <strong>@ManabaseDisplay.ImportanceLabel(importance)</strong> (weights the commander's colors; does not move the land target).</p>

            <p><strong>Per-color sources.</strong> Effective colored sources counted for each color (duals, any-color and fetch sources credited to every color they can make, per Karsten). The breakdown splits that total into <em>direct</em> (sources that make only this color), <em>shared</em> (multi-color fixers also feeding the deck's other colors — one makes one mana per turn), and <em>conditional</em> (granted any-color sources the sim only fires part of the time):</p>
            <ul class="manabase-formula-list">
                @if (report.ScrySourceCreditCopies > 0)
                {
                    <li>@ManabaseWording.ScrySourceCreditLine(report.ScrySourceCreditCopies, report.ScrySourceCredit)</li>
                }
                @foreach (var f in report.ColorFindings)
                {
                    <li>
                        <strong>@f.CategoryName</strong>: @f.ActualSources.ToString("F1") sources
                        (@f.DirectSources.ToString("F1") direct + @f.SharedSources.ToString("F1") shared + @f.ConditionalSources.ToString("F1") conditional) ·
                        needs @f.RequiredSources for @f.DrivingSpell ·
                        @f.UnderSupportedCount of @f.DisplayEvaluatedCardCount @(f.DisplayEvaluatedCardCount == 1 ? "card" : "cards") under-supported · mean cast @f.AverageCastPercent.ToString("F0")%
                    </li>
                }
            </ul>

            <p><strong>Simulation parameters.</strong> Goes <strong>first for board development</strong> (one land drop per turn) but <strong>draws every turn including turn 1</strong>. A card on its mana-value turn N has seen 7 + N cards (its opening seven plus one per turn). <strong>London mulligan including Commander's free first mulligan</strong> — the first mulligan keeps seven at no cost; only the second and third bottom a card (to six then five, lowest-impact non-lands first). ~20,000 trials per spell; each spell measured on its effective on-curve turn after any cost reduction. Cast % above is the share of trials where the card was castable on curve.</p>
            <p class="manabase-help">"Show the work": every verdict above traces back to these counts and the simulation, so every flagged color or card can be audited back to a number.</p>
        </div>
    </details>
}

@if (FlagCache.IsEnabled("tool.deck-analysis.enabled"))
{
    <aside class="related-tool-link"><p>Want a broader review? <a href="@Url.Content("~/deck-analysis")">Analyze your Commander deck</a>.</p></aside>
}

