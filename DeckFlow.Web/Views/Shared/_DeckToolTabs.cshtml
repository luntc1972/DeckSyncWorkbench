@using DeckFlow.Web.Models
@using DeckFlow.Web.Services.Tools
@model DeckPageTab
@inject DeckFlow.Web.Services.FeatureFlags.IFeatureFlagCache FlagCache
@inject DeckFlow.Web.Services.Tools.IToolRegistry ToolRegistry

@{
    var sections = ToolVisibility.VisibleBySection(ToolRegistry.All, FlagCache);
}

@* The toggle controls the section groups, not the whole nav it lives in — hence the
   #deck-tool-nav-groups wrapper. The wrapper is `display: contents` so it adds no box to the
   desktop flex row or the mobile grid. Visibility is a CSS concern (site-common hides it,
   site-mobile shows it); it deliberately carries no `hidden` attribute, which would leave the
   button semantically hidden while site-mobile forced it visible. *@
<nav id="deck-tool-nav" class="tool-nav" aria-label="Deck tools" data-tool-nav>
    <button type="button" class="tool-nav__menu-toggle" data-tool-nav-menu-toggle aria-expanded="false" aria-controls="deck-tool-nav-groups">Tools</button>
    <div id="deck-tool-nav-groups" class="tool-nav__groups">
    @foreach (var section in sections)
    {
        var sectionName = section.Section.ToString();
        var sectionActive = section.Tools.Any(tool => tool.Tab == Model);

        <div class="tool-nav__group @(sectionActive ? "is-active" : string.Empty)" data-tool-nav-group>
            <button type="button" class="tool-nav__trigger" aria-expanded="false" aria-haspopup="true" data-tool-nav-trigger>
                @sectionName
            </button>
            <div class="tool-nav__dropdown">
                @foreach (var tool in section.Tools)
                {
                    var linkTitle = tool.Key == "content-kb"
                        ? "Browse distilled creator advice and copyable prompts"
                        : null;

                    <a class="tool-nav__link @(tool.Tab == Model ? "is-active" : string.Empty)"
                       href="@Url.Content("~" + tool.Route)"
                       title="@linkTitle">
                        <span class="tool-nav__link-icon" aria-hidden="true">
                            @await Html.PartialAsync("_ToolTileIcon", tool.IconKey)
                        </span>
                        <span>@tool.Label</span>
                    </a>
                }
            </div>
        </div>
    }
    </div>
</nav>
