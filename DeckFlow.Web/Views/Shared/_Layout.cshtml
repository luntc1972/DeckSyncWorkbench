@inject DeckFlow.Web.Services.FeatureFlags.IFeatureFlagCache FeatureFlagCache
@{
    const string defaultDescription = "DeckFlow — Magic: The Gathering deck analysis for cEDH and Commander. Deterministic manabase math, bracket checks, meta comparison, and deck history.";
    var themeOptions = new (string FileName, string Label)[]
    {
        ("site.css", "Classic"),
        ("site-azorius.css", "Azorius (WU)"),
        ("site-dimir.css", "Dimir (UB)"),
        ("site-rakdos.css", "Rakdos (BR)"),
        ("site-gruul.css", "Gruul (RG)"),
        ("site-selesnya.css", "Selesnya (GW)"),
        ("site-orzhov.css", "Orzhov (WB)"),
        ("site-izzet.css", "Izzet (UR)"),
        ("site-golgari.css", "Golgari (BG)"),
        ("site-boros.css", "Boros (RW)"),
        ("site-simic.css", "Simic (GU)"),
        ("site-bant.css", "Bant (GWU)"),
        ("site-abzan.css", "Abzan (WBG)"),
        ("site-sultai.css", "Sultai (BGU)"),
        ("site-mardu.css", "Mardu (RWB)"),
        ("site-temur.css", "Temur (GUR)"),
        ("site-esper.css", "Esper (WUB)"),
        ("site-grixis.css", "Grixis (UBR)"),
        ("site-jund.css", "Jund (BRG)"),
        ("site-naya.css", "Naya (RGW)"),
        ("site-jeskai.css", "Jeskai (URW)"),
        ("site-nyx.css", "Nyx"),
        ("site-planeswalker-dark.css", "Planeswalker Dark"),
        ("site-commander-table.css", "Commander Table"),
    };
    const string themeCookieName = "deckflow-theme";
    const string defaultThemeFileName = "site.css";
    var selectedThemeFileName = Context?.Request.Cookies.TryGetValue(themeCookieName, out var cookieTheme) == true
        && Array.Exists(themeOptions, option => string.Equals(option.FileName, cookieTheme, StringComparison.OrdinalIgnoreCase))
            ? cookieTheme
            : defaultThemeFileName;
    var themeColors = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        ["site.css"] = "#e2e5ed",
        ["site-abzan.css"] = "#080905",
        ["site-azorius.css"] = "#d9e3f0",
        ["site-bant.css"] = "#e0ece2",
        ["site-boros.css"] = "#e8d8c8",
        ["site-commander-table.css"] = "#e4dbc8",
        ["site-dimir.css"] = "#0b1020",
        ["site-esper.css"] = "#06080c",
        ["site-golgari.css"] = "#0b0f0a",
        ["site-grixis.css"] = "#181822",
        ["site-gruul.css"] = "#c6d8ae",
        ["site-izzet.css"] = "#d8dfe9",
        ["site-jeskai.css"] = "#e2e5ed",
        ["site-jund.css"] = "#1c1a17",
        ["site-mardu.css"] = "#e6ddd8",
        ["site-naya.css"] = "#e6e0d2",
        ["site-nyx.css"] = "#13111c",
        ["site-orzhov.css"] = "#ddd7cc",
        ["site-planeswalker-dark.css"] = "#1a1e2e",
        ["site-rakdos.css"] = "#12090c",
        ["site-selesnya.css"] = "#d8e4d6",
        ["site-simic.css"] = "#d0e2e8",
        ["site-sultai.css"] = "#151d1d",
        ["site-temur.css"] = "#d0e4e8",
    };
    var themeColor = themeColors.TryGetValue(selectedThemeFileName, out var resolvedThemeColor)
        ? resolvedThemeColor
        : "#e2e5ed";
    var defaultThemeHref = Url.Content($"~/css/{defaultThemeFileName}");
    var selectedThemeHref = Url.Content($"~/css/{selectedThemeFileName}");
    var pageDescription = Convert.ToString(ViewData["Description"]);
    pageDescription = string.IsNullOrWhiteSpace(pageDescription) ? defaultDescription : pageDescription;
    var pageTitle = Convert.ToString(ViewData["Title"]);
    pageTitle = string.IsNullOrWhiteSpace(pageTitle) ? "DeckFlow" : $"{pageTitle} - DeckFlow";
    var requestScheme = Context?.Request.Scheme ?? string.Empty;
    var requestHost = Context?.Request.Host ?? default;
    var requestPathBase = Context?.Request.PathBase ?? default;
    var requestPath = Context?.Request.Path ?? default;
    var isFeedbackPage = string.Equals(requestPath.Value, "/feedback", StringComparison.OrdinalIgnoreCase);
    var canonicalPath = DeckFlow.Web.Seo.SeoPaths.Normalize(requestPath.Value);
    var canonicalUrl = $"{requestScheme}://{requestHost}{requestPathBase}{canonicalPath}";
    var openGraphImageUrl = $"{requestScheme}://{requestHost}{Url.Content("~/og-image.png")}";
    var rawPageTitle = Convert.ToString(ViewData["Title"]);
    var structuredDataJson = DeckFlow.Web.Seo.StructuredDataBuilder.ForPath(
        requestPath.Value ?? "/",
        canonicalUrl,
        $"{requestScheme}://{requestHost}",
        rawPageTitle,
        pageDescription);
    var showShareBar = DeckFlow.Web.Seo.SeoPaths.IsShareablePage(requestPath.Value ?? "/");
    var shareLinks = showShareBar
        ? DeckFlow.Web.Seo.ShareLinkBuilder.Build(canonicalUrl, rawPageTitle)
        : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Active theme --bg for first paint / no-JS fallback. site.ts (attachThemePicker) still updates this to the live active theme --bg on load and on theme change. *@
    <meta name="theme-color" content="@themeColor" />
    <meta name="description" content="@pageDescription" />
    <title>@pageTitle</title>
    <link rel="canonical" href="@canonicalUrl" />
    <meta property="og:title" content="@pageTitle" />
    <meta property="og:description" content="@pageDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:site_name" content="DeckFlow" />
    <meta property="og:image" content="@openGraphImageUrl" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@pageTitle" />
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:image" content="@openGraphImageUrl" />
    <script type="application/ld+json">@Html.Raw(structuredDataJson)</script>
    <link rel="stylesheet" href="~/css/site-common.css" asp-append-version="true" />
    <link id="theme-stylesheet" rel="stylesheet" href="@selectedThemeHref" data-default-href="@defaultThemeHref" data-default-theme="@defaultThemeFileName" data-cookie-name="@themeCookieName" />
    <link rel="stylesheet" href="~/css/site-theme-overrides.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site-mobile.css" asp-append-version="true" />
</head>
<body data-deckflow-extension-bridge="enabled" data-deckflow-extension-install-url="@Url.Content("~/deckflow-bridge")">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <div class="page-shell">
        <div class="page-frame">
            <header class="page-header">
                <a class="page-brand" href="@Url.Content("~/")" aria-label="DeckFlow home">DeckFlow</a>
                <div class="theme-picker">
                    <label class="theme-picker__label" for="theme-picker">Theme</label>
                    <select id="theme-picker" class="theme-picker__select" data-df-select>
                        @foreach (var themeOption in themeOptions)
                        {
                            <option value="@themeOption.FileName" data-theme-href="@Url.Content($"~/css/{themeOption.FileName}")" selected="@(themeOption.FileName == selectedThemeFileName ? "selected" : null)">@themeOption.Label</option>
                        }
                    </select>
                </div>
                <nav class="page-nav" aria-label="Primary">
                    <a class="page-nav__link" href="@Url.Content("~/help")">Help</a>
                </nav>
            </header>
            <main role="main" id="main-content" class="content-shell">
                @RenderBody()
            </main>
            <footer class="page-footer">
                <div class="page-footer__links">
                    <a class="page-footer__link" href="@Url.Content("~/about")">About</a>
                    <a class="page-footer__link page-footer__link--support" href="https://ko-fi.com/deckflowgg" target="_blank" rel="noopener noreferrer"><span class="page-footer__heart" aria-hidden="true">♥</span> Support</a>
                    @if (isFeedbackPage)
                    {
                        <span class="page-footer__link page-footer__link--current" aria-current="page">Feedback</span>
                    }
                    else
                    {
                        <a class="page-footer__link page-footer__link--cta" href="@Url.Content("~/feedback")">Feedback</a>
                    }
                </div>
                @if (shareLinks is not null)
                {
                    <partial name="_ShareBar" model="shareLinks" />
                }
                <p class="page-footer__legal">DeckFlow is unofficial Fan Content permitted under the <a href="https://company.wizards.com/en/legal/fancontentpolicy" target="_blank" rel="noopener noreferrer">Fan Content Policy</a>. Not approved/endorsed by Wizards. Portions of the materials used are property of Wizards of the Coast. &copy;Wizards of the Coast LLC.</p>
            </footer>
            <div class="sr-only" role="status" aria-live="polite" data-copy-announcer></div>
        </div>
    </div>
    <button type="button" id="back-to-top-button" class="back-to-top-button" aria-label="Back to top" title="Back to top">
        <svg class="back-to-top-icon" aria-hidden="true" viewBox="0 0 20 20" width="20" height="20" focusable="false">
            <path d="M2.5 3.5H17.5" />
            <path d="M10 16.5V7.75" />
            <path d="M6.75 10.75 10 7.5l3.25 3.25" />
        </svg>
    </button>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/df-select.js" asp-append-version="true"></script>
    <script src="~/js/df-typeahead.js" asp-append-version="true"></script>
    @if (shareLinks is not null)
    {
        <script src="~/js/share-bar.js" asp-append-version="true"></script>
    }
    @RenderSection("Scripts", required: false)
</body>
</html>
