@model string

@* Why: Model is ToolDefinition.IconKey, which ToolRegistry.Create assigns from `key` — NOT from
   helpSlug. The two differ for judge-questions/ask-a-judge and suggest-categories/category-suggestions,
   and a mismatch falls silently through to the `default:` exclamation-mark glyph (circle, vertical
   line, dot). Do NOT read that fallback as "the question-mark icon": judge-questions' own icon is a
   real question mark, so at 20px the broken state and a correct tile are both just a circle with a
   mark in it — tell them apart by path data, not by eye. Every key in ToolRegistry.Definitions needs
   a case here; the totality test in HomeTilesViewTests derives its cases from ToolRegistry.All. *@
@switch (Model)
{
    case "deck-analysis":
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="3" width="14" height="14" rx="2"/><line x1="7" y1="7" x2="13" y2="7"/><line x1="7" y1="10" x2="13" y2="10"/><line x1="7" y1="13" x2="10" y2="13"/></svg>
        break;
    case "deck-comparison":
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2" y="4" width="7" height="12" rx="1.5"/><rect x="11" y="4" width="7" height="12" rx="1.5"/></svg>
        break;
    case "cedh-meta-gap":
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="3,14 7,9 11,11 17,5"/><polyline points="14,5 17,5 17,8"/></svg>
        break;
    case "manabase":
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M10 3c3 4 4.5 6 4.5 8a4.5 4.5 0 0 1-9 0c0-2 1.5-4 4.5-8z"/></svg>
        break;
    case "bracket":
        @* 5-step ascending staircase — each step = one bracket level *@
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="2,16 2,14 6,14 6,11 10,11 10,8 14,8 14,5 18,5 18,16"/></svg>
        break;
    case "deck-sync":
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 10a6 6 0 0 1 11.8-1.5M16 10a6 6 0 0 1-11.8 1.5"/><polyline points="13,6 16,8.5 13,11"/><polyline points="7,14 4,11.5 7,9"/></svg>
        break;
    case "convert":
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M5 10h10M12 7l3 3-3 3"/><path d="M15 10H5M8 7L5 10l3 3" opacity="0.4"/></svg>
        break;
    case "deck-primer":
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 3h9l3 3v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><polyline points="13,3 13,6 16,6"/><line x1="7" y1="9" x2="13" y2="9"/><line x1="7" y1="12" x2="13" y2="12"/></svg>
        break;
    case "deck-history":
        @* clock face with a counter-clockwise rewind arc — snapshots over time *@
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3.5 8.5A7 7 0 1 1 3 11"/><polyline points="2,5 3.5,8.5 7,7"/><polyline points="10,6.5 10,10 12.5,11.5"/></svg>
        break;
    case "card-lookup":
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="9" cy="9" r="5.5"/><line x1="13.5" y1="13.5" x2="17" y2="17"/></svg>
        break;
    case "mechanic-lookup":
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 4h12v2H4zM4 9h8v2H4zM4 14h10v2H4z"/></svg>
        break;
    case "judge-questions":
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7.5"/><path d="M8 8a2 2 0 1 1 2.5 1.9c-.8.3-1 .8-1 1.6"/><circle cx="10" cy="14" r="0.6" fill="currentColor" stroke="none"/></svg>
        break;
    case "content-kb":
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M4 3h7l1 1v12l-1 1H4l-1-1V4l1-1z"/><path d="M10 3h6l1 1v12l-1 1h-6"/><line x1="7" y1="8" x2="9" y2="8"/><line x1="7" y1="11" x2="9" y2="11"/></svg>
        break;
    case "suggest-categories":
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="6" cy="6" r="2"/><circle cx="14" cy="6" r="2"/><circle cx="10" cy="14" r="2"/><line x1="7.4" y1="7.4" x2="9" y2="12.6"/><line x1="12.6" y1="7.4" x2="11" y2="12.6"/></svg>
        break;
    case "commander-categories":
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 5h5l1.5 2H17v9H3z"/></svg>
        break;
    case "cut-lab":
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="4" y="9" width="12" height="8" rx="2"/><path d="M7 9V7a3 3 0 1 1 6 0v2"/></svg>
        break;
    case "deck-modules":
        @* three linked blocks - named strategy modules assembled into one configuration *@
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="2.5" y="2.5" width="6" height="6" rx="1"/><rect x="11.5" y="2.5" width="6" height="6" rx="1"/><rect x="7" y="11.5" width="6" height="6" rx="1"/></svg>
        break;
    default:
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><circle cx="10" cy="10" r="7"/><line x1="10" y1="6" x2="10" y2="10"/><circle cx="10" cy="13.5" r="0.75" fill="currentColor" stroke="none"/></svg>
        break;
}
