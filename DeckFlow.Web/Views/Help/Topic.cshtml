@model DeckFlow.Web.Models.HelpTopic
@{
    ViewData["Title"] = Model.Title;
    if (!string.IsNullOrWhiteSpace(Model.Summary))
    {
        ViewData["Description"] = Model.Summary;
    }
}

<section class="help-topic">
    <nav class="help-breadcrumb" aria-label="Breadcrumb">
        <a class="help-breadcrumb__back" href="@Url.Content("~/help")">Help</a>
        <span aria-hidden="true">›</span>
        <span>@Model.Title</span>
    </nav>

    <article class="help-prose">
        @Html.Raw(Model.HtmlContent)
    </article>
</section>
