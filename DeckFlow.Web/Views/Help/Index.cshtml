@model IReadOnlyList<DeckFlow.Web.Models.HelpTopic>
@{
    ViewData["Title"] = "DeckFlow Help & How-To Guides";
    ViewData["Description"] = "How to use DeckFlow's Magic: The Gathering deck tools — sync, compare, and analyze Commander and cEDH decks, and export analysis prompts for AI platforms.";
}

<section class="help-index">
    <div class="help-index__heading">
        <span class="help-index__eyebrow">DeckFlow guides</span>
        <h1>Help</h1>
        <p>User guides for each DeckFlow feature.</p>
    </div>

    <ul class="help-index__list">
        @foreach (var topic in Model)
        {
            <li class="help-index__item">
                <a class="help-index__link" href="@Url.Content($"~/help/{topic.Slug}")">
                    <span class="help-index__title">@topic.Title</span>
                    <span class="help-index__summary">@topic.Summary</span>
                </a>
            </li>
        }
    </ul>

    <p class="help-index__feedback">
        Found a bug or have an idea?
        <a href="@Url.Content("~/feedback")">Send feedback</a>.
    </p>
</section>
