<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\DeckFlow.Core\DeckFlow.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <!-- Override transitive SQLitePCLRaw 2.1.11 (NU1903 / GHSA-2m69-gcr7-jv3q). See Core csproj. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="Microsoft.TypeScript.MSBuild" Version="5.2.2" />
    <PackageReference Include="Polly" Version="8.7.0" />
    <PackageReference Include="RestSharp" Version="114.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <TypeScriptCompile Include="wwwroot/ts/**/*.ts" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="logs\" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Help\**\*.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Data\bracket-data.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="Data\cedh-land-baseline\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Data\manabase-baseline\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Update="Data\role-floor-baseline\*.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>2026.09.1</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
  </PropertyGroup>

  <Target Name="CompileTypeScriptAssets" BeforeTargets="Build">
    <Exec
      Condition="'$(OS)' == 'Windows_NT'"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      Command="node .\node_modules\typescript\bin\tsc -p tsconfig.json"
      StandardOutputImportance="Low"
      StandardErrorImportance="High" />
    <Exec
      Condition="'$(OS)' != 'Windows_NT'"
      WorkingDirectory="$(MSBuildProjectDirectory)"
      Command="node ./node_modules/typescript/bin/tsc -p tsconfig.json"
      StandardOutputImportance="Low"
      StandardErrorImportance="High" />
  </Target>

  <Target Name="ZipDeckFlowBridge" BeforeTargets="Build;Publish"
          Condition="Exists('$(MSBuildThisFileDirectory)../browser-extensions/deckflow-bridge')">
    <MakeDir Directories="$(MSBuildThisFileDirectory)wwwroot/extensions" />
    <ZipDirectory SourceDirectory="$(MSBuildThisFileDirectory)../browser-extensions/deckflow-bridge"
                  DestinationFile="$(MSBuildThisFileDirectory)wwwroot/extensions/deckflow-bridge.zip"
                  Overwrite="true" />
  </Target>

</Project>
